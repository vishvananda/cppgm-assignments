global @published : ptr = 0

function @capture(%p : ptr) -> void [no_inline=yes] {
  block ^entry:
    store ptr %p, @published
    return void
}
function @returned_value(%source : ptr) -> i64 [no_inline=yes] {
  block ^entry:
    %a = load u32 %source
    %t2 = convert zext i64 u32 %a
    %next = index u32 %source, 1
    %b = load u32 %next
    %t5 = convert zext i64 u32 %b
    %t6 = binary shl i64 %t5, 32
    %t7 = binary or i64 %t2, %t6
    return i64 %t7
}
function @captured_value(%source : ptr) -> i64 [no_inline=yes] {
  slot $out : obj<8x4>

  block ^entry:
    %destination = addr $out
    call void @capture(%destination)
    %t2 = load i64 %source
    store i64 %t2, %destination
    %t3 = load i64 $out
    return i64 %t3
}
function @returned_address(%source : ptr) -> ptr [no_inline=yes] {
  slot $out : obj<8x4>

  block ^entry:
    %destination = addr $out
    %t2 = load i64 %source
    store i64 %t2, %destination
    return ptr %destination
}
function @volatile_value(%source : ptr) -> i64 [no_inline=yes] {
  block ^entry:
    %a = load volatile u32 %source
    %next = index u32 %source, 1
    %b = load volatile u32 %next
    %t4 = convert zext i64 u32 %a
    %t5 = convert zext i64 u32 %b
    %t6 = binary shl i64 %t5, 32
    %t7 = binary or i64 %t4, %t6
    return i64 %t7
}
function @observed_frame(%source : ptr) -> i64 [no_inline=yes] {
  block ^entry:
    %frame = frame_address
    call void @capture(%frame)
    %a = load u32 %source
    %t3 = convert zext i64 u32 %a
    %next = index u32 %source, 1
    %b = load u32 %next
    %t6 = convert zext i64 u32 %b
    %t7 = binary shl i64 %t6, 32
    %t8 = binary or i64 %t3, %t7
    return i64 %t8
}
function @main() -> i32 [role=entry] {
  slot $source : obj<8x4>

  block ^entry:
    %s = addr $source
    store u32 17, %s
    %s1 = index u32 %s, 1
    store u32 29, %s1
    %v1 = call i64 @returned_value(%s)
    %a1 = convert trunc u32 i64 %v1
    %t5 = binary ushr i64 %v1, 32
    %b1 = convert trunc u32 i64 %t5
    %v2 = call i64 @captured_value(%s)
    %a2 = convert trunc u32 i64 %v2
    %t9 = binary ushr i64 %v2, 32
    %b2 = convert trunc u32 i64 %t9
    %v3 = call i64 @volatile_value(%s)
    %a3 = convert trunc u32 i64 %v3
    %t13 = binary ushr i64 %v3, 32
    %b3 = convert trunc u32 i64 %t13
    %v4 = call i64 @observed_frame(%s)
    %a4 = convert trunc u32 i64 %v4
    %t17 = binary ushr i64 %v4, 32
    %b4 = convert trunc u32 i64 %t17
    %a12 = binary add u32 %a1, %a2
    %a34 = binary add u32 %a3, %a4
    %as = binary add u32 %a12, %a34
    %b12 = binary add u32 %b1, %b2
    %b34 = binary add u32 %b3, %b4
    %bs = binary add u32 %b12, %b34
    %da = binary xor u32 %as, 68
    %db = binary xor u32 %bs, 116
    %all = binary or u32 %da, %db
    %bad = cmp ne u32 %all, 0
    %out = convert zext i32 i1 %bad
    return i32 %out
}
