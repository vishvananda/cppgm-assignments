# explicit-outcomes

# A small leaf called on an ordinary path goes inline.
none(call @mix) in @ordinary_call
instructions <= 15 in @ordinary_call
# A call on a predicted-rare path may stay or go inline: predictions are
# advisory, and each bound leaves room for one copy.
instructions <= 16 in @unlikely_call
instructions <= 15 in @likely_call
instructions <= 12 in @mix
instructions <= 50
blocks <= 13
