# explicit-outcomes

# One read of the selected field, no branch, no redundant address work.
none(branch) in @scaled
none(branch) in @negative
none(branch) in @odd_bias
count(load) <= 1 in @scaled
count(load) <= 1 in @negative
count(load) <= 1 in @odd_bias
instructions <= 8 in @scaled
instructions <= 8 in @negative
instructions <= 8 in @odd_bias
