declare function @malloc(%n : i64) -> ptr [unwind=no, linkage=c, binding=strong, object=malloc]

global @published : ptr = 0

function @fresh(%p : ptr) -> ptr [noalias_result=yes, no_inline=yes] {
  block ^entry:
    store i64 99, %p
    %q = call ptr @malloc(16)
    return ptr %q
}
function @ordinary(%p : ptr) -> ptr [no_inline=yes] {
  block ^entry:
    return ptr %p
}
function @reload() -> ptr [no_inline=yes] {
  block ^entry:
    %q = load ptr @published
    return ptr %q
}
function @call_writes(%p : ptr) -> i64 [no_inline=yes] {
  block ^entry:
    %before = load i64 %p
    %q = call ptr @fresh(%p)
    %after = load i64 %p
    %sum = binary add i64 %before, %after
    return i64 %sum
}
function @fresh_store(%p : ptr) -> i64 [no_inline=yes] {
  block ^entry:
    %q = call ptr @fresh(%p)
    %before = load i64 %p
    store i64 7, %q
    %sum = binary add i64 %before, %before
    return i64 %sum
}
function @indirect_fresh(%fn : ptr, %p : ptr) -> i64 [no_inline=yes] {
  block ^entry:
    %q = call ptr %fn(%p) as (%arg : ptr) -> ptr [noalias_result=yes]
    %before = load i64 %p
    store i64 7, %q
    %sum = binary add i64 %before, %before
    return i64 %sum
}
function @ordinary_store(%p : ptr) -> i64 [no_inline=yes] {
  block ^entry:
    %q = call ptr @ordinary(%p)
    %before = load i64 %p
    store i64 7, %q
    %after = load i64 %p
    %sum = binary add i64 %before, %after
    return i64 %sum
}
function @published_alias(%p : ptr) -> i64 [no_inline=yes] {
  block ^entry:
    %q = call ptr @fresh(%p)
    store ptr %q, @published
    store i64 3, %q
    %alias = call ptr @reload()
    store i64 9, %alias
    %after = load i64 %q
    return i64 %after
}
function @main() -> i32 [role=entry] {
  slot $cell : i64

  block ^entry:
    %p = addr $cell
    store i64 5, %p
    %a = call i64 @call_writes(%p)
    store i64 5, %p
    %b = call i64 @fresh_store(%p)
    store i64 5, %p
    %c = call i64 @indirect_fresh(@fresh, %p)
    store i64 5, %p
    %d = call i64 @ordinary_store(%p)
    store i64 5, %p
    %e = call i64 @published_alias(%p)
    %da = binary xor i64 %a, 104
    %db = binary xor i64 %b, 198
    %dc = binary xor i64 %c, 198
    %dd = binary xor i64 %d, 12
    %de = binary xor i64 %e, 9
    %ab = binary or i64 %da, %db
    %cd = binary or i64 %dc, %dd
    %abcd = binary or i64 %ab, %cd
    %all = binary or i64 %de, %abcd
    %bad = cmp ne i64 %all, 0
    %out = convert zext i32 i1 %bad
    return i32 %out
}
