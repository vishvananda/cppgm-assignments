declare function @impossible_value() -> void

function @flags(%enabled : i64) -> i32 {
  block ^entry:
    %value = select i64 %enabled, 1, %enabled
    %set = binary or i64 %value, 2
    %result = convert trunc i32 i64 %set
    return i32 %result
}
function @address_bits() -> i32 {
  block ^entry:
    return i32 8
}
