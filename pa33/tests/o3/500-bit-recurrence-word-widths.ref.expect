# explicit-outcomes

# Closed recurrences must have bounded work; any equivalent lowering is allowed
# (one table of the low bits, two smaller tables, carry-less arithmetic).
instructions <= 16 in @fold_u8
instructions <= 16 in @fold_i8
instructions <= 16 in @fold_u16
instructions <= 16 in @fold_u32
instructions <= 16 in @fold_u32_flip
instructions <= 16 in @fold_i64
instructions <= 16 in @fold_i64_eight
instructions <= 28 in @fold_sixteen
