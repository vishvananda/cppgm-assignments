# explicit-outcomes

# GNU cold marks a rare path. A call of a cold function, and a call on the
# path to one, may stay a call or go inline: each bound leaves room for one
# copy of each callee. An ordinary caller still inlines a small callee.
none(call @helper) in @fast_path
instructions <= 22 in @fast_path
instructions <= 22 in @slow_path
instructions <= 48 in @checked_sum
instructions <= 18 in @noted
instructions <= 14 in @report
instructions <= 5 in @note
instructions <= 12 in @helper
