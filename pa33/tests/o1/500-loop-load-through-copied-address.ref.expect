# One pass of the walk loads the mark in `^body`; the element array comes in
# on each edge (the latch's load, or a load on the way into the loop).
count(load) <= 1 in @count_marked ^body
# budget from 500-loop-load-through-copied-address.ref: the course solution's count, widened by 10% and rounded up, plus one, and at least three more than the count
instructions <= 56
blocks <= 10
count(call) <= 4
count(load) <= 13
count(store) <= 6
count(phi) <= 7
instructions <= 40 in @count_marked
instructions <= 18 in @main
