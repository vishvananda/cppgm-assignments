// N3485 15.3p1, 1.9p14: the next counter value j is computed before the
// try-block; the handler returns it, so it is complete before the call
extern "C" int printf(const char*, ...);
typedef unsigned long U;
extern "C" U maythrow(U x);

__attribute__((noinline)) U counted(U n, U s0)
{
	U s = s0;
	for (U i = s0; i < n;)
	{
		U j = i + 1;
		try { s += maythrow(i); } catch (int e) { return j * 1000 + static_cast<U>(e); }
		i = j;
	}
	return s;
}

int main()
{
	printf("%lu %lu %lu\n", counted(10, 0), counted(10, 2), counted(3, 1));
	return 0;
}
