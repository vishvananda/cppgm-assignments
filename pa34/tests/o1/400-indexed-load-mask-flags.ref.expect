# The dynamic global-table sum shares the load's address operand: two
# loads of the walk, the mask, the table address, the field load, the return.
instructions <= 6 in @walk
# Masks confined below both sign bits reuse the logical flags.
instructions <= 5 in @masked16
instructions <= 5 in @masked8
# A computed address escaping the load must remain available.
instructions <= 10 in @live_address
