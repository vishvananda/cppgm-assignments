// Calls merge on both sides of its join; exit 0 when both results match.
extern "C" long merge(const long* p, long c);

extern "C" long step(long x) {
    return x * 3 + 1;
}

int main() {
    long x[16];
    for (int i = 0; i < 16; ++i)
        x[i] = 1000 + 37 * i;
    return (merge(x, 5) == 137973 ? 0 : 1) + (merge(x, 5000) == 151203 ? 0 : 2);
}
