extern "C" void merge(int* values, int* scratch, int left, int middle, int right);

static void sort(int* values, int* scratch, int left, int right) {
    if (left >= right)
        return;
    const int middle = (left + right) / 2;
    sort(values, scratch, left, middle);
    sort(values, scratch, middle + 1, right);
    merge(values, scratch, left, middle, right);
}

int main() {
    static int values[3000], scratch[3000];
    unsigned seed = 7;
    for (int i = 0; i < 3000; ++i) {
        seed = seed * 1664525u + 1013904223u;
        values[i] = static_cast<int>(seed >> 8) % 10007;
    }
    sort(values, scratch, 0, 2999);
    unsigned sum = 0;
    for (int i = 0; i < 3000; ++i) {
        if (i && values[i - 1] > values[i])
            return 1;
        sum = sum * 33 + static_cast<unsigned>(values[i]);
    }
    return 2 + sum % 199;
}
