using Wide = unsigned __int128;
extern "C" Wide transform(Wide, Wide, unsigned);
int main() {
    Wide x = (Wide(13) << 64) + 17, y = (Wide(2) << 64) + 7;
    Wide product = (Wide(136) << 64) + 129;
    if (transform(x, y, 0) != (product ^ x)) return 1;
    if (transform(x, y, 64) != (Wide(136) ^ (x << 32))) return 2;
    if (transform(x, y, 71) != (Wide(1) ^ (x << 35))) return 3;
    return 47;
}
