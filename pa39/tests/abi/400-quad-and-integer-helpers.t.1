using W = unsigned __int128;
extern "C" long double adjust(long double, long double);
extern "C" double divide_wide(W, W);
int main() {
    if (adjust(3.25L, 2.0L) != 9.0L) return 1;
    W divisor = (W(1) << 69) + 3;
    if (divide_wide(24 * divisor + 7, divisor) != 31.0) return 2;
    return 53;
}
