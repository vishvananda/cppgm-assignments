double lowest(double, double);
double highest(double, double);
double low_half(double);
double high_one(double);
float lowestf(float, float);
float low_halff(float);
double limit(double, double);
double flux(double, double, double, double, double, double, double);
}

static const double inf = __builtin_inf();
static const double nan = __builtin_nan("");

static unsigned long dbits(double x) {
    union {
        double value;
        unsigned long bits;
    } u;
    u.value = x;
    return u.bits;
}

static unsigned fbits(float x) {
    union {
        float value;
        unsigned bits;
    } u;
    u.value = x;
    return u.bits;
}

