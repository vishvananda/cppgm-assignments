extern "C" void carried(long*, long*, long);
extern "C" long walked(long*);

long state[2], record[24], words[12];

int main() {
    state[0] = 2;
    state[1] = 5;
    carried(state, record, 20);
    long sum = 5;
    for (long i = 0; i != 20; ++i) {
        if (record[i] != i + 2) return 1;
        sum += (i + 2) * (i + 2) * (i + 2);
    }
    if (state[0] != 22 || state[1] != sum) return 2;
    // The log may be the state itself: each pass then reads what the last one logged.
    long both[4] = {3, 0, 0, 0};
    carried(both, both, 2);
    if (both[0] != 4 || both[1] != 3 || both[2] != 0) return 3;
    long total = 0;
    for (int i = 0; i != 8; ++i) words[i] = 10 * i + 10;
    for (int i = 0; i != 8; i += 2) total += words[i] ^ words[i + 1];
    if (walked(words) != total) return 4;
    for (int i = 0; i != 8; i += 2)
        if (words[i] != 10 * i + 20 || words[i + 1] != 10 * i + 11) return 5;
    if (words[8] != 0 || words[9] != 0) return 6;
    return 41;
}
