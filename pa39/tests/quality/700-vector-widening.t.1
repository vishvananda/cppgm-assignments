static short sc(int i) {
    if (i % 5 == 0) return i % 2 ? 32767 : -32768;
    return (short)(unsigned short)(((i * 7919) ^ (i << 9)) & 0xffff);
}
static const signed char s8v[7] = {-128, 127, -1, 0, 1, 100, -100};
static const unsigned char u8v[6] = {0, 255, 128, 127, 1, 254};
static const unsigned short u16v[6] = {0, 65535, 32768, 32767, 1, 40000};
static const int i32v[7] = {-2147483647 - 1, 2147483647, -1, 0, 12345678, -87654321, 65536 * 3 + 7};
static const unsigned u32v[6] = {0, 4294967295u, 2147483648u, 31, 32, 123456789};

static unsigned long hash(const int* v, int n) {
    unsigned long h = 0;
    for (int i = 0; i < n; ++i) h = h * 1000003 + (unsigned)v[i];
    return h;
}
static unsigned long hash16(const short* v, int n) {
    unsigned long h = 0;
    for (int i = 0; i < n; ++i) h = h * 1000003 + (unsigned)(int)v[i];
    return h;
}

