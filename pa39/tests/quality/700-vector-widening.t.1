    if (hash16(w16, 48) != 0xf5d3732008b3698eUL) failed = 5;
    for (int i = 0; i < 48; ++i) { t16[i] = sc(i) >> 1; w16[i] = sc(i + 11) >> 1; }
    if ((unsigned)dot_product(t16, w16, 0) != 0x0u) failed = 6;
    for (int i = 0; i < 48; ++i) { t16[i] = sc(i) >> 1; w16[i] = sc(i + 11) >> 1; }
