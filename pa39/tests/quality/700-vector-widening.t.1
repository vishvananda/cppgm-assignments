    for (int i = 0; i < 48; ++i) { s8a[i] = s8v[i % 7]; u8a[i] = u8v[i % 6]; s16a[i] = sc(i); u16a[i] = u16v[i % 6]; i32a[i] = i32v[i % 7]; u32a[i] = u32v[i % 6]; d16[i] = seven; d32[i] = i * 1000 - 20000; }
