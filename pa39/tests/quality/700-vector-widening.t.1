void widen8u(short*, const unsigned char*, int);
void widen16(int*, const short*, int);
void widen16u(int*, const unsigned short*, int);
void addw16(int*, const short*, int);
void addw16u(int*, const unsigned short*, int);
int sum16(const short*, int);
