// Calls each function with 32-bit arguments whose high bits are set, with
// increments that wrap, equal and unordered operands, and narrow operands
// whose signed and unsigned orders differ.

extern "C" {
int merge_step(const int*, unsigned long, unsigned long, int*);
long count_up(long, long, long);
unsigned count_down(unsigned long, unsigned long, unsigned long);
int float_step(unsigned long, double, double);
long span(const char*, const char*);
int narrow(unsigned long, unsigned long, unsigned long, unsigned long);
}

static const unsigned long high = 0xa5a5a5a500000000UL;
static const int values[] = { 7, 3, 3, -9, 12, 7 };
static char buffer[64];

int main() {
    double zero = 0.0;
    double nan = zero / zero;
    int out = 0;
    if (merge_step(values, high | 0, high | 1, &out) != 0 * 1000 + 2 || out != 3)
        return 1;
    if (merge_step(values, high | 1, high | 2, &out) != 2 * 1000 + 2 || out != 3)
        return 2;
    if (merge_step(values, high | 3, high | 4, &out) != 4 * 1000 + 4 || out != -9)
        return 3;
    if (merge_step(values, high | 0, high | 5, &out) != 1 * 1000 + 5 || out != 7)
        return 4;
    if (merge_step(values, high | 4, high | 3, &out) != 4 * 1000 + 4 || out != -9)
        return 5;
    if (count_up(41, 9, 11) != 42 || count_up(41, 10, 10) != 41 || count_up(-1, -3, 3) != 0)
        return 6;
    if (count_up(0x7ffffffffL, 99, 1) != 0x800000000L)
        return 7;
    if (count_down(high | 0xffffffffu, high | 1, high | 2) != 0 || count_down(high | 5, high | 2, high | 1) != 5)
        return 8;
    if (count_down(high | 5, high | 2, high | 2) != 6)
        return 9;
    if (float_step(high | 0xffffffffu, 1.0, 2.0) != 0 || float_step(high | 9, 2.0, 1.0) != 9)
        return 10;
    if (float_step(high | 9, nan, 1.0) != 9 || float_step(high | 9, 1.0, 1.0) != 9)
        return 11;
    if (span(buffer + 3, buffer + 40) != 37 || span(buffer + 40, buffer + 3) != 37 || span(buffer, buffer) != 0)
        return 12;
    if (narrow(high | 0xff, high | 1, high | 2, high | 3) != 10 + 40 + 1)
        return 13;
    if (narrow(high | 1, high | 0xff, high | 3, high | 2) != 20 + 30 + 0)
        return 14;
    if (narrow(high | 0x80, high | 0x7f, high | 0xff, high | 0xff) != 10 + 40 + 0)
        return 15;
    if (narrow(high | 5, high | 5, high | 0, high | 0xff) != 20 + 40 + 1)
        return 16;
    return 37;
}
