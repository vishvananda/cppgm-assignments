// Fills each destination with set bits, calls the function and checks every
// stored word: positive zeros have no bits set, negative zeros only the sign
// bit, and the word between the float stores is unchanged.

extern "C" {
struct Sums {
    double a, b, c, d;
};
void clear(Sums*);
void clear_floats(float*);
void negative_zero(double*, float*);
}

union Doubles {
    Sums sums;
    double d[4];
    unsigned long bits[4];
};
union Floats {
    float f[4];
    unsigned bits[4];
};

int main() {
    Doubles s;
    for (int i = 0; i < 4; ++i)
        s.bits[i] = 0xa5a5a5a5a5a5a5a5UL;
    clear(&s.sums);
    for (int i = 0; i < 4; ++i)
        if (s.bits[i] != 0)
            return 1 + i;
    Floats f;
    for (int i = 0; i < 4; ++i)
        f.bits[i] = 0xa5a5a5a5u;
    clear_floats(f.f);
    if (f.bits[0] != 0 || f.bits[1] != 0 || f.bits[2] != 0xa5a5a5a5u || f.bits[3] != 0)
        return 10;
    Doubles n;
    Floats g;
    n.bits[0] = 0;
    g.bits[0] = 0;
    negative_zero(n.d, g.f);
    if (n.bits[0] != 0x8000000000000000UL || g.bits[0] != 0x80000000u)
        return 11;
    return 37;
}
