extern "C" unsigned rotate_mix(const unsigned*, unsigned);
extern "C" void sift_down(double*, int, int);

int main() {
    unsigned input[40];
    for (unsigned i = 0; i != 40; ++i) input[i] = i * 2654435761u >> 7;
    if (rotate_mix(input, 0) != 1 * 3 + 2 * 5 + 3 * 7) return 1;
    unsigned mixed = rotate_mix(input, 40);
    double heap[32];
    for (int i = 1; i != 32; ++i) heap[i] = (i * 37) % 31;
    for (int top = 15; top >= 1; --top) sift_down(heap, top, 31);
    for (int i = 2; i != 32; ++i)
        if (heap[i / 2] < heap[i]) return 2;
    for (int size = 31; size > 1; --size) {
        double largest = heap[1];
        heap[1] = heap[size];
        heap[size] = largest;
        sift_down(heap, 1, size - 1);
    }
    for (int i = 2; i != 32; ++i)
        if (heap[i - 1] > heap[i]) return 3;
    return mixed % 97 + 10;
}
