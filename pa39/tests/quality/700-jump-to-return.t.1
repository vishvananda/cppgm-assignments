extern "C" void spread(long** slot, long* const* from, const char* steps);

int main() {
    long cells[4] = {5, 6, 7, 8};
    long* none = 0;
    long* some = cells;
    long* slot = cells;
    spread(&slot, &none, "ab");
    if (slot)
        return 1;
    spread(&slot, &some, "");
    if (slot != cells || cells[0] != 6)
        return 2;
    spread(&slot, &some, "abc");
    return cells[0] == 6 && cells[1] == 7 && cells[2] == 9 && cells[3] == 8 ? 0 : 3;
}
