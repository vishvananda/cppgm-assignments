extern "C" int dispatch(int, int (*)(int), int);
int twice(int x) { return 2 * x; }
extern "C" int dense(long, int (*)(int), int);
extern "C" int classify_char(int, int (*)(int));
extern "C" int classify_span(const char*, const char*, int (*)(int));
struct Code { unsigned char kind, count, offset; };
extern "C" Code code_for(int);
int main() {
    char bytes[] = {'a', 'x', 'b', 'c'};
    if (classify_span(bytes, bytes, twice) != 0 || classify_span(bytes, bytes + 1, twice) != 0 ||
        classify_span(bytes, bytes + 2, twice) != 2 || classify_span(bytes, bytes + 3, twice) != 4 ||
        classify_span(bytes + 1, bytes, twice) != 0) return 9;
    static const int keys[] = {-103,-102,-100,-99,-98,-97,65530,65531,65532,65534,65535,65536};
    for (int i = 0; i < 12; ++i) {
        Code a = code_for(keys[i]);
        if (a.kind != (i < 6 ? 1 : 7) || a.count != i % 6 || a.offset != (i < 6 ? 19 : 251)) return 6;
    }
    static const int misses[] = {-2147483647-1, -104, -101, -96, 0, 65529, 65533, 65537, 2147483647};
    for (int n : misses) {
        Code a = code_for(n);
        if (a.kind != 255 || a.count != 6 || a.offset != 0) return 7;
    }
    for (int c = -3; c < 70; ++c) {
        int want = 7 + 2*(c & 1);
        if (c == -1) want = 2;
        if (c == 10) want = 6;
        if (c == 9 || (c >= 11 && c <= 13) || c == 32 || c == 47) want = 5;
        if (classify_char(c, twice) != want) return 3;
    }
    if (classify_char(-2147483647-1, twice) != 7 || classify_char(2147483647, twice) != 9) return 4;
    static const int expected[] = {27, 27, 21, 3, 27, 9, 9, 98, 19, 27, -7, 23, 27, 27};
    for (int i = 0; i < 14; ++i)
        if (dense(i - 7, twice, 7) != expected[i]) return 1;
    if (dense(0x100000000L, twice, 7) != 27 || dense(-0x100000000L, twice, 7) != 27) return 2;
    return dispatch(-201, twice, 7) + dispatch(4, twice, 10)
        + dispatch(9001, twice, 15) + dispatch(0, twice, 10);
}
