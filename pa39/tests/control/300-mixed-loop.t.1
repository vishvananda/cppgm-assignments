static bool marked_correctly(int last, int offset, unsigned pattern) {
    int expected[24], actual[24];
    for (int i = 0; i < 24; ++i)
        actual[i] = expected[i] = ((pattern >> (i % 8)) & 1) ? i + 1 : 0;
    for (int i = 0; i <= last; ++i)
        if (expected[2 + i]) expected[2 + offset + i] = 7;
    mark_nonzero(actual + 2, actual + 2 + offset, last);
    for (int i = 0; i < 24; ++i)
        if (actual[i] != expected[i]) return false;
    return true;
}
int main() {
