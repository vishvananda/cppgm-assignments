function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $x : obj<4x4>

  block ^entry:
    %t1 = addr $x
    %t2 = addr $x
    %t3 = index inbounds i8 [projection=field] %t2, 0
    store typed i32 1, %t3
    %t4 = addr $x
    %t5 = index inbounds i8 [projection=field] %t4, 0
    %t6 = load typed i32 %t5
    %t7 = call i32 @pick(%t6)
    %t8 = call i32 @pick__2(1)
    %t9 = binary add nowrap i32 %t7, %t8
    %t10 = binary sub nowrap i32 %t9, 3
    return i32 %t10
}
function @pick(%__param0 : i32) -> i32 [binding=weak, object=_Z4pickIiEiT_] {
  slot $__param0 : i32

  block ^entry:
    store typed i32 %__param0, $__param0
    return i32 2
}
