#include <fenv.h>

#ifndef __cplusplus
#pragma STDC FENV_ACCESS ON
#endif

int main(void)
{
    const int saved = fegetround();
    static const int modes[] = {FE_TOWARDZERO, FE_TONEAREST, FE_UPWARD, FE_DOWNWARD};
    for (int expected = 0; expected != 4; ++expected) {
        if (fesetround(modes[expected]) != 0)
            return 10 + expected;
        if (__builtin_flt_rounds() != expected)
            return 20 + expected;
    }
    return fesetround(saved) != 0;
}
