function @sizes(%rows : i32, %columns : i32) -> i32 [linkage=c, binding=internal] {
  slot $rows : i32
  slot $columns : i32
  slot $bytes : i64
  slot $tmpobj__1 : i64
  slot $tmpobj__2 : i64
  slot $tmpobj__3 : i64
  slot $incidental : i32
  slot $pointer : i64
  slot $alignment_bound : i32
  slot $alignment : i64
  slot $land__4 : i64
  slot $land__5 : i64
  slot $land__6 : i64
  slot $land__7 : i64
  slot $lor__8 : i64
  slot $land__9 : i64
  slot $land__10 : i64

  block ^entry:
    store typed i32 %rows, $rows
    store typed i32 %columns, $columns
    %t1 = load typed i32 $columns
    %t2 = binary add nowrap i32 %t1, 1
    store typed i32 %t2, $columns
    %t3 = convert sext i64 i32 %t1
    %t4 = binary mul i64 %t3, 4
    store typed i64 %t4, $tmpobj__1
    %t5 = load typed i32 $rows
    %t6 = binary add nowrap i32 %t5, 1
    store typed i32 %t6, $rows
    %t7 = convert sext i64 i32 %t5
    %t8 = load typed i64 $tmpobj__1
    %t9 = binary mul i64 %t7, %t8
    store typed i64 %t9, $tmpobj__2
    store typed i64 %t9, $bytes
    %t10 = load typed i32 $rows
    %t11 = binary add nowrap i32 %t10, 1
    store typed i32 %t11, $rows
    %t12 = convert sext i64 i32 %t10
    %t13 = binary mul i64 %t12, 4
    store typed i64 %t13, $tmpobj__3
    store typed i32 2, $incidental
    %t14 = const i64 8
    store typed i64 %t14, $pointer
    store typed i32 2, $alignment_bound
    %t15 = const i64 4
    store typed i64 %t15, $alignment
    %t16 = load typed i64 $bytes
    %t17 = const i64 4
    %t18 = convert sext i64 i32 12
    %t19 = binary mul i64 %t18, %t17
    %t20 = cmp eq i64 %t16, %t19
    %t21 = convert trunc i32 i64 %t20
    branch %t21, ^land_rhs_1, ^land_short_2

  block ^land_rhs_1:
    %t22 = load typed i32 $rows
    %t23 = cmp eq i32 %t22, 5
    %t24 = convert trunc i32 i64 %t23
    %t25 = cmp ne i32 %t24, 0
    store typed i64 %t25, $land__4
    jump ^land_end_3

  block ^land_short_2:
    store typed i64 0, $land__4
    jump ^land_end_3

  block ^land_end_3:
    %t26 = load typed i64 $land__4
    branch %t26, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t27 = load typed i32 $columns
    %t28 = cmp eq i32 %t27, 5
    %t29 = convert trunc i32 i64 %t28
    %t30 = cmp ne i32 %t29, 0
    store typed i64 %t30, $land__5
    jump ^land_end_6

  block ^land_short_5:
    store typed i64 0, $land__5
    jump ^land_end_6

  block ^land_end_6:
    %t31 = load typed i64 $land__5
    branch %t31, ^land_rhs_7, ^land_short_8

  block ^land_rhs_7:
    %t32 = load typed i64 $pointer
    %t33 = const i64 8
    %t34 = cmp eq i64 %t32, %t33
    %t35 = convert trunc i32 i64 %t34
    %t36 = cmp ne i32 %t35, 0
    store typed i64 %t36, $land__6
    jump ^land_end_9

  block ^land_short_8:
    store typed i64 0, $land__6
    jump ^land_end_9

  block ^land_end_9:
    %t37 = load typed i64 $land__6
    branch %t37, ^land_rhs_10, ^land_short_11

  block ^land_rhs_10:
    %t38 = load typed i32 $incidental
    %t39 = cmp eq i32 %t38, 2
    %t40 = convert trunc i32 i64 %t39
    branch %t40, ^lor_short_14, ^lor_rhs_13

  block ^lor_rhs_13:
    %t41 = load typed i32 $incidental
    %t42 = cmp eq i32 %t41, 3
    %t43 = convert trunc i32 i64 %t42
    %t44 = cmp ne i32 %t43, 0
    store typed i64 %t44, $lor__8
    jump ^lor_end_15

  block ^lor_short_14:
    store typed i64 1, $lor__8
    jump ^lor_end_15

  block ^lor_end_15:
    %t45 = load typed i64 $lor__8
    %t46 = convert trunc i32 i64 %t45
    %t47 = cmp ne i32 %t46, 0
    store typed i64 %t47, $land__7
    jump ^land_end_12

  block ^land_short_11:
    store typed i64 0, $land__7
    jump ^land_end_12

  block ^land_end_12:
    %t48 = load typed i64 $land__7
    branch %t48, ^land_rhs_16, ^land_short_17

  block ^land_rhs_16:
    %t49 = load typed i64 $alignment
    %t50 = const i64 4
    %t51 = cmp eq i64 %t49, %t50
    %t52 = convert trunc i32 i64 %t51
    %t53 = cmp ne i32 %t52, 0
    store typed i64 %t53, $land__9
    jump ^land_end_18

  block ^land_short_17:
    store typed i64 0, $land__9
    jump ^land_end_18

  block ^land_end_18:
    %t54 = load typed i64 $land__9
    branch %t54, ^land_rhs_19, ^land_short_20

  block ^land_rhs_19:
    %t55 = load typed i32 $alignment_bound
    %t56 = cmp eq i32 %t55, 2
    %t57 = convert trunc i32 i64 %t56
    %t58 = cmp ne i32 %t57, 0
    store typed i64 %t58, $land__10
    jump ^land_end_21

  block ^land_short_20:
    store typed i64 0, $land__10
    jump ^land_end_21

  block ^land_end_21:
    %t59 = load typed i64 $land__10
    %t60 = convert trunc i32 i64 %t59
    return i32 %t60
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    %t1 = call i32 @sizes(3, 4)
    %t2 = cmp eq i32 %t1, 0
    %t3 = convert trunc i32 i64 %t2
    return i32 %t3
}
