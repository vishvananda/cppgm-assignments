global @self : obj<32x32> [linkage=c, binding=internal] = {
  i32 32
}
global @alias_self : obj<8x8> [linkage=c, binding=internal] = {
  i32 8
}

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $count : i32
  slot $tmpobj__1 : i64
  slot $cleanup_return__2 : i32
  slot $lor__3 : i64
  slot $lor__4 : i64

  block ^entry:
    store typed i32 2, $count
    %t1 = load typed i32 $count
    %t2 = convert sext i64 i32 %t1
    %t3 = binary mul i64 %t2, 4
    store typed i64 %t3, $tmpobj__1
    %t4 = stack_save
    %t5 = stack_alloc %t3
    %t6 = const i64 16
    %t7 = convert sext i64 i32 16
    %t8 = cmp ne i64 %t6, %t7
    %t9 = convert trunc i32 i64 %t8
    branch %t9, ^if_then_1, ^lor_rhs_3

  block ^lor_rhs_3:
    %t10 = const i64 4
    %t11 = const i64 4
    %t12 = cmp ne i64 %t10, %t11
    %t13 = convert trunc i32 i64 %t12
    branch %t13, ^if_then_1, ^if_else_2

  block ^if_then_1:
    store typed i32 1, $cleanup_return__2
    jump ^return_cleanup_action_5

  block ^return_cleanup_terminal_4:
    return i32 $cleanup_return__2

  block ^return_cleanup_action_5:
    stack_restore %t4
    jump ^return_cleanup_terminal_4

  block ^if_else_2:
    jump ^if_end_6

  block ^if_end_6:
    %t14 = load typed i32 $count
    %t15 = cmp ne i32 %t14, 2
    %t16 = convert trunc i32 i64 %t15
    branch %t16, ^lor_short_8, ^lor_rhs_7

  block ^lor_rhs_7:
    %t17 = load typed i32 @self
    %t18 = cmp ne i32 %t17, 32
    %t19 = convert trunc i32 i64 %t18
    %t20 = cmp ne i32 %t19, 0
    store typed i64 %t20, $lor__3
    jump ^lor_end_9

  block ^lor_short_8:
    store typed i64 1, $lor__3
    jump ^lor_end_9

  block ^lor_end_9:
    %t21 = load typed i64 $lor__3
    branch %t21, ^lor_short_11, ^lor_rhs_10

  block ^lor_rhs_10:
    %t22 = load typed i32 @alias_self
    %t23 = cmp ne i32 %t22, 8
    %t24 = convert trunc i32 i64 %t23
    %t25 = cmp ne i32 %t24, 0
    store typed i64 %t25, $lor__4
    jump ^lor_end_12

  block ^lor_short_11:
    store typed i64 1, $lor__4
    jump ^lor_end_12

  block ^lor_end_12:
    %t26 = load typed i64 $lor__4
    %t27 = convert trunc i32 i64 %t26
    store typed i32 %t27, $cleanup_return__2
    jump ^return_cleanup_action_5
}
