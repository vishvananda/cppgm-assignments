global @width : i32 [storage=readonly, linkage=c, binding=internal] = 34
global @negative : i32 [storage=readonly, linkage=c, binding=internal] = -9
global @exact : f32 [storage=readonly, linkage=c, binding=internal] = 1.5f
global @truncated : i32 [storage=readonly, linkage=c, binding=internal] = 1
global @nothing : ptr [storage=readonly, linkage=c, binding=internal] = 0
global @other : ptr [storage=readonly, linkage=c, binding=internal] = 0
global @zero : i64 [storage=readonly, linkage=c, binding=internal] = 0
global @octet : u8 [storage=readonly, linkage=c, binding=internal] = 255
global @text [storage=readonly, linkage=c, binding=internal] = {
  u8 255
  u8 0
}
global @previous : ptr [linkage=c, binding=internal] = zero

function @observe(%first : ptr, %second : ptr) -> i32 [linkage=c, binding=strong] {
  slot $first : ptr
  slot $second : ptr
  slot $land__1 : i64

  block ^entry:
    store typed ptr %first, $first
    store typed ptr %second, $second
    %t1 = load typed ptr $first
    %t2 = load typed ptr $second
    %t3 = cmp ne ptr %t1, %t2
    %t4 = convert trunc i32 i64 %t3
    branch %t4, ^land_rhs_1, ^land_short_2

  block ^land_rhs_1:
    %t5 = load typed ptr $first
    %t6 = load typed i32 %t5
    %t7 = load typed ptr $second
    %t8 = load typed i32 %t7
    %t9 = cmp eq i32 %t6, %t8
    %t10 = convert trunc i32 i64 %t9
    %t11 = cmp ne i32 %t10, 0
    store typed i64 %t11, $land__1
    jump ^land_end_3

  block ^land_short_2:
    store typed i64 0, $land__1
    jump ^land_end_3

  block ^land_end_3:
    %t12 = load typed i64 $land__1
    %t13 = convert trunc i32 i64 %t12
    return i32 %t13
}
function @check_addresses(%depth : i32) -> i32 [linkage=c, binding=internal] {
  slot $depth : i32
  slot $local : i32

  block ^entry:
    store typed i32 %depth, $depth
    store typed i32 35, $local
    %t1 = load typed i32 $depth
    %t2 = cmp eq i32 %t1, 0
    %t3 = convert trunc i32 i64 %t2
    branch %t3, ^if_then_1, ^if_else_2

  block ^if_then_1:
    %t4 = addr $local
    store typed ptr %t4, @previous
    %t5 = call i32 @check_addresses(1)
    return i32 %t5

  block ^if_else_2:
    jump ^if_end_3

  block ^if_end_3:
    %t6 = load typed ptr @previous
    %t7 = addr $local
    %t8 = call i32 @observe(%t6, %t7)
    return i32 %t8
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $extra : i32
  slot $lor__1 : i64
  slot $lor__2 : i64
  slot $lor__3 : i64
  slot $lor__4 : i64

  block ^entry:
    store typed i32 3, $extra
    %t1 = call i32 @check_addresses(0)
    %t2 = cmp eq i32 %t1, 0
    %t3 = convert trunc i32 i64 %t2
    branch %t3, ^lor_short_2, ^lor_rhs_1

  block ^lor_rhs_1:
    %t4 = copy ptr 0
    %t5 = cmp ne ptr 0, %t4
    %t6 = convert trunc i32 i64 %t5
    %t7 = cmp ne i32 %t6, 0
    store typed i64 %t7, $lor__1
    jump ^lor_end_3

  block ^lor_short_2:
    store typed i64 1, $lor__1
    jump ^lor_end_3

  block ^lor_end_3:
    %t8 = load typed i64 $lor__1
    branch %t8, ^lor_short_5, ^lor_rhs_4

  block ^lor_rhs_4:
    %t9 = copy ptr 0
    %t10 = cmp ne ptr 0, %t9
    %t11 = convert trunc i32 i64 %t10
    %t12 = cmp ne i32 %t11, 0
    store typed i64 %t12, $lor__2
    jump ^lor_end_6

  block ^lor_short_5:
    store typed i64 1, $lor__2
    jump ^lor_end_6

  block ^lor_end_6:
    %t13 = load typed i64 $lor__2
    branch %t13, ^lor_short_8, ^lor_rhs_7

  block ^lor_rhs_7:
    %t14 = cmp ne i64 0, 0
    %t15 = convert trunc i32 i64 %t14
    %t16 = cmp ne i32 %t15, 0
    store typed i64 %t16, $lor__3
    jump ^lor_end_9

  block ^lor_short_8:
    store typed i64 1, $lor__3
    jump ^lor_end_9

  block ^lor_end_9:
    %t17 = load typed i64 $lor__3
    branch %t17, ^lor_short_11, ^lor_rhs_10

  block ^lor_rhs_10:
    %t18 = addr @text
    %t19 = index inbounds u8 [projection=array_element] %t18, 0
    %t20 = load u8 %t19
    %t21 = convert zext i32 u8 %t20
    %t22 = convert zext i32 u8 255
    %t23 = cmp ne i32 %t21, %t22
    %t24 = convert trunc i32 i64 %t23
    %t25 = cmp ne i32 %t24, 0
    store typed i64 %t25, $lor__4
    jump ^lor_end_12

  block ^lor_short_11:
    store typed i64 1, $lor__4
    jump ^lor_end_12

  block ^lor_end_12:
    %t26 = load typed i64 $lor__4
    %t27 = convert trunc i32 i64 %t26
    return i32 %t27
}
