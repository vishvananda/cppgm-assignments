global @pair [linkage=c, binding=internal] = {
  u8 3
  u8 5
}

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $copy : obj<2x1>
  slot $land__1 : i64

  block ^entry:
    %t1 = addr $copy
    %t2 = load obj<2x1> @pair
    store obj<2x1> %t2, %t1
    %t3 = addr $copy
    %t4 = index inbounds i8 [projection=field] %t3, 0
    %t5 = load u8 %t4
    %t6 = convert zext i32 u8 %t5
    %t7 = cmp eq i32 %t6, 3
    %t8 = convert trunc i32 i64 %t7
    branch %t8, ^land_rhs_1, ^land_short_2

  block ^land_rhs_1:
    %t9 = addr $copy
    %t10 = index inbounds i8 [projection=field] %t9, 1
    %t11 = load u8 %t10
    %t12 = convert zext i32 u8 %t11
    %t13 = cmp eq i32 %t12, 5
    %t14 = convert trunc i32 i64 %t13
    %t15 = cmp ne i32 %t14, 0
    store typed i64 %t15, $land__1
    jump ^land_end_3

  block ^land_short_2:
    store typed i64 0, $land__1
    jump ^land_end_3

  block ^land_end_3:
    %t16 = load typed i64 $land__1
    %t17 = convert trunc i32 i64 %t16
    %t18 = cmp eq i32 %t17, 0
    %t19 = convert trunc i32 i64 %t18
    return i32 %t19
}
