global @pair [linkage=c, binding=internal] = {
  u8 3
  u8 5
}
global @evaluations : i32 [linkage=c, binding=internal] = zero

function @destination(%pair : ptr) -> ptr [linkage=c, binding=internal] {
  slot $pair : ptr

  block ^entry:
    store typed ptr %pair, $pair
    %t1 = load typed i32 @evaluations
    %t2 = binary add nowrap i32 %t1, 1
    store typed i32 %t2, @evaluations
    %t3 = load typed ptr $pair
    %t4 = index inbounds i8 [projection=field] %t3, 1
    return ptr %t4
}
function @replacement() -> obj<1x1> [linkage=c, binding=internal] {
  slot $retobj__1 : obj<1x1>
  slot $tmpobj__2 : obj<1x1>

  block ^entry:
    %t1 = load typed i32 @evaluations
    %t2 = binary add nowrap i32 %t1, 1
    store typed i32 %t2, @evaluations
    %t3 = addr $retobj__1
    %t4 = addr $tmpobj__2
    return obj<1x1> $retobj__1
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $copy : obj<2x1>
  slot $discard__1 : obj<1x1>
  slot $complex__2 : obj<1x1>
  slot $complex__3 : obj<1x1>
  slot $land__4 : i64
  slot $land__5 : i64

  block ^entry:
    %t1 = addr $copy
    %t2 = load obj<2x1> @pair
    store obj<2x1> %t2, %t1
    %t3 = addr $discard__1
    %t4 = call obj<1x1> @replacement()
    %t5 = addr $copy
    %t6 = call ptr @destination(%t5)
    zeroinit 1x1 $complex__2
    %t7 = load obj<1x1> $complex__2
    %t8 = addr $copy
    %t9 = index inbounds i8 [projection=field] %t8, 1
    %t10 = addr $copy
    %t11 = index inbounds i8 [projection=field] %t10, 1
    zeroinit 1x1 $complex__3
    %t12 = load obj<1x1> $complex__3
    %t13 = addr $copy
    %t14 = index inbounds i8 [projection=field] %t13, 0
    %t15 = load u8 %t14
    %t16 = convert zext i32 u8 %t15
    %t17 = cmp eq i32 %t16, 3
    %t18 = convert trunc i32 i64 %t17
    branch %t18, ^land_rhs_1, ^land_short_2

  block ^land_rhs_1:
    %t19 = addr $copy
    %t20 = index inbounds i8 [projection=field] %t19, 1
    %t21 = load u8 %t20
    %t22 = convert zext i32 u8 %t21
    %t23 = cmp eq i32 %t22, 5
    %t24 = convert trunc i32 i64 %t23
    %t25 = cmp ne i32 %t24, 0
    store typed i64 %t25, $land__4
    jump ^land_end_3

  block ^land_short_2:
    store typed i64 0, $land__4
    jump ^land_end_3

  block ^land_end_3:
    %t26 = load typed i64 $land__4
    branch %t26, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t27 = load typed i32 @evaluations
    %t28 = cmp eq i32 %t27, 2
    %t29 = convert trunc i32 i64 %t28
    %t30 = cmp ne i32 %t29, 0
    store typed i64 %t30, $land__5
    jump ^land_end_6

  block ^land_short_5:
    store typed i64 0, $land__5
    jump ^land_end_6

  block ^land_end_6:
    %t31 = load typed i64 $land__5
    %t32 = convert trunc i32 i64 %t31
    %t33 = cmp eq i32 %t32, 0
    %t34 = convert trunc i32 i64 %t33
    return i32 %t34
}
