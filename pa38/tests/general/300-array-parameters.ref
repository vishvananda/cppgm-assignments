global @__constexpr_template__1 [storage=readonly, binding=internal] = {
  i32 2
  i32 3
  i32 7
}

function @sum(%values : ptr) -> i32 [linkage=c, binding=strong] {
  slot $values : ptr

  block ^entry:
    store typed ptr %values, $values
    %t1 = load typed ptr $values
    %t2 = index inbounds i32 [projection=array_element] %t1, 0
    %t3 = load typed i32 %t2
    %t4 = load typed ptr $values
    %t5 = index inbounds i32 [projection=array_element] %t4, 1
    %t6 = load typed i32 %t5
    %t7 = binary add nowrap i32 %t3, %t6
    %t8 = load typed ptr $values
    %t9 = index inbounds i32 [projection=array_element] %t8, 2
    %t10 = load typed i32 %t9
    %t11 = binary add nowrap i32 %t7, %t10
    return i32 %t11
}
function @update(%values : ptr) -> i32 [linkage=c, binding=strong] {
  slot $values : ptr

  block ^entry:
    store typed ptr %values, $values
    %t1 = load volatile ptr $values
    %t2 = index inbounds i32 [projection=array_element] %t1, 0
    %t3 = load typed i32 %t2
    %t4 = load volatile ptr $values
    %t5 = index inbounds i32 [projection=array_element] %t4, 1
    %t6 = load typed i32 %t5
    %t7 = binary add nowrap i32 %t6, %t3
    store typed i32 %t7, %t5
    %t8 = load volatile ptr $values
    %t9 = index inbounds i32 [projection=array_element] %t8, 1
    %t10 = load typed i32 %t9
    return i32 %t10
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $values : obj<12x4>
  slot $land__1 : i64

  block ^entry:
    %t1 = addr $values
    copyobj 12x4 @__constexpr_template__1, %t1
    %t2 = addr $values
    %t3 = call i32 @sum(%t2)
    %t4 = cmp eq i32 %t3, 12
    %t5 = convert trunc i32 i64 %t4
    branch %t5, ^land_rhs_1, ^land_short_2

  block ^land_rhs_1:
    %t6 = addr $values
    %t7 = call i32 @update(%t6)
    %t8 = cmp eq i32 %t7, 5
    %t9 = convert trunc i32 i64 %t8
    %t10 = cmp ne i32 %t9, 0
    store typed i64 %t10, $land__1
    jump ^land_end_3

  block ^land_short_2:
