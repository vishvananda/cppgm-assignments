global @aligned : obj<4x4> [linkage=c, binding=internal] = {
  zero 1
}

function @probe(%n : i32, %m : i32) -> i32 [linkage=c, binding=internal] {
  slot $n : i32
  slot $m : i32
  slot $tmpobj__1 : i64
  slot $lor__2 : i64
  slot $lor__3 : i64

  block ^entry:
    store typed i32 %n, $n
    store typed i32 %m, $m
    %t1 = load typed i32 $n
    %t2 = convert sext i64 i32 %t1
    %t3 = binary mul i64 %t2, 4
    store typed i64 %t3, $tmpobj__1
    %t4 = cmp eq i32 1, 0
    %t5 = convert trunc i32 i64 %t4
    branch %t5, ^lor_short_2, ^lor_rhs_1

  block ^lor_rhs_1:
    %t6 = load typed i32 $n
    %t7 = cmp ne i32 %t6, 7
    %t8 = convert trunc i32 i64 %t7
    %t9 = cmp ne i32 %t8, 0
    store typed i64 %t9, $lor__2
    jump ^lor_end_3

  block ^lor_short_2:
    store typed i64 1, $lor__2
    jump ^lor_end_3

  block ^lor_end_3:
    %t10 = load typed i64 $lor__2
    branch %t10, ^lor_short_5, ^lor_rhs_4

  block ^lor_rhs_4:
    %t11 = load typed i32 $m
    %t12 = cmp ne i32 %t11, 9
    %t13 = convert trunc i32 i64 %t12
    %t14 = cmp ne i32 %t13, 0
    store typed i64 %t14, $lor__3
    jump ^lor_end_6

  block ^lor_short_5:
    store typed i64 1, $lor__3
    jump ^lor_end_6

  block ^lor_end_6:
    %t15 = load typed i64 $lor__3
    %t16 = convert trunc i32 i64 %t15
    return i32 %t16
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $lor__1 : i64

  block ^entry:
    %t1 = call i32 @probe(7, 9)
    branch %t1, ^lor_short_2, ^lor_rhs_1

  block ^lor_rhs_1:
    %t2 = const i64 4
    %t3 = const i64 4
    %t4 = cmp ne i64 %t2, %t3
    %t5 = convert trunc i32 i64 %t4
    %t6 = cmp ne i32 %t5, 0
    store typed i64 %t6, $lor__1
    jump ^lor_end_3

  block ^lor_short_2:
    store typed i64 1, $lor__1
    jump ^lor_end_3

  block ^lor_end_3:
    %t7 = load typed i64 $lor__1
    %t8 = convert trunc i32 i64 %t7
    return i32 %t8
}
