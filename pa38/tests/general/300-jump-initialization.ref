function @run(%value : i32) -> i32 [linkage=c, binding=strong] {
  slot $value : i32
  slot $result : i32
  slot $skipped : i32
  slot $other : i32

  block ^entry:
    store typed i32 %value, $value
    store typed i32 0, $result
    %t1 = load typed i32 $value
    branch %t1, ^if_then_1, ^if_else_2

  block ^if_then_1:
    jump ^goto_3

  block ^if_else_2:
    jump ^if_end_4

  block ^if_end_4:
    store typed i32 17, $skipped
    %t2 = load typed i32 $skipped
    store typed i32 %t2, $result
    jump ^goto_3

  block ^goto_3:
    %t3 = load typed i32 $value
    jump ^switch_dispatch_5

  block ^switch_dispatch_5:
    switch %t3, ^switch_default_8, 1:^switch_case_7

  block ^switch_case_7:
    store typed i32 23, $result
    jump ^switch_end_6

  block ^switch_default_8:
    %t4 = load typed i32 $result
    %t5 = binary add nowrap i32 %t4, 1
    store typed i32 %t5, $result
    jump ^switch_end_6

  block ^switch_end_6:
    %t6 = load typed i32 $result
    return i32 %t6
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $land__1 : i64

  block ^entry:
    %t1 = call i32 @run(1)
    %t2 = cmp eq i32 %t1, 23
    %t3 = convert trunc i32 i64 %t2
    branch %t3, ^land_rhs_1, ^land_short_2

  block ^land_rhs_1:
    %t4 = call i32 @run(0)
    %t5 = cmp eq i32 %t4, 18
    %t6 = convert trunc i32 i64 %t5
    %t7 = cmp ne i32 %t6, 0
    store typed i64 %t7, $land__1
    jump ^land_end_3

  block ^land_short_2:
    store typed i64 0, $land__1
    jump ^land_end_3

  block ^land_end_3:
    %t8 = load typed i64 $land__1
    %t9 = convert trunc i32 i64 %t8
    %t10 = cmp eq i32 %t9, 0
    %t11 = convert trunc i32 i64 %t10
    return i32 %t11
}
