global @s [storage=readonly, linkage=c, binding=internal] = {
  i8 0
}
global @word [storage=readonly, linkage=c, binding=internal] = {
  i8 0
}
global @tokens [storage=readonly, linkage=c, binding=internal] = {
  i8 49
  i8 32
  i8 43
  i8 32
  i8 50
  i8 0
}
global @values [linkage=c, binding=strong] = {
  i32 17
  i32 25
}

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $value : i32
  slot $value_other : i32
  slot $total : i32
  slot $lor__1 : i64
  slot $lor__2 : i64
  slot $lor__3 : i64
  slot $lor__4 : i64
  slot $lor__5 : i64
  slot $lor__6 : i64
  slot $lor__7 : i64
  slot $lor__8 : i64
  slot $lor__9 : i64
  slot $lor__10 : i64
  slot $lor__11 : i64
  slot $lor__12 : i64
  slot $lor__13 : i64

  block ^entry:
    store typed i32 2, $value
    store typed i32 3, $value_other
    store typed i32 5, $total
    %t1 = cmp ne i32 17, 17
    %t2 = convert trunc i32 i64 %t1
    branch %t2, ^lor_short_2, ^lor_rhs_1

  block ^lor_rhs_1:
    %t3 = cmp ne i32 25, 25
    %t4 = convert trunc i32 i64 %t3
    %t5 = cmp ne i32 %t4, 0
    store typed i64 %t5, $lor__1
    jump ^lor_end_3

  block ^lor_short_2:
    store typed i64 1, $lor__1
    jump ^lor_end_3

  block ^lor_end_3:
    %t6 = load typed i64 $lor__1
    branch %t6, ^lor_short_5, ^lor_rhs_4

  block ^lor_rhs_4:
    %t7 = cmp ne i32 42, 42
    %t8 = convert trunc i32 i64 %t7
    %t9 = cmp ne i32 %t8, 0
    store typed i64 %t9, $lor__2
    jump ^lor_end_6

  block ^lor_short_5:
    store typed i64 1, $lor__2
    jump ^lor_end_6

  block ^lor_end_6:
    %t10 = load typed i64 $lor__2
    branch %t10, ^lor_short_8, ^lor_rhs_7

  block ^lor_rhs_7:
    %t11 = binary add nowrap i32 17, 25
    %t12 = cmp ne i32 %t11, 42
    %t13 = convert trunc i32 i64 %t12
    %t14 = cmp ne i32 %t13, 0
    store typed i64 %t14, $lor__3
    jump ^lor_end_9

  block ^lor_short_8:
    store typed i64 1, $lor__3
    jump ^lor_end_9

  block ^lor_end_9:
    %t15 = load typed i64 $lor__3
    branch %t15, ^lor_short_11, ^lor_rhs_10

  block ^lor_rhs_10:
    %t16 = const i64 1
    %t17 = convert sext i64 i32 1
    %t18 = cmp ne i64 %t16, %t17
    %t19 = convert trunc i32 i64 %t18
    %t20 = cmp ne i32 %t19, 0
    store typed i64 %t20, $lor__4
    jump ^lor_end_12

  block ^lor_short_11:
    store typed i64 1, $lor__4
    jump ^lor_end_12

  block ^lor_end_12:
    %t21 = load typed i64 $lor__4
    branch %t21, ^lor_short_14, ^lor_rhs_13

  block ^lor_rhs_13:
    %t22 = const i64 1
    %t23 = convert sext i64 i32 1
    %t24 = cmp ne i64 %t22, %t23
    %t25 = convert trunc i32 i64 %t24
    %t26 = cmp ne i32 %t25, 0
    store typed i64 %t26, $lor__5
    jump ^lor_end_15

  block ^lor_short_14:
    store typed i64 1, $lor__5
    jump ^lor_end_15

  block ^lor_end_15:
    %t27 = load typed i64 $lor__5
    branch %t27, ^lor_short_17, ^lor_rhs_16

  block ^lor_rhs_16:
    %t28 = const i64 6
    %t29 = convert sext i64 i32 6
    %t30 = cmp ne i64 %t28, %t29
    %t31 = convert trunc i32 i64 %t30
    %t32 = cmp ne i32 %t31, 0
    store typed i64 %t32, $lor__6
    jump ^lor_end_18

  block ^lor_short_17:
    store typed i64 1, $lor__6
    jump ^lor_end_18

  block ^lor_end_18:
    %t33 = load typed i64 $lor__6
    branch %t33, ^lor_short_20, ^lor_rhs_19

  block ^lor_rhs_19:
    %t34 = addr @tokens
    %t35 = index inbounds i8 [projection=array_element] %t34, 1
    %t36 = load i8 %t35
    %t37 = convert sext i32 i8 %t36
    %t38 = cmp ne i32 %t37, 32
    %t39 = convert trunc i32 i64 %t38
    %t40 = cmp ne i32 %t39, 0
    store typed i64 %t40, $lor__7
    jump ^lor_end_21

  block ^lor_short_20:
    store typed i64 1, $lor__7
    jump ^lor_end_21

  block ^lor_end_21:
    %t41 = load typed i64 $lor__7
    branch %t41, ^lor_short_23, ^lor_rhs_22

  block ^lor_rhs_22:
    %t42 = addr @tokens
    %t43 = index inbounds i8 [projection=array_element] %t42, 4
    %t44 = load i8 %t43
    %t45 = convert sext i32 i8 %t44
    %t46 = cmp ne i32 %t45, 50
    %t47 = convert trunc i32 i64 %t46
    %t48 = cmp ne i32 %t47, 0
    store typed i64 %t48, $lor__8
    jump ^lor_end_24

  block ^lor_short_23:
    store typed i64 1, $lor__8
    jump ^lor_end_24

  block ^lor_end_24:
    %t49 = load typed i64 $lor__8
    branch %t49, ^lor_short_26, ^lor_rhs_25

  block ^lor_rhs_25:
    %t50 = load typed i32 $value
    %t51 = cmp ne i32 %t50, 2
    %t52 = convert trunc i32 i64 %t51
    %t53 = cmp ne i32 %t52, 0
    store typed i64 %t53, $lor__9
    jump ^lor_end_27

  block ^lor_short_26:
    store typed i64 1, $lor__9
    jump ^lor_end_27

  block ^lor_end_27:
    %t54 = load typed i64 $lor__9
    branch %t54, ^lor_short_29, ^lor_rhs_28

  block ^lor_rhs_28:
    %t55 = load typed i32 $value_other
    %t56 = cmp ne i32 %t55, 3
    %t57 = convert trunc i32 i64 %t56
    %t58 = cmp ne i32 %t57, 0
    store typed i64 %t58, $lor__10
    jump ^lor_end_30

  block ^lor_short_29:
    store typed i64 1, $lor__10
    jump ^lor_end_30

  block ^lor_end_30:
    %t59 = load typed i64 $lor__10
    branch %t59, ^lor_short_32, ^lor_rhs_31

  block ^lor_rhs_31:
    %t60 = load typed i32 $total
    %t61 = load typed i32 $total
    %t62 = cmp ne i32 %t60, %t61
    %t63 = convert trunc i32 i64 %t62
    %t64 = cmp ne i32 %t63, 0
    store typed i64 %t64, $lor__11
    jump ^lor_end_33

  block ^lor_short_32:
    store typed i64 1, $lor__11
    jump ^lor_end_33

  block ^lor_end_33:
    %t65 = load typed i64 $lor__11
    branch %t65, ^lor_short_35, ^lor_rhs_34

  block ^lor_rhs_34:
    %t66 = const i64 8
    %t67 = const i64 4
    %t68 = convert sext i64 i32 2
    %t69 = binary mul i64 %t68, %t67
    %t70 = cmp ne i64 %t66, %t69
    %t71 = convert trunc i32 i64 %t70
    %t72 = cmp ne i32 %t71, 0
    store typed i64 %t72, $lor__12
    jump ^lor_end_36

  block ^lor_short_35:
    store typed i64 1, $lor__12
    jump ^lor_end_36

  block ^lor_end_36:
    %t73 = load typed i64 $lor__12
    branch %t73, ^lor_short_38, ^lor_rhs_37

  block ^lor_rhs_37:
    %t74 = addr @values
    %t75 = index inbounds i32 [projection=array_element] %t74, 0
    %t76 = load typed i32 %t75
    %t77 = addr @values
    %t78 = index inbounds i32 [projection=array_element] %t77, 1
    %t79 = load typed i32 %t78
    %t80 = binary add nowrap i32 %t76, %t79
    %t81 = cmp ne i32 %t80, 42
    %t82 = convert trunc i32 i64 %t81
    %t83 = cmp ne i32 %t82, 0
    store typed i64 %t83, $lor__13
    jump ^lor_end_39

  block ^lor_short_38:
    store typed i64 1, $lor__13
    jump ^lor_end_39

  block ^lor_end_39:
    %t84 = load typed i64 $lor__13
    %t85 = convert trunc i32 i64 %t84
    return i32 %t85
}
