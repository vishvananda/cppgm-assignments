function @regular(%a : f64, %b : f64) -> i32 [linkage=c, binding=internal] {
  slot $a : f64
  slot $b : f64

  block ^entry:
    store typed f64 %a, $a
    store typed f64 %b, $b
    return i32 1
}
function @binary64(%a : f64, %b : f64) -> i32 [linkage=c, binding=internal] {
  slot $a : f64
  slot $b : f64

  block ^entry:
    store typed f64 %a, $a
    store typed f64 %b, $b
    return i32 2
}
function @extended(%a : f64, %b : f64) -> i32 [linkage=c, binding=internal] {
  slot $a : f64
  slot $b : f64

  block ^entry:
    store typed f64 %a, $a
    store typed f64 %b, $b
    return i32 3
}
function @imaginary_single(%a : obj<8x4>) -> i32 [linkage=c, binding=internal] {
  slot $a : obj<8x4>

  block ^entry:
    store obj<8x4> %a, $a
    return i32 4
}
function @imaginary_double(%a : obj<16x8>) -> i32 [linkage=c, binding=internal] {
  slot $a : obj<16x8>

  block ^entry:
    store obj<16x8> %a, $a
    return i32 5
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $lor__1 : i64
  slot $lor__2 : i64
  slot $lor__3 : i64
  slot $complex__4 : obj<8x4>
  slot $complex__5 : obj<8x4>
  slot $complex__6 : obj<16x8>

  block ^entry:
    %t1 = convert sitofp f64 i32 1
    %t2 = convert sitofp f64 i32 2
    %t3 = call i32 @extended(%t1, %t2)
    %t4 = cmp ne i32 %t3, 3
    %t5 = convert trunc i32 i64 %t4
    branch %t5, ^lor_short_2, ^lor_rhs_1

  block ^lor_rhs_1:
    %t6 = convert sitofp f64 i32 2
    %t7 = call i32 @regular(1.0, %t6)
    %t8 = cmp ne i32 %t7, 1
    %t9 = convert trunc i32 i64 %t8
    %t10 = cmp ne i32 %t9, 0
    store typed i64 %t10, $lor__1
    jump ^lor_end_3

  block ^lor_short_2:
    store typed i64 1, $lor__1
    jump ^lor_end_3

  block ^lor_end_3:
    %t11 = load typed i64 $lor__1
    branch %t11, ^lor_short_5, ^lor_rhs_4

  block ^lor_rhs_4:
    %t12 = convert sitofp f64 i32 1
    %t13 = convert sitofp f64 i32 2
    %t14 = call i32 @binary64(%t12, %t13)
    %t15 = cmp ne i32 %t14, 2
    %t16 = convert trunc i32 i64 %t15
    %t17 = cmp ne i32 %t16, 0
    store typed i64 %t17, $lor__2
    jump ^lor_end_6

  block ^lor_short_5:
    store typed i64 1, $lor__2
    jump ^lor_end_6

  block ^lor_end_6:
    %t18 = load typed i64 $lor__2
    branch %t18, ^lor_short_8, ^lor_rhs_7

  block ^lor_rhs_7:
    %t19 = addr $complex__4
    store typed i32 0, %t19
    %t20 = index i8 [projection=field] %t19, 4
    store typed i32 3, %t20
    %t21 = load obj<8x4> $complex__4
    store obj<8x4> %t21, $complex__5
    %t22 = addr $complex__5
    %t23 = load typed i32 %t22
    %t24 = index i8 [projection=field] %t22, 4
    %t25 = load typed i32 %t24
    %t26 = convert sitofp f64 i32 %t25
    %t27 = convert sitofp f64 i32 %t23
    %t28 = addr $complex__6
    store typed f64 %t27, %t28
    %t29 = index i8 [projection=field] %t28, 8
    store typed f64 %t26, %t29
    %t30 = load obj<16x8> $complex__6
    %t31 = call i32 @imaginary_double(%t30)
    %t32 = cmp ne i32 %t31, 5
    %t33 = convert trunc i32 i64 %t32
    %t34 = cmp ne i32 %t33, 0
    store typed i64 %t34, $lor__3
    jump ^lor_end_9

  block ^lor_short_8:
    store typed i64 1, $lor__3
    jump ^lor_end_9

  block ^lor_end_9:
    %t35 = load typed i64 $lor__3
    %t36 = convert trunc i32 i64 %t35
    return i32 %t36
}
