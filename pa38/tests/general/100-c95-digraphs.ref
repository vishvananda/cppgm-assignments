global @__constexpr_template__1 [storage=readonly, binding=internal] = {
  i32 5
  i32 8
}

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $values : obj<8x4>

  block ^entry:
    %t1 = addr $values
    copyobj 8x4 @__constexpr_template__1, %t1
    %t2 = addr $values
    %t3 = index inbounds i32 [projection=array_element] %t2, 1
    %t4 = load typed i32 %t3
    %t5 = cmp ne i32 %t4, 8
    %t6 = convert trunc i32 i64 %t5
    return i32 %t6
}
