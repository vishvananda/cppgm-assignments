global @observed : i32 [linkage=c, binding=strong] = zero

function @with_array(%n : i32) -> i32 [linkage=c, binding=strong] {
  slot $n : i32
  slot $tmpobj__1 : i64

  block ^entry:
    store typed i32 %n, $n
    %t1 = load typed i32 $n
    %t2 = convert sext i64 i32 %t1
    %t3 = binary mul i64 %t2, 1
    store typed i64 %t3, $tmpobj__1
    %t4 = stack_save
    %t5 = stack_alloc %t3
    %t6 = load typed i32 $n
    %t7 = binary sub nowrap i32 %t6, 1
    %t8 = index inbounds i8 [projection=array_element] %t5, %t7
    store volatile i8 19, %t8
    %t9 = load typed i32 $n
    call void @observe(%t9)
    %t10 = load typed i32 $n
    %t11 = binary sub nowrap i32 %t10, 1
    %t12 = index inbounds i8 [projection=array_element] %t5, %t11
    %t13 = load volatile i8 %t12
    %t14 = convert sext i32 i8 %t13
    stack_restore %t4
    return i32 %t14
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $lor__1 : i64

  block ^entry:
    %t1 = call i32 @with_array(3)
    %t2 = cmp ne i32 %t1, 19
    %t3 = convert trunc i32 i64 %t2
    branch %t3, ^lor_short_2, ^lor_rhs_1

  block ^lor_rhs_1:
    %t4 = load volatile i32 @observed
    %t5 = cmp ne i32 %t4, 3
    %t6 = convert trunc i32 i64 %t5
    %t7 = cmp ne i32 %t6, 0
    store typed i64 %t7, $lor__1
    jump ^lor_end_3

  block ^lor_short_2:
    store typed i64 1, $lor__1
    jump ^lor_end_3

  block ^lor_end_3:
    %t8 = load typed i64 $lor__1
    %t9 = convert trunc i32 i64 %t8
    return i32 %t9
}
function @observe(%n : i32) -> void [linkage=c, binding=strong] {
  slot $n : i32

  block ^entry:
    store typed i32 %n, $n
    %t1 = load typed i32 $n
    store volatile i32 %t1, @observed
    return void
}
