    store typed i32 %t11, $sum
    %t12 = const i64 17
    %t13 = convert sext i64 i32 17
    %t14 = cmp ne i64 %t12, %t13
    %t15 = convert trunc i32 i64 %t14
    branch %t15, ^lor_short_2, ^lor_rhs_1

  block ^lor_rhs_1:
    %t16 = const i64 8
    %t17 = const i64 8
    %t18 = cmp ne i64 %t16, %t17
    %t19 = convert trunc i32 i64 %t18
    %t20 = cmp ne i32 %t19, 0
    store typed i64 %t20, $lor__3
    jump ^lor_end_3

  block ^lor_short_2:
    store typed i64 1, $lor__3
    jump ^lor_end_3

  block ^lor_end_3:
    %t21 = load typed i64 $lor__3
    branch %t21, ^lor_short_5, ^lor_rhs_4

  block ^lor_rhs_4:
    %t22 = load typed i32 $sum
    %t23 = cmp ne i32 %t22, 42
    %t24 = convert trunc i32 i64 %t23
    %t25 = cmp ne i32 %t24, 0
    store typed i64 %t25, $lor__4
    jump ^lor_end_6

  block ^lor_short_5:
    store typed i64 1, $lor__4
