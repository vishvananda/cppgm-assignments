declare function @fesetround(%arg0 : i32) -> i32 [linkage=c, binding=strong]
declare function @feclearexcept(%arg0 : i32) -> i32 [linkage=c, binding=strong]
declare function @fetestexcept(%arg0 : i32) -> i32 [linkage=c, binding=strong]

global @static_tie : f64 [linkage=c, binding=internal] = 1

function @add_tie() -> f64 [linkage=c, binding=strong] {
  block ^entry:
    %t1 = fenv_binary add f64 1, 1.1102230246251565404e-16
    return f64 %t1
}
function @raise_inexact() -> void [linkage=c, binding=strong] {
  block ^entry:
    %t1 = fenv_binary add f64 1, 1.1102230246251565404e-16
    return void
}
function @ordinary(%value : f64) -> f64 [linkage=c, binding=strong] {
  slot $value : f64

  block ^entry:
    store typed f64 %value, $value
    %t1 = load typed f64 $value
    %t2 = binary add f64 %t1, 16
    return f64 %t2
}
function @nested_scope(%value : f64) -> f64 [linkage=c, binding=strong] {
  slot $value : f64

  block ^entry:
    store typed f64 %value, $value
    %t1 = load typed f64 $value
    %t2 = fenv_binary add f64 %t1, 1
    store typed f64 %t2, $value
    %t3 = load typed f64 $value
    %t4 = binary add f64 %t3, 2
    store typed f64 %t4, $value
    %t5 = load typed f64 $value
    %t6 = fenv_binary add f64 %t5, 4
    store typed f64 %t6, $value
    %t7 = load typed f64 $value
    %t8 = binary add f64 %t7, 8
    return f64 %t8
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $above : f64
  slot $below : f64

  block ^entry:
    %t1 = load typed f64 @static_tie
    %t2 = fenv_cmp ne f64 %t1, 1
    %t3 = convert trunc i32 i64 %t2
    branch %t3, ^if_then_1, ^lor_rhs_4

  block ^lor_rhs_4:
    %t4 = call f64 @ordinary(0.0)
    %t5 = fenv_cmp ne f64 %t4, 16
    %t6 = convert trunc i32 i64 %t5
    branch %t6, ^if_then_1, ^lor_rhs_3

  block ^lor_rhs_3:
    %t7 = call f64 @nested_scope(0.0)
    %t8 = fenv_cmp ne f64 %t7, 15
    %t9 = convert trunc i32 i64 %t8
    branch %t9, ^if_then_1, ^if_else_2

  block ^if_then_1:
    return i32 1

  block ^if_else_2:
    jump ^if_end_5

  block ^if_end_5:
    %t10 = call i32 @fesetround(2048)
    %t11 = cmp ne i32 %t10, 0
    %t12 = convert trunc i32 i64 %t11
    branch %t12, ^if_then_6, ^if_else_7

  block ^if_then_6:
    return i32 2

  block ^if_else_7:
    jump ^if_end_8

  block ^if_end_8:
    %t13 = call f64 @add_tie()
    store volatile f64 %t13, $above
    %t14 = call i32 @fesetround(1024)
    %t15 = cmp ne i32 %t14, 0
    %t16 = convert trunc i32 i64 %t15
    branch %t16, ^if_then_9, ^if_else_10

  block ^if_then_9:
    return i32 3

  block ^if_else_10:
    jump ^if_end_11

  block ^if_end_11:
    %t17 = call f64 @add_tie()
    store volatile f64 %t17, $below
    %t18 = call i32 @fesetround(0)
    %t19 = cmp ne i32 %t18, 0
    %t20 = convert trunc i32 i64 %t19
    branch %t20, ^if_then_12, ^if_else_13

  block ^if_then_12:
    return i32 4

  block ^if_else_13:
    jump ^if_end_14

  block ^if_end_14:
    %t21 = load volatile f64 $above
    %t22 = fenv_cmp ne f64 %t21, 1.000000000000000222
    %t23 = convert trunc i32 i64 %t22
    branch %t23, ^if_then_15, ^lor_rhs_17

  block ^lor_rhs_17:
    %t24 = load volatile f64 $below
    %t25 = fenv_cmp ne f64 %t24, 1
    %t26 = convert trunc i32 i64 %t25
    branch %t26, ^if_then_15, ^if_else_16

  block ^if_then_15:
    return i32 5

  block ^if_else_16:
    jump ^if_end_18

  block ^if_end_18:
    %t27 = binary or i32 32, 4
    %t28 = binary or i32 %t27, 16
    %t29 = binary or i32 %t28, 8
    %t30 = binary or i32 %t29, 1
    %t31 = call i32 @feclearexcept(%t30)
    %t32 = cmp ne i32 %t31, 0
    %t33 = convert trunc i32 i64 %t32
    branch %t33, ^if_then_19, ^if_else_20

  block ^if_then_19:
    return i32 6

  block ^if_else_20:
    jump ^if_end_21

  block ^if_end_21:
    call void @raise_inexact()
    %t34 = call i32 @fetestexcept(32)
    %t35 = binary and i32 %t34, 32
    %t36 = cmp eq i32 %t35, 0
    %t37 = convert trunc i32 i64 %t36
    return i32 %t37
}
