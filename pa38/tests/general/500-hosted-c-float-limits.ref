global @largest : f64 [linkage=c, binding=internal] = 1.7976931348623157081e+308
global @smallest : f64 [linkage=c, binding=internal] = 2.2250738585072013831e-308

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $land__1 : i64
  slot $land__2 : i64

  block ^entry:
    %t1 = load typed f64 @largest
    %t2 = cmp gt f64 %t1, 1.0000000000000000525e+300
    %t3 = convert trunc i32 i64 %t2
    branch %t3, ^land_rhs_1, ^land_short_2

  block ^land_rhs_1:
    %t4 = load typed f64 @smallest
    %t5 = cmp gt f64 %t4, 0
    %t6 = convert trunc i32 i64 %t5
    %t7 = cmp ne i32 %t6, 0
    store typed i64 %t7, $land__1
    jump ^land_end_3

  block ^land_short_2:
    store typed i64 0, $land__1
    jump ^land_end_3

  block ^land_end_3:
    %t8 = load typed i64 $land__1
    branch %t8, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t9 = load typed f64 @smallest
    %t10 = cmp lt f64 %t9, 1.0000000000000000251e-300
    %t11 = convert trunc i32 i64 %t10
    %t12 = cmp ne i32 %t11, 0
    store typed i64 %t12, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store typed i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t13 = load typed i64 $land__2
    %t14 = convert trunc i32 i64 %t13
    %t15 = cmp eq i32 %t14, 0
    %t16 = convert trunc i32 i64 %t15
    return i32 %t16
}
