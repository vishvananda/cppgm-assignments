function @different(%left : ptr, %right : ptr) -> i32 [linkage=c, binding=internal] {
  slot $left : ptr
  slot $right : ptr

  block ^entry:
    store typed ptr %left, $left
    store typed ptr %right, $right
    jump ^while_cond_1

  block ^while_cond_1:
    %t1 = load typed ptr $left
    %t2 = load i8 %t1
    branch %t2, ^land_rhs_4, ^while_end_3

  block ^land_rhs_4:
    %t3 = load typed ptr $left
    %t4 = load i8 %t3
    %t5 = load typed ptr $right
    %t6 = load i8 %t5
    %t7 = convert sext i32 i8 %t4
    %t8 = convert sext i32 i8 %t6
    %t9 = cmp eq i32 %t7, %t8
    %t10 = convert trunc i32 i64 %t9
    branch %t10, ^while_body_2, ^while_end_3

  block ^while_body_2:
    %t11 = load typed ptr $left
    %t12 = index inbounds i8 %t11, 1
    store typed ptr %t12, $left
    %t13 = load typed ptr $right
    %t14 = index inbounds i8 %t13, 1
    store typed ptr %t14, $right
    jump ^while_cond_1

  block ^while_end_3:
    %t15 = load typed ptr $left
    %t16 = load i8 %t15
    %t17 = load typed ptr $right
    %t18 = load i8 %t17
    %t19 = convert sext i32 i8 %t16
    %t20 = convert sext i32 i8 %t18
    %t21 = cmp ne i32 %t19, %t20
    %t22 = convert trunc i32 i64 %t21
    return i32 %t22
}
