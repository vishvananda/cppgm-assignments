function @definition(%first : ptr, %second : ptr) -> i32 [linkage=c, binding=strong] {
  slot $first : ptr
  slot $second : ptr
  slot $object : obj<4x4>

  block ^entry:
    store typed ptr %first, $first
    store typed ptr %second, $second
    %t1 = addr $object
    %t2 = addr $object
    %t3 = index inbounds i8 [projection=field] %t2, 0
    store typed i32 4, %t3
    %t4 = addr $object
    %t5 = index inbounds i8 [projection=field] %t4, 0
    %t6 = load typed i32 %t5
    %t7 = load typed ptr $first
    %t8 = load typed ptr $second
    %t9 = cmp eq ptr %t7, %t8
    %t10 = convert trunc i32 i64 %t9
    %t11 = binary add nowrap i32 %t6, %t10
    return i32 %t11
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    %t1 = call i32 @definition(0, 0)
    %t2 = cmp ne i32 %t1, 5
    %t3 = convert trunc i32 i64 %t2
    return i32 %t3
}
