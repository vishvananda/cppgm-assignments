function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $outer : obj<8x4>
  slot $pointer : ptr
  slot $flag : u32
  slot $land__1 : i64

  block ^entry:
    %t1 = addr $outer
    %t2 = addr $outer
    %t3 = index inbounds i8 [projection=field] %t2, 0
    %t4 = index inbounds i8 [projection=field] %t3, 0
    store typed i32 17, %t4
    %t5 = addr $outer
    %t6 = index inbounds i8 [projection=field] %t5, 4
    store typed u32 1, %t6
    %t7 = addr $outer
    %t8 = index inbounds i8 [projection=field] %t7, 0
    store typed ptr %t8, $pointer
    store typed u32 1, $flag
    %t9 = load typed ptr $pointer
    %t10 = index inbounds i8 [projection=field] %t9, 0
    %t11 = load typed i32 %t10
    %t12 = cmp eq i32 %t11, 17
    %t13 = convert trunc i32 i64 %t12
    branch %t13, ^land_rhs_1, ^land_short_2

  block ^land_rhs_1:
    %t14 = addr $outer
    %t15 = index inbounds i8 [projection=field] %t14, 4
    %t16 = load typed u32 %t15
    %t17 = load typed u32 $flag
    %t18 = cmp eq u32 %t16, %t17
    %t19 = convert trunc i32 i64 %t18
    %t20 = cmp ne i32 %t19, 0
    store typed i64 %t20, $land__1
    jump ^land_end_3

  block ^land_short_2:
    store typed i64 0, $land__1
    jump ^land_end_3

  block ^land_end_3:
    %t21 = load typed i64 $land__1
    %t22 = convert trunc i32 i64 %t21
    %t23 = cmp eq i32 %t22, 0
    %t24 = convert trunc i32 i64 %t23
    return i32 %t24
}
