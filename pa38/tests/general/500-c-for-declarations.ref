function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $index : i32
  slot $result : i32
  slot $limit : obj<4x4>
  slot $index__shadow2 : i32
  slot $index__shadow3 : i32
  slot $cursor : ptr
  slot $item : obj<4x4>
  slot $callback : ptr
  slot $lor__1 : i64

  block ^entry:
    store typed i32 17, $index
    store typed i32 0, $result
    %t1 = addr $limit
    %t2 = addr $limit
    %t3 = index inbounds i8 [projection=field] %t2, 0
    store typed i32 3, %t3
    store typed i32 0, $index__shadow2
    jump ^for_cond_1

  block ^for_cond_1:
    %t4 = load typed i32 $index__shadow2
    %t5 = addr $limit
    %t6 = index inbounds i8 [projection=field] %t5, 0
    %t7 = load typed i32 %t6
    %t8 = cmp lt i32 %t4, %t7
    %t9 = convert trunc i32 i64 %t8
    branch %t9, ^for_body_2, ^for_end_4

  block ^for_body_2:
    %t10 = load typed i32 $index__shadow2
    %t11 = load typed i32 $result
    %t12 = binary add nowrap i32 %t11, %t10
    store typed i32 %t12, $result
    jump ^for_iter_3

  block ^for_iter_3:
    %t13 = load typed i32 $index__shadow2
    %t14 = binary add nowrap i32 %t13, 1
    store typed i32 %t14, $index__shadow2
    jump ^for_cond_1

  block ^for_end_4:
    store typed i32 1, $index__shadow3
    jump ^for_cond_5

  block ^for_cond_5:
    %t15 = load typed i32 $index__shadow3
    %t16 = addr $limit
    %t17 = index inbounds i8 [projection=field] %t16, 0
    %t18 = load typed i32 %t17
    %t19 = cmp le i32 %t15, %t18
    %t20 = convert trunc i32 i64 %t19
    branch %t20, ^for_body_6, ^for_end_8

  block ^for_body_6:
    %t21 = load typed i32 $index__shadow3
    %t22 = load typed i32 $result
    %t23 = binary add nowrap i32 %t22, %t21
    store typed i32 %t23, $result
    jump ^for_iter_7

  block ^for_iter_7:
    %t24 = load typed i32 $index__shadow3
    %t25 = binary add nowrap i32 %t24, 1
    store typed i32 %t25, $index__shadow3
    jump ^for_cond_5

  block ^for_end_8:
    %t26 = addr $limit
    store typed ptr %t26, $cursor
    jump ^for_cond_9

  block ^for_cond_9:
    %t27 = load typed ptr $cursor
    branch %t27, ^for_body_10, ^for_end_12

  block ^for_body_10:
    %t28 = load typed ptr $cursor
    %t29 = index inbounds i8 [projection=field] %t28, 0
    %t30 = load typed i32 %t29
    %t31 = load typed i32 $result
    %t32 = binary add nowrap i32 %t31, %t30
    store typed i32 %t32, $result
    jump ^for_iter_11

  block ^for_iter_11:
    store typed ptr 0, $cursor
    jump ^for_cond_9

  block ^for_end_12:
    %t33 = addr $item
    %t34 = addr $item
    %t35 = index inbounds i8 [projection=field] %t34, 0
    store typed i32 0, %t35
    jump ^for_cond_13

  block ^for_cond_13:
    %t36 = addr $item
    %t37 = index inbounds i8 [projection=field] %t36, 0
    %t38 = load typed i32 %t37
    %t39 = addr $limit
    %t40 = index inbounds i8 [projection=field] %t39, 0
    %t41 = load typed i32 %t40
    %t42 = cmp ne i32 %t38, %t41
    %t43 = convert trunc i32 i64 %t42
    branch %t43, ^for_body_14, ^for_end_16

  block ^for_body_14:
    %t44 = addr $item
    %t45 = index inbounds i8 [projection=field] %t44, 0
    %t46 = load typed i32 %t45
    %t47 = load typed i32 $result
    %t48 = binary add nowrap i32 %t47, %t46
    store typed i32 %t48, $result
    jump ^for_iter_15

  block ^for_iter_15:
    %t49 = addr $item
    %t50 = index inbounds i8 [projection=field] %t49, 0
    %t51 = load typed i32 %t50
    %t52 = binary add nowrap i32 %t51, 1
    store typed i32 %t52, %t50
    jump ^for_cond_13

  block ^for_end_16:
    store typed ptr 0, $callback
    jump ^for_cond_17

  block ^for_cond_17:
    %t53 = load typed ptr $callback
    branch %t53, ^for_body_18, ^for_end_20

  block ^for_body_18:
    return i32 2

  block ^for_iter_19:
    jump ^for_cond_17

  block ^for_end_20:
    %t54 = load typed i32 $result
    %t55 = cmp ne i32 %t54, 15
    %t56 = convert trunc i32 i64 %t55
    branch %t56, ^lor_short_22, ^lor_rhs_21

  block ^lor_rhs_21:
    %t57 = load typed i32 $index
    %t58 = cmp ne i32 %t57, 17
    %t59 = convert trunc i32 i64 %t58
    %t60 = cmp ne i32 %t59, 0
    store typed i64 %t60, $lor__1
    jump ^lor_end_23

  block ^lor_short_22:
    store typed i64 1, $lor__1
    jump ^lor_end_23

  block ^lor_end_23:
    %t61 = load typed i64 $lor__1
    %t62 = convert trunc i32 i64 %t61
    return i32 %t62
}
