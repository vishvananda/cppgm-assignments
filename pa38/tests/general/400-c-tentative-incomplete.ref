global @one : obj<4x4> [linkage=c, binding=strong] = {
  zero 4
}
global @later : obj<12x4> [linkage=c, binding=strong] = {
  zero 12
}
global @internal : obj<8x4> [linkage=c, binding=internal] = {
  zero 8
}
global @pending : obj<8x4> [linkage=c, binding=strong] = {
  zero 8
}

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $lor__1 : i64
  slot $lor__2 : i64
  slot $lor__3 : i64
  slot $lor__4 : i64

  block ^entry:
    %t1 = addr @one
    %t2 = index inbounds i32 [projection=array_element] %t1, 0
    %t3 = load typed i32 %t2
    branch %t3, ^lor_short_2, ^lor_rhs_1

  block ^lor_rhs_1:
    %t4 = addr @later
    %t5 = index inbounds i32 [projection=array_element] %t4, 2
    %t6 = load typed i32 %t5
    %t7 = cmp ne i32 %t6, 0
    store typed i64 %t7, $lor__1
    jump ^lor_end_3

  block ^lor_short_2:
    store typed i64 1, $lor__1
    jump ^lor_end_3

  block ^lor_end_3:
    %t8 = load typed i64 $lor__1
    branch %t8, ^lor_short_5, ^lor_rhs_4

  block ^lor_rhs_4:
    %t9 = addr @internal
    %t10 = index inbounds i32 [projection=array_element] %t9, 1
    %t11 = load typed i32 %t10
    %t12 = cmp ne i32 %t11, 0
    store typed i64 %t12, $lor__2
    jump ^lor_end_6

  block ^lor_short_5:
    store typed i64 1, $lor__2
    jump ^lor_end_6

  block ^lor_end_6:
    %t13 = load typed i64 $lor__2
    branch %t13, ^lor_short_8, ^lor_rhs_7

  block ^lor_rhs_7:
    %t14 = addr @pending
    %t15 = index inbounds i8 [projection=field] %t14, 0
    %t16 = load typed i32 %t15
    %t17 = cmp ne i32 %t16, 0
    store typed i64 %t17, $lor__3
    jump ^lor_end_9

  block ^lor_short_8:
    store typed i64 1, $lor__3
    jump ^lor_end_9

  block ^lor_end_9:
    %t18 = load typed i64 $lor__3
    branch %t18, ^lor_short_11, ^lor_rhs_10

  block ^lor_rhs_10:
    %t19 = addr @pending
    %t20 = index inbounds i8 [projection=field] %t19, 4
    %t21 = load typed i32 %t20
    %t22 = cmp ne i32 %t21, 0
    store typed i64 %t22, $lor__4
    jump ^lor_end_12

  block ^lor_short_11:
    store typed i64 1, $lor__4
    jump ^lor_end_12

  block ^lor_end_12:
    %t23 = load typed i64 $lor__4
    %t24 = convert trunc i32 i64 %t23
    return i32 %t24
}
