global @leaf : obj<48x16> [linkage=c, binding=internal] = {
  i32 4
  zero 12
  i32 6
  u32 3
  zero 8
  i32 5
  zero 12
}

function @inspect(%side : obj<4x4>) -> i32 [linkage=c, binding=internal] {
  slot $side : obj<4x4>

  block ^entry:
    %t1 = addr $side
    copyobj 4x4 %side, %t1
    %t2 = addr $side
    %t3 = index inbounds i8 [projection=field] %t2, 0
    %t4 = load i32 %t3
    return i32 %t4
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $first : obj<48x16>
  slot $side : obj<4x4>
  slot $argobj__1 : obj<4x4>

  block ^entry:
    %t1 = addr $first
    %t2 = addr $first
    %t3 = index inbounds i8 [projection=field] %t2, 0
    store typed i32 0, %t3
    %t4 = addr @leaf
    %t5 = addr $first
    %t6 = index inbounds i8 [projection=field] %t5, 8
    store typed ptr %t4, %t6
    %t7 = addr $first
    %t8 = index inbounds i8 [projection=field] %t7, 16
    %t9 = index inbounds i8 [projection=field] %t8, 0
    %t10 = index inbounds i8 [projection=field] %t9, 0
    store i32 0, %t10
    %t11 = addr $first
    %t12 = index inbounds i8 [projection=field] %t11, 20
    %t13 = binary and u32 7, 0
    store u32 %t13, %t12
    %t14 = addr $first
    %t15 = index inbounds i8 [projection=field] %t14, 32
    store typed i32 0, %t15
    %t16 = addr $side
    %t17 = addr $first
    %t18 = index inbounds i8 [projection=field] %t17, 8
    %t19 = load typed ptr %t18
    %t20 = index inbounds i8 [projection=field] %t19, 0
    %t21 = load typed i32 %t20
    %t22 = addr $side
    %t23 = index inbounds i8 [projection=field] %t22, 0
    store i32 %t21, %t23
    %t24 = addr $argobj__1
    %t25 = addr $side
    copyobj 4x4 %t25, %t24
    %t26 = call i32 @inspect($argobj__1)
    %t27 = addr $first
    %t28 = index inbounds i8 [projection=field] %t27, 8
    %t29 = load typed ptr %t28
    %t30 = index inbounds i8 [projection=field] %t29, 16
    %t31 = load i32 %t30
    %t32 = binary add nowrap i32 %t26, %t31
    %t33 = addr $first
    %t34 = index inbounds i8 [projection=field] %t33, 8
    %t35 = load typed ptr %t34
    %t36 = index inbounds i8 [projection=field] %t35, 20
    %t37 = load i32 %t36
    %t38 = binary and i32 %t37, 7
    %t39 = copy u32 %t38
    %t40 = copy i32 %t39
    %t41 = binary add nowrap i32 %t32, %t40
    %t42 = addr $first
    %t43 = index inbounds i8 [projection=field] %t42, 8
    %t44 = load typed ptr %t43
    %t45 = index inbounds i8 [projection=field] %t44, 32
    %t46 = load typed i32 %t45
    %t47 = binary add nowrap i32 %t41, %t46
    %t48 = cmp ne i32 %t47, 18
    %t49 = convert trunc i32 i64 %t48
    return i32 %t49
}
