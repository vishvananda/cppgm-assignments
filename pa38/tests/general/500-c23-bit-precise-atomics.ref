global @value : u16 [linkage=c, binding=internal] = 511

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $atomic_expected__1 : u16
  slot $atomic_expected__2 : u16
  slot $atomic_expected__3 : u16
  slot $atomic_expected__4 : u16
  slot $atomic_expected__5 : u16

  block ^entry:
    %t1 = atomic_load u16 @value, 0
    store typed u16 %t1, $atomic_expected__1
    jump ^atomic_retry_4

  block ^atomic_retry_4:
    %t2 = load typed u16 $atomic_expected__1
    %t3 = binary and u16 %t2, 511
    %t4 = binary add u16 %t3, 1
    %t5 = binary and u16 %t4, 511
    %t6 = addr $atomic_expected__1
    %t7 = atomic_compare_exchange u16 @value, %t6, %t5, 5, 5
    branch %t7, ^atomic_done_5, ^atomic_retry_4

  block ^atomic_done_5:
    %t8 = convert zext i32 u16 %t3
    %t9 = cmp ne i32 %t8, 511
    %t10 = convert trunc i32 i64 %t9
    branch %t10, ^if_then_1, ^lor_rhs_3

  block ^lor_rhs_3:
    %t11 = atomic_load u16 @value, 5
    %t12 = binary and u16 %t11, 511
    %t13 = convert zext i32 u16 %t12
    %t14 = cmp ne i32 %t13, 0
    %t15 = convert trunc i32 i64 %t14
    branch %t15, ^if_then_1, ^if_else_2

  block ^if_then_1:
