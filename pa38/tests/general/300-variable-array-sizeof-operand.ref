function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $n : i32
  slot $calls : i32
  slot $tmpobj__1 : i64
  slot $row : i64
  slot $element : i64
  slot $land__2 : i64
  slot $land__3 : i64

  block ^entry:
    store typed i32 3, $n
    store typed i32 0, $calls
    %t1 = load typed i32 $n
    %t2 = convert sext i64 i32 %t1
    %t3 = binary mul i64 %t2, 4
    store typed i64 %t3, $tmpobj__1
    %t4 = load typed i64 $tmpobj__1
    %t5 = stack_save
    %t6 = stack_alloc %t4
    %t7 = addr $calls
    %t8 = call i32 @effects(%t7)
    %t9 = convert sext i64 i32 %t8
    %t10 = load typed i64 $tmpobj__1
    %t11 = copy i64 %t10
    %t12 = binary mul i64 %t9, %t11
    %t13 = index inbounds i8 [projection=array_element] %t6, %t12
    %t14 = load typed i64 $tmpobj__1
    store typed i64 %t14, $row
    %t15 = const i64 4
    store typed i64 %t15, $element
    %t16 = load typed i64 $row
    %t17 = const i64 4
    %t18 = convert sext i64 i32 3
    %t19 = binary mul i64 %t18, %t17
    %t20 = cmp eq i64 %t16, %t19
    %t21 = convert trunc i32 i64 %t20
    branch %t21, ^land_rhs_1, ^land_short_2

  block ^land_rhs_1:
    %t22 = load typed i64 $element
    %t23 = const i64 4
    %t24 = cmp eq i64 %t22, %t23
    %t25 = convert trunc i32 i64 %t24
    %t26 = cmp ne i32 %t25, 0
    store typed i64 %t26, $land__2
    jump ^land_end_3

  block ^land_short_2:
    store typed i64 0, $land__2
    jump ^land_end_3

  block ^land_end_3:
    %t27 = load typed i64 $land__2
    branch %t27, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t28 = load typed i32 $calls
    %t29 = cmp eq i32 %t28, 1
    %t30 = convert trunc i32 i64 %t29
    %t31 = cmp ne i32 %t30, 0
    store typed i64 %t31, $land__3
    jump ^land_end_6

  block ^land_short_5:
    store typed i64 0, $land__3
    jump ^land_end_6

  block ^land_end_6:
    %t32 = load typed i64 $land__3
    %t33 = convert trunc i32 i64 %t32
    %t34 = cmp eq i32 %t33, 0
    %t35 = convert trunc i32 i64 %t34
    stack_restore %t5
    return i32 %t35
}
function @effects(%n : ptr) -> i32 [linkage=c, binding=internal, inline_hint=yes] {
  slot $n : ptr

  block ^entry:
    store typed ptr %n, $n
    %t1 = load typed ptr $n
    %t2 = load typed i32 %t1
    %t3 = binary add nowrap i32 %t2, 1
    store typed i32 %t3, %t1
    return i32 0
}
