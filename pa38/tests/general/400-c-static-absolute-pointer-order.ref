global @signed_order : i32 [linkage=c, binding=internal] = 0
global @increasing : i32 [linkage=c, binding=internal] = 1
global @zero_first : i32 [linkage=c, binding=internal] = 1

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $lor__1 : i64
  slot $lor__2 : i64

  block ^entry:
    %t1 = load typed i32 @signed_order
    branch %t1, ^lor_short_2, ^lor_rhs_1

  block ^lor_rhs_1:
    %t2 = load typed i32 @increasing
    %t3 = cmp eq i32 %t2, 0
    %t4 = convert trunc i32 i64 %t3
    %t5 = cmp ne i32 %t4, 0
    store typed i64 %t5, $lor__1
    jump ^lor_end_3

  block ^lor_short_2:
    store typed i64 1, $lor__1
    jump ^lor_end_3

  block ^lor_end_3:
    %t6 = load typed i64 $lor__1
    branch %t6, ^lor_short_5, ^lor_rhs_4

  block ^lor_rhs_4:
    %t7 = load typed i32 @zero_first
    %t8 = cmp eq i32 %t7, 0
    %t9 = convert trunc i32 i64 %t8
    %t10 = cmp ne i32 %t9, 0
    store typed i64 %t10, $lor__2
    jump ^lor_end_6

  block ^lor_short_5:
    store typed i64 1, $lor__2
    jump ^lor_end_6

  block ^lor_end_6:
    %t11 = load typed i64 $lor__2
    %t12 = convert trunc i32 i64 %t11
    return i32 %t12
}
