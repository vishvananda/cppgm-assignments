global @effects : i32 [linkage=c, binding=internal] = zero

function @scalar(%returns_value : i32) -> i32 [linkage=c, binding=internal] {
  slot $returns_value : i32

  block ^entry:
    store typed i32 %returns_value, $returns_value
    %t1 = load volatile i32 @effects
    %t2 = binary add nowrap i32 %t1, 1
    store volatile i32 %t2, @effects
    %t3 = load typed i32 $returns_value
    branch %t3, ^if_then_1, ^if_else_2

  block ^if_then_1:
    return i32 7

  block ^if_else_2:
    jump ^if_end_3

  block ^if_end_3:
    %t4 = load volatile i32 @effects
    %t5 = binary add nowrap i32 %t4, 2
    store volatile i32 %t5, @effects
    return i32 0
}
function @aggregate(%ret : ptr [pass=indirect_result, alias=exclusive_result, object_bytes=32], %returns_value : i32) -> void [linkage=c, binding=internal] {
  slot $returns_value : i32

  block ^entry:
    store typed i32 %returns_value, $returns_value
    %t1 = index inbounds i8 [projection=field] %ret, 0
    %t2 = index i32 [projection=array_element] %t1, 0
    store typed i32 2, %t2
    %t3 = index inbounds i8 [projection=field] %ret, 0
    %t4 = index i32 [projection=array_element] %t3, 1
    store typed i32 3, %t4
    %t5 = index inbounds i8 [projection=field] %ret, 0
    %t6 = index i32 [projection=array_element] %t5, 2
    store typed i32 5, %t6
    %t7 = index inbounds i8 [projection=field] %ret, 0
    %t8 = index i32 [projection=array_element] %t7, 3
    store typed i32 7, %t8
    %t9 = index inbounds i8 [projection=field] %ret, 0
    %t10 = index i32 [projection=array_element] %t9, 4
    store typed i32 11, %t10
    %t11 = index inbounds i8 [projection=field] %ret, 0
    %t12 = index i32 [projection=array_element] %t11, 5
    store typed i32 13, %t12
    %t13 = index inbounds i8 [projection=field] %ret, 0
    %t14 = index i32 [projection=array_element] %t13, 6
    store typed i32 17, %t14
    %t15 = index inbounds i8 [projection=field] %ret, 0
    %t16 = index i32 [projection=array_element] %t15, 7
    store typed i32 19, %t16
    %t17 = load volatile i32 @effects
    %t18 = binary add nowrap i32 %t17, 4
    store volatile i32 %t18, @effects
    %t19 = load typed i32 $returns_value
    branch %t19, ^if_then_1, ^if_else_2

  block ^if_then_1:
    return void

  block ^if_else_2:
    jump ^if_end_3

  block ^if_end_3:
    %t20 = load volatile i32 @effects
    %t21 = binary add nowrap i32 %t20, 8
    store volatile i32 %t21, @effects
    return void
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $discard : i32
  slot $number : i32
  slot $record : obj<32x4>
  slot $discard__1 : obj<32x4>
  slot $tmpobj__2 : obj<32x4>
  slot $lor__3 : i64
  slot $lor__4 : i64

  block ^entry:
    store volatile i32 0, $discard
    %t1 = addr $record
    store volatile i32 0, @effects
    %t2 = load volatile i32 $discard
    %t3 = call i32 @scalar(%t2)
    %t4 = addr $discard__1
    %t5 = load volatile i32 $discard
    call void @aggregate(%t4, %t5)
    %t6 = load volatile i32 @effects
    %t7 = cmp ne i32 %t6, 15
    %t8 = convert trunc i32 i64 %t7
    branch %t8, ^if_then_1, ^if_else_2

  block ^if_then_1:
    return i32 1

  block ^if_else_2:
    jump ^if_end_3

  block ^if_end_3:
    %t9 = call i32 @scalar(1)
    store typed i32 %t9, $number
    %t10 = addr $tmpobj__2
    call void @aggregate(%t10, 1)
    %t11 = load obj<32x4> %t10
    store obj<32x4> %t11, $record
    %t12 = load typed i32 $number
    %t13 = cmp ne i32 %t12, 7
    %t14 = convert trunc i32 i64 %t13
    branch %t14, ^lor_short_5, ^lor_rhs_4

  block ^lor_rhs_4:
    %t15 = addr $record
    %t16 = index inbounds i8 [projection=field] %t15, 0
    %t17 = index inbounds i32 [projection=array_element] %t16, 7
    %t18 = load typed i32 %t17
    %t19 = cmp ne i32 %t18, 19
    %t20 = convert trunc i32 i64 %t19
    %t21 = cmp ne i32 %t20, 0
    store typed i64 %t21, $lor__3
    jump ^lor_end_6

  block ^lor_short_5:
    store typed i64 1, $lor__3
    jump ^lor_end_6

  block ^lor_end_6:
    %t22 = load typed i64 $lor__3
    branch %t22, ^lor_short_8, ^lor_rhs_7

  block ^lor_rhs_7:
    %t23 = load volatile i32 @effects
    %t24 = cmp ne i32 %t23, 20
    %t25 = convert trunc i32 i64 %t24
    %t26 = cmp ne i32 %t25, 0
    store typed i64 %t26, $lor__4
    jump ^lor_end_9

  block ^lor_short_8:
    store typed i64 1, $lor__4
    jump ^lor_end_9

  block ^lor_end_9:
    %t27 = load typed i64 $lor__4
    %t28 = convert trunc i32 i64 %t27
    return i32 %t28
}
