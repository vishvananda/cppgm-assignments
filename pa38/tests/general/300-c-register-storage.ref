function @plus_one(%value : i32) -> i32 [linkage=c, binding=internal] {
  slot $value : i32

  block ^entry:
    store typed i32 %value, $value
    %t1 = load typed i32 $value
    %t2 = binary add nowrap i32 %t1, 1
    return i32 %t2
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $cell : obj<4x4>
  slot $array : obj<16x4>
  slot $copy : obj<4x4>
  slot $cursor : ptr
  slot $pointee : ptr
  slot $lor__1 : i64
  slot $lor__2 : i64

  block ^entry:
    %t1 = addr $cell
    %t2 = addr $cell
    %t3 = index inbounds i8 [projection=field] %t2, 0
    store typed i32 3, %t3
    %t4 = addr $copy
    %t5 = addr $copy
    %t6 = index inbounds i8 [projection=field] %t5, 0
    store typed i32 6, %t6
    %t7 = addr $cell
    store typed ptr %t7, $cursor
    %t8 = load typed ptr $cursor
    %t9 = index inbounds i8 [projection=field] %t8, 0
    store typed ptr %t9, $pointee
    %t10 = const i64 16
    %t11 = const i64 4
    %t12 = convert sext i64 i32 4
    %t13 = binary mul i64 %t12, %t11
    %t14 = cmp ne i64 %t10, %t13
    %t15 = convert trunc i32 i64 %t14
    branch %t15, ^lor_short_2, ^lor_rhs_1

  block ^lor_rhs_1:
    %t16 = load typed ptr $pointee
    %t17 = load typed i32 %t16
    %t18 = cmp ne i32 %t17, 3
    %t19 = convert trunc i32 i64 %t18
    %t20 = cmp ne i32 %t19, 0
    store typed i64 %t20, $lor__1
    jump ^lor_end_3

  block ^lor_short_2:
    store typed i64 1, $lor__1
    jump ^lor_end_3

  block ^lor_end_3:
    %t21 = load typed i64 $lor__1
    branch %t21, ^lor_short_5, ^lor_rhs_4

  block ^lor_rhs_4:
    %t22 = addr $copy
    %t23 = index inbounds i8 [projection=field] %t22, 0
    %t24 = load typed i32 %t23
    %t25 = call i32 @plus_one(%t24)
    %t26 = cmp ne i32 %t25, 7
    %t27 = convert trunc i32 i64 %t26
    %t28 = cmp ne i32 %t27, 0
    store typed i64 %t28, $lor__2
    jump ^lor_end_6

  block ^lor_short_5:
    store typed i64 1, $lor__2
    jump ^lor_end_6

  block ^lor_end_6:
    %t29 = load typed i64 $lor__2
    %t30 = convert trunc i32 i64 %t29
    return i32 %t30
}
