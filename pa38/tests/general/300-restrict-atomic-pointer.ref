global @__constexpr_template__1 [storage=readonly, binding=internal] = {
  i32 1
  i32 9
}

function @last(%values : ptr) -> i32 [linkage=c, binding=internal] {
  slot $values : ptr
  slot $p : ptr

  block ^entry:
    store typed ptr %values, $values
    %t1 = addr $values
    store typed ptr %t1, $p
    %t2 = load typed ptr $p
    %t3 = atomic_load ptr %t2, 5
    %t4 = index inbounds i32 [projection=array_element] %t3, 1
    %t5 = load typed i32 %t4
    return i32 %t5
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $values : obj<8x4>

  block ^entry:
    %t1 = addr $values
    copyobj 8x4 @__constexpr_template__1, %t1
    %t2 = addr $values
    %t3 = call i32 @last(%t2)
    %t4 = cmp ne i32 %t3, 9
    %t5 = convert trunc i32 i64 %t4
    return i32 %t5
}
