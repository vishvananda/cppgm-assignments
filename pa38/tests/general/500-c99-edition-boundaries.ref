global @pair [storage=readonly, linkage=c, binding=strong] = {
  i32 17
  i32 25
}

function @first(%values : ptr) -> i64 [linkage=c, binding=internal] {
  slot $values : ptr

  block ^entry:
    store typed ptr %values, $values
    %t1 = load typed ptr $values
    %t2 = index inbounds i32 [projection=array_element] %t1, 0
    %t3 = load typed i32 %t2
    %t4 = convert sext i64 i32 %t3
    return i64 %t4
}
function @variable_size(%count : i32) -> i32 [linkage=c, binding=internal] {
  slot $count : i32
  slot $tmpobj__1 : i64

  block ^entry:
    store typed i32 %count, $count
    %t1 = load typed i32 $count
    %t2 = convert sext i64 i32 %t1
    %t3 = binary mul i64 %t2, 4
    store typed i64 %t3, $tmpobj__1
    %t4 = load typed i64 $tmpobj__1
    %t5 = load typed i32 $count
    %t6 = const i64 4
    %t7 = convert sext i64 i32 %t5
    %t8 = binary mul i64 %t7, %t6
    %t9 = cmp eq i64 %t4, %t8
    %t10 = convert trunc i32 i64 %t9
    return i32 %t10
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $value : ptr
  slot $tmpobj__1 : i32
  slot $z : obj<16x8>
  slot $complex__2 : obj<16x8>
  slot $enough : u8
  slot $complex__3 : obj<16x8>
  slot $complex__4 : obj<16x8>
  slot $complex__5 : obj<16x8>
  slot $packet : obj<4x4>
  slot $values : obj<4x4>
  slot $lor__6 : i64
  slot $lor__7 : i64
  slot $lor__8 : i64

  block ^entry:
    %t1 = binary add nowrap i32 40, 2
    store typed i32 %t1, $tmpobj__1
    %t2 = addr $tmpobj__1
    store typed ptr %t2, $value
    %t3 = addr $complex__2
    store typed f64 3, %t3
    %t4 = index i8 [projection=field] %t3, 8
    store typed f64 0, %t4
    %t5 = load obj<16x8> $complex__2
    store obj<16x8> %t5, $z
    %t6 = load obj<16x8> $z
    %t7 = addr $complex__3
    store typed f64 3, %t7
    %t8 = index i8 [projection=field] %t7, 8
    store typed f64 0, %t8
    %t9 = load obj<16x8> $complex__3
    store obj<16x8> %t6, $complex__4
    %t10 = addr $complex__4
    %t11 = load typed f64 %t10
    %t12 = index i8 [projection=field] %t10, 8
    %t13 = load typed f64 %t12
    store obj<16x8> %t9, $complex__5
    %t14 = addr $complex__5
    %t15 = load typed f64 %t14
    %t16 = index i8 [projection=field] %t14, 8
    %t17 = load typed f64 %t16
    %t18 = cmp eq f64 %t11, %t15
    %t19 = cmp eq f64 %t13, %t17
    %t20 = binary and i64 %t18, %t19
    %t21 = convert trunc i32 i64 %t20
    %t22 = cmp ne i32 %t21, 0
    %t23 = convert trunc u8 i64 %t22
    store typed u8 %t23, $enough
    %t24 = addr $packet
    %t25 = addr $packet
    %t26 = index inbounds i8 [projection=field] %t25, 0
    store typed i32 0, %t26
    %t27 = addr $values
    %t28 = load typed ptr $value
    %t29 = load typed i32 %t28
    store typed i32 %t29, %t27
    %t30 = load typed u8 $enough
    %t31 = cmp eq u8 %t30, 0
    %t32 = convert trunc i32 i64 %t31
    branch %t32, ^lor_short_2, ^lor_rhs_1

  block ^lor_rhs_1:
    %t33 = addr $packet
    %t34 = index inbounds i8 [projection=field] %t33, 0
    %t35 = load typed i32 %t34
    %t36 = cmp ne i32 %t35, 0
    store typed i64 %t36, $lor__6
    jump ^lor_end_3

  block ^lor_short_2:
    store typed i64 1, $lor__6
    jump ^lor_end_3

  block ^lor_end_3:
    %t37 = load typed i64 $lor__6
    branch %t37, ^lor_short_5, ^lor_rhs_4

  block ^lor_rhs_4:
    %t38 = addr $values
    %t39 = call i64 @first(%t38)
    %t40 = addr @pair
    %t41 = index inbounds i32 [projection=array_element] %t40, 0
    %t42 = load typed i32 %t41
    %t43 = addr @pair
    %t44 = index inbounds i32 [projection=array_element] %t43, 1
    %t45 = load typed i32 %t44
    %t46 = binary add nowrap i32 %t42, %t45
    %t47 = convert sext i64 i32 %t46
    %t48 = cmp ne i64 %t39, %t47
    %t49 = convert trunc i32 i64 %t48
    %t50 = cmp ne i32 %t49, 0
    store typed i64 %t50, $lor__7
    jump ^lor_end_6

  block ^lor_short_5:
    store typed i64 1, $lor__7
    jump ^lor_end_6

  block ^lor_end_6:
    %t51 = load typed i64 $lor__7
    branch %t51, ^lor_short_8, ^lor_rhs_7

  block ^lor_rhs_7:
    %t52 = call i32 @variable_size(2)
    %t53 = cmp eq i32 %t52, 0
    %t54 = convert trunc i32 i64 %t53
    %t55 = cmp ne i32 %t54, 0
    store typed i64 %t55, $lor__8
    jump ^lor_end_9

  block ^lor_short_8:
    store typed i64 1, $lor__8
    jump ^lor_end_9

  block ^lor_end_9:
    %t56 = load typed i64 $lor__8
    %t57 = convert trunc i32 i64 %t56
    return i32 %t57
}
