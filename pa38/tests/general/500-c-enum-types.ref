function @read_counter(%p : ptr) -> u32 [linkage=c, binding=internal] {
  slot $p : ptr

  block ^entry:
    store typed ptr %p, $p
    %t1 = load typed ptr $p
    %t2 = load typed u32 %t1
    return u32 %t2
}
function @read_delta(%p : ptr) -> i32 [linkage=c, binding=internal] {
  slot $p : ptr

  block ^entry:
    store typed ptr %p, $p
    %t1 = load typed ptr $p
    %t2 = load typed i32 %t1
    return i32 %t2
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $counter : u32
  slot $delta : i32
  slot $data : ptr
  slot $lor__1 : i64

  block ^entry:
    store typed u32 4, $counter
    store typed i32 -5, $delta
    %t1 = convert sext i64 i32 4
    %t2 = copy ptr %t1
    store typed ptr %t2, $data
    %t3 = load typed ptr $data
    %t4 = convert trunc u32 ptr %t3
    %t5 = cmp ne u32 %t4, 4
    %t6 = convert trunc i32 i64 %t5
    branch %t6, ^if_then_1, ^if_else_2

  block ^if_then_1:
    return i32 1

  block ^if_else_2:
    jump ^if_end_3

  block ^if_end_3:
    %t7 = addr $counter
    %t8 = call u32 @read_counter(%t7)
    %t9 = cmp ne u32 %t8, 4
    %t10 = convert trunc i32 i64 %t9
    branch %t10, ^lor_short_5, ^lor_rhs_4

  block ^lor_rhs_4:
    %t11 = addr $delta
    %t12 = call i32 @read_delta(%t11)
    %t13 = unary neg i32 5
    %t14 = cmp ne i32 %t12, %t13
    %t15 = convert trunc i32 i64 %t14
    %t16 = cmp ne i32 %t15, 0
    store typed i64 %t16, $lor__1
    jump ^lor_end_6

  block ^lor_short_5:
    store typed i64 1, $lor__1
    jump ^lor_end_6

  block ^lor_end_6:
    %t17 = load typed i64 $lor__1
    %t18 = convert trunc i32 i64 %t17
    return i32 %t18
}
