global @thread_local : i32 [linkage=c, binding=internal] = 7

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $value : i64
  slot $lor__1 : i64

  block ^entry:
    store typed i64 3, $value
    %t1 = load typed i64 $value
    %t2 = cmp ne i64 %t1, 3
    %t3 = convert trunc i32 i64 %t2
    branch %t3, ^lor_short_2, ^lor_rhs_1

  block ^lor_rhs_1:
    %t4 = load typed i32 @thread_local
    %t5 = cmp ne i32 %t4, 7
    %t6 = convert trunc i32 i64 %t5
    %t7 = cmp ne i32 %t6, 0
    store typed i64 %t7, $lor__1
    jump ^lor_end_3

  block ^lor_short_2:
    store typed i64 1, $lor__1
    jump ^lor_end_3

  block ^lor_end_3:
    %t8 = load typed i64 $lor__1
    %t9 = convert trunc i32 i64 %t8
    return i32 %t9
}
