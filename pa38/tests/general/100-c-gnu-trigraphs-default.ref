global @spelling [storage=readonly, linkage=c, binding=internal] = {
  i8 63
  i8 63
  i8 61
  i8 0
}
global @after_comment : i32 [linkage=c, binding=internal] = 1

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $lor__1 : i64
  slot $lor__2 : i64
  slot $lor__3 : i64

  block ^entry:
    %t1 = cmp ne i32 42, 42
    %t2 = convert trunc i32 i64 %t1
    branch %t2, ^lor_short_2, ^lor_rhs_1

  block ^lor_rhs_1:
    %t3 = const i64 4
    %t4 = convert sext i64 i32 4
    %t5 = cmp ne i64 %t3, %t4
    %t6 = convert trunc i32 i64 %t5
    %t7 = cmp ne i32 %t6, 0
    store typed i64 %t7, $lor__1
    jump ^lor_end_3

  block ^lor_short_2:
    store typed i64 1, $lor__1
    jump ^lor_end_3

  block ^lor_end_3:
    %t8 = load typed i64 $lor__1
    branch %t8, ^lor_short_5, ^lor_rhs_4

  block ^lor_rhs_4:
    %t9 = addr @spelling
    %t10 = index inbounds i8 [projection=array_element] %t9, 2
    %t11 = load i8 %t10
    %t12 = convert sext i32 i8 %t11
    %t13 = cmp ne i32 %t12, 61
    %t14 = convert trunc i32 i64 %t13
    %t15 = cmp ne i32 %t14, 0
    store typed i64 %t15, $lor__2
    jump ^lor_end_6

  block ^lor_short_5:
    store typed i64 1, $lor__2
    jump ^lor_end_6

  block ^lor_end_6:
    %t16 = load typed i64 $lor__2
    branch %t16, ^lor_short_8, ^lor_rhs_7

  block ^lor_rhs_7:
    %t17 = load typed i32 @after_comment
    %t18 = cmp ne i32 %t17, 1
    %t19 = convert trunc i32 i64 %t18
    %t20 = cmp ne i32 %t19, 0
    store typed i64 %t20, $lor__3
    jump ^lor_end_9

  block ^lor_short_8:
    store typed i64 1, $lor__3
    jump ^lor_end_9

  block ^lor_end_9:
    %t21 = load typed i64 $lor__3
    %t22 = convert trunc i32 i64 %t21
    return i32 %t22
}
