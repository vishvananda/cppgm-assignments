global @a : i8 [linkage=c, binding=internal] = 7
global @b : i8 [linkage=c, binding=internal] = -3
global @first : u8 [linkage=c, binding=internal] = 1
global @second : u8 [linkage=c, binding=internal] = 0
global @bits [linkage=c, binding=internal] = {
  u32 42
}

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $land__1 : i64
  slot $cond__2 : i32
  slot $cond__3 : i32
  slot $land__4 : i64
  slot $cond__5 : i32

  block ^entry:
    branch 1, ^cond_then_4, ^cond_else_5

  block ^cond_then_4:
    %t1 = load i8 @a
    %t2 = convert sext i32 i8 %t1
    store typed i32 %t2, $cond__2
    jump ^cond_end_6

  block ^cond_else_5:
    %t3 = load i8 @b
    %t4 = convert sext i32 i8 %t3
    store typed i32 %t4, $cond__2
    jump ^cond_end_6

  block ^cond_end_6:
    %t5 = load typed i32 $cond__2
    %t6 = cmp eq i32 %t5, 7
    %t7 = convert trunc i32 i64 %t6
    branch %t7, ^land_rhs_1, ^land_short_2

  block ^land_rhs_1:
    branch 0, ^cond_then_7, ^cond_else_8

  block ^cond_then_7:
    %t8 = load typed u8 @first
    %t9 = convert zext i32 u8 %t8
    store typed i32 %t9, $cond__3
    jump ^cond_end_9

  block ^cond_else_8:
    %t10 = load typed u8 @second
    %t11 = convert zext i32 u8 %t10
    store typed i32 %t11, $cond__3
    jump ^cond_end_9

  block ^cond_end_9:
    %t12 = load typed i32 $cond__3
    %t13 = cmp eq i32 %t12, 0
    %t14 = convert trunc i32 i64 %t13
    %t15 = cmp ne i32 %t14, 0
    store typed i64 %t15, $land__1
    jump ^land_end_3

  block ^land_short_2:
    store typed i64 0, $land__1
    jump ^land_end_3

  block ^land_end_3:
    %t16 = load typed i64 $land__1
    branch %t16, ^land_rhs_10, ^land_short_11

  block ^land_rhs_10:
    branch 0, ^cond_then_13, ^cond_else_14

  block ^cond_then_13:
    %t17 = addr @bits
    %t18 = index inbounds i8 [projection=field] %t17, 0
    %t19 = load i32 %t18
    %t20 = binary and i32 %t19, 7
    %t21 = copy u32 %t20
    %t22 = copy i32 %t21
    store typed i32 %t22, $cond__5
    jump ^cond_end_15

  block ^cond_else_14:
    %t23 = addr @bits
    %t24 = index inbounds i8 [projection=field] %t23, 0
    %t25 = load i32 %t24
    %t26 = binary shr i32 %t25, 3
    %t27 = binary and i32 %t26, 7
    %t28 = copy u32 %t27
    %t29 = copy i32 %t28
    store typed i32 %t29, $cond__5
    jump ^cond_end_15

  block ^cond_end_15:
    %t30 = load typed i32 $cond__5
    %t31 = cmp eq i32 %t30, 5
    %t32 = convert trunc i32 i64 %t31
    %t33 = cmp ne i32 %t32, 0
    store typed i64 %t33, $land__4
    jump ^land_end_12

  block ^land_short_11:
    store typed i64 0, $land__4
    jump ^land_end_12

  block ^land_end_12:
    %t34 = load typed i64 $land__4
    %t35 = convert trunc i32 i64 %t34
    %t36 = cmp eq i32 %t35, 0
    %t37 = convert trunc i32 i64 %t36
    return i32 %t37
}
