function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $storage : i32
  slot $copy : i32
  slot $value : i32
  slot $pointer : ptr
  slot $lor__1 : i64

  block ^entry:
    atomic_store i32 6, $storage, 5
    %t1 = atomic_load i32 $storage, 5
    store typed i32 %t1, $copy
    store typed i32 4, $value
    %t2 = addr $value
    store typed ptr %t2, $pointer
    %t3 = load typed ptr $pointer
    %t4 = load typed i32 %t3
    %t5 = atomic_add_fetch i32 $storage, %t4, 5
    %t6 = load typed i32 $copy
    %t7 = cmp ne i32 %t6, 6
    %t8 = convert trunc i32 i64 %t7
    branch %t8, ^lor_short_2, ^lor_rhs_1

  block ^lor_rhs_1:
    %t9 = atomic_load i32 $storage, 5
    %t10 = cmp ne i32 %t9, 10
    %t11 = convert trunc i32 i64 %t10
    %t12 = cmp ne i32 %t11, 0
    store typed i64 %t12, $lor__1
    jump ^lor_end_3

  block ^lor_short_2:
    store typed i64 1, $lor__1
    jump ^lor_end_3

  block ^lor_end_3:
    %t13 = load typed i64 $lor__1
    %t14 = convert trunc i32 i64 %t13
    return i32 %t14
}
