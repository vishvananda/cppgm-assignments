global @nullptr : i32 [linkage=c, binding=internal] = 20
global @nullptr_t : i32 [linkage=c, binding=internal] = 22
global @alignas : i32 [linkage=c, binding=internal] = zero
global @alignof : i32 [linkage=c, binding=internal] = zero

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    %t1 = load typed i32 @nullptr
    %t2 = load typed i32 @nullptr_t
    %t3 = binary add nowrap i32 %t1, %t2
    %t4 = load typed i32 @alignas
    %t5 = binary add nowrap i32 %t3, %t4
    %t6 = load typed i32 @alignof
    %t7 = binary add nowrap i32 %t5, %t6
    %t8 = cmp ne i32 %t7, 42
    %t9 = convert trunc i32 i64 %t8
    return i32 %t9
}
