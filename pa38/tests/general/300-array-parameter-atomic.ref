global @__constexpr_template__1 [storage=readonly, binding=internal] = {
  i32 2
  i32 7
}

function @last(%values : ptr) -> i32 [linkage=c, binding=internal] {
  slot $values : ptr
  slot $ptr : ptr

  block ^entry:
    store typed ptr %values, $values
    %t1 = addr $values
    store typed ptr %t1, $ptr
    %t2 = atomic_load ptr $values, 5
    %t3 = binary mul i64 1, 4
    %t4 = index inbounds i8 %t2, %t3
    %t5 = load typed ptr $ptr
    atomic_store ptr %t4, %t5, 5
    %t6 = atomic_load ptr $values, 5
    %t7 = index inbounds i32 [projection=array_element] %t6, 0
    %t8 = load typed i32 %t7
    return i32 %t8
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $values : obj<8x4>

  block ^entry:
    %t1 = addr $values
    copyobj 8x4 @__constexpr_template__1, %t1
    %t2 = addr $values
    %t3 = call i32 @last(%t2)
    %t4 = cmp ne i32 %t3, 7
    %t5 = convert trunc i32 i64 %t4
    return i32 %t5
}
