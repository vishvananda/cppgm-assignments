global @first [storage=readonly, linkage=c, binding=internal] = {
  f64 1
  f64 1.5
}
global @copy [storage=readonly, linkage=c, binding=internal] = {
  f64 1
  f64 1.5
}
global @real_only [storage=readonly, linkage=c, binding=internal] = {
  f32 16f
  f32 0f
}

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $lor__1 : i64
  slot $lor__2 : i64
  slot $lor__3 : i64

  block ^entry:
    %t1 = addr @copy
    %t2 = load typed f64 %t1
    %t3 = cmp ne f64 %t2, 1
    %t4 = convert trunc i32 i64 %t3
    branch %t4, ^lor_short_2, ^lor_rhs_1

  block ^lor_rhs_1:
    %t5 = addr @copy
    %t6 = index i8 [projection=field] %t5, 8
    %t7 = load typed f64 %t6
    %t8 = cmp ne f64 %t7, 1.5
    %t9 = convert trunc i32 i64 %t8
    %t10 = cmp ne i32 %t9, 0
    store typed i64 %t10, $lor__1
    jump ^lor_end_3

  block ^lor_short_2:
    store typed i64 1, $lor__1
    jump ^lor_end_3

  block ^lor_end_3:
    %t11 = load typed i64 $lor__1
    branch %t11, ^lor_short_5, ^lor_rhs_4

  block ^lor_rhs_4:
    %t12 = addr @real_only
    %t13 = load typed f32 %t12
    %t14 = cmp ne f32 %t13, 16f
    %t15 = convert trunc i32 i64 %t14
    %t16 = cmp ne i32 %t15, 0
    store typed i64 %t16, $lor__2
    jump ^lor_end_6

  block ^lor_short_5:
    store typed i64 1, $lor__2
    jump ^lor_end_6

  block ^lor_end_6:
    %t17 = load typed i64 $lor__2
    branch %t17, ^lor_short_8, ^lor_rhs_7

  block ^lor_rhs_7:
    %t18 = addr @real_only
    %t19 = index i8 [projection=field] %t18, 4
    %t20 = load typed f32 %t19
    %t21 = cmp ne f32 %t20, 0f
    %t22 = convert trunc i32 i64 %t21
    %t23 = cmp ne i32 %t22, 0
    store typed i64 %t23, $lor__3
    jump ^lor_end_9

  block ^lor_short_8:
    store typed i64 1, $lor__3
    jump ^lor_end_9

  block ^lor_end_9:
    %t24 = load typed i64 $lor__3
    %t25 = convert trunc i32 i64 %t24
    return i32 %t25
}
