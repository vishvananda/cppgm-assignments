global @nullptr_t : i32 [linkage=c, binding=internal] = zero
global @aligned : obj<8x8> [linkage=c, binding=internal] = {
  zero 1
}
global @default_null : i64 [linkage=c, binding=internal] = zero
global @initialized_null : i64 [linkage=c, binding=internal] = 0
global @static_pointer : ptr [linkage=c, binding=internal] = 0
global @static_bool : u8 [linkage=c, binding=internal] = 0
global @calls : i32 [linkage=c, binding=internal] = zero

function @produce() -> i64 [linkage=c, binding=internal] {
  block ^entry:
    %t1 = load volatile i32 @calls
    %t2 = binary add nowrap i32 %t1, 1
    store volatile i32 %t2, @calls
    return i64 0
}
function @receive(%value : i64) -> u8 [linkage=c, binding=internal] {
  slot $value : i64

  block ^entry:
    store typed i64 %value, $value
    %t1 = load typed i64 $value
    %t2 = cmp ne i64 %t1, 0
    %t3 = convert trunc u8 i64 %t2
    return u8 %t3
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $empty : i64
  slot $integer_null : i64
  slot $value : i64
  slot $atomic_value : i64
  slot $p : ptr
  slot $b : u8
  slot $function : ptr
  slot $lor__1 : i64

  block ^entry:
    store typed i64 0, $empty
    %t1 = binary sub nowrap i32 42, 42
    %t2 = convert sext i64 i32 %t1
    store typed i64 %t2, $integer_null
    %t3 = load typed i64 @default_null
    store typed i64 %t3, $value
    atomic_store i64 0, $atomic_value, 5
    atomic_store i64 0, $atomic_value, 5
    %t4 = call i64 @produce()
    %t5 = copy ptr %t4
    store typed ptr %t5, $p
    %t6 = call i64 @produce()
    %t7 = cmp ne i64 %t6, 0
    %t8 = convert trunc u8 i64 %t7
    store typed u8 %t8, $b
    %t9 = load typed i64 $value
    %t10 = copy ptr %t9
    store typed ptr %t10, $function
    %t11 = load typed ptr $p
    branch %t11, ^if_then_1, ^lor_rhs_7

  block ^lor_rhs_7:
    %t12 = load typed u8 $b
    branch %t12, ^if_then_1, ^lor_rhs_6

  block ^lor_rhs_6:
    %t13 = load typed ptr $function
    branch %t13, ^if_then_1, ^lor_rhs_5

  block ^lor_rhs_5:
    %t14 = load volatile i32 @calls
    %t15 = cmp ne i32 %t14, 2
    %t16 = convert trunc i32 i64 %t15
    branch %t16, ^if_then_1, ^lor_rhs_4

  block ^lor_rhs_4:
    %t17 = load typed u8 @static_bool
    branch %t17, ^if_then_1, ^lor_rhs_3

  block ^lor_rhs_3:
    %t18 = load typed ptr @static_pointer
    branch %t18, ^if_then_1, ^if_else_2

  block ^if_then_1:
    return i32 1

  block ^if_else_2:
    jump ^if_end_8

  block ^if_end_8:
    %t19 = call u8 @receive(0)
    branch %t19, ^if_then_9, ^lor_rhs_12

  block ^lor_rhs_12:
    %t20 = call u8 @receive(0)
    branch %t20, ^if_then_9, ^lor_rhs_11

  block ^lor_rhs_11:
    %t21 = load typed i64 $integer_null
    %t22 = call u8 @receive(%t21)
    branch %t22, ^if_then_9, ^if_else_10

  block ^if_then_9:
    return i32 2

  block ^if_else_10:
    jump ^if_end_13

  block ^if_end_13:
    %t23 = load typed i64 $value
    branch %t23, ^if_then_14, ^lor_rhs_18

  block ^lor_rhs_18:
    %t24 = atomic_load i64 $atomic_value, 5
    branch %t24, ^if_then_14, ^lor_rhs_17

  block ^lor_rhs_17:
    %t25 = load typed i64 $value
    %t26 = binary sub nowrap i32 20, 20
    %t27 = convert sext i64 i32 %t26
    %t28 = cmp ne i64 %t25, %t27
    %t29 = convert trunc i32 i64 %t28
    branch %t29, ^if_then_14, ^lor_rhs_16

  block ^lor_rhs_16:
    %t30 = load typed i64 $empty
    %t31 = load typed i64 @initialized_null
    %t32 = cmp ne i64 %t30, %t31
    %t33 = convert trunc i32 i64 %t32
    branch %t33, ^if_then_14, ^if_else_15

  block ^if_then_14:
    return i32 3

  block ^if_else_15:
    jump ^if_end_19

  block ^if_end_19:
    %t34 = call i64 @produce()
    %t35 = load typed ptr $p
    %t36 = copy ptr %t34
    %t37 = cmp ne ptr %t36, %t35
    %t38 = convert trunc i32 i64 %t37
    branch %t38, ^if_then_20, ^lor_rhs_24

  block ^lor_rhs_24:
    %t39 = load volatile i32 @calls
    %t40 = cmp ne i32 %t39, 3
    %t41 = convert trunc i32 i64 %t40
    branch %t41, ^if_then_20, ^lor_rhs_23

  block ^lor_rhs_23:
    %t42 = load typed i64 $value
    %t43 = cmp eq i64 %t42, 0
    %t44 = convert trunc i32 i64 %t43
    %t45 = cmp eq i32 %t44, 0
    %t46 = convert trunc i32 i64 %t45
    branch %t46, ^if_then_20, ^lor_rhs_22

  block ^lor_rhs_22:
    %t47 = load typed i64 $value
    branch %t47, ^if_then_20, ^lor_rhs_25

  block ^lor_rhs_25:
    branch 0, ^if_then_20, ^if_else_21

  block ^if_then_20:
    return i32 4

  block ^if_else_21:
    jump ^if_end_26

  block ^if_end_26:
    %t48 = addr @aligned
    %t49 = copy ptr 0
    %t50 = cmp eq ptr %t48, %t49
    %t51 = convert trunc i32 i64 %t50
    branch %t51, ^lor_short_28, ^lor_rhs_27

  block ^lor_rhs_27:
    %t52 = load typed i32 @nullptr_t
    %t53 = cmp ne i32 %t52, 0
    store typed i64 %t53, $lor__1
    jump ^lor_end_29

  block ^lor_short_28:
    store typed i64 1, $lor__1
    jump ^lor_end_29

  block ^lor_end_29:
    %t54 = load typed i64 $lor__1
    %t55 = convert trunc i32 i64 %t54
    return i32 %t55
}
