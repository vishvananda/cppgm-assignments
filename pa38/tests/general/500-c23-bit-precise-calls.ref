    %t19 = convert sext i128 i64 %t18
    %t20 = binary shl i128 %t19, 63
    %t21 = binary shr i128 %t20, 63
    %t22 = binary add i128 %t17, %t21
    %t23 = binary shl i128 %t22, 63
    %t24 = binary shr i128 %t23, 63
