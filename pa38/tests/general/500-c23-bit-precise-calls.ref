  block ^switch_dispatch_7:
    %t4 = cmp eq i128 %t2, 18446744073709551619
    branch %t4, ^switch_case_4, ^switch_dispatch_8

  block ^switch_dispatch_8:
    %t5 = cmp eq i128 %t2, 36893488147419103231
    branch %t5, ^switch_case_5, ^switch_dispatch_9

  block ^switch_dispatch_9:
    jump ^switch_default_6

  block ^switch_case_3:
    return i32 1

  block ^switch_case_4:
    return i32 2

  block ^switch_case_5:
    return i32 3

  block ^switch_default_6:
    return i32 0

  block ^switch_end_2:
