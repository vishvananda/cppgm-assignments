    %t16 = binary shr i16 %t15, 7
    %t17 = unary neg i32 106
    %t18 = convert sext i32 i16 %t16
    %t19 = cmp eq i32 %t18, %t17
    %t20 = convert trunc i32 i64 %t19
    branch %t20, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
