function @last(%length : i32, %row : ptr) -> i32 [linkage=c, binding=strong] {
  slot $length : i32
  slot $row : ptr
  slot $tmpobj__1 : i64
  slot $tmpobj__2 : i64
  slot $view : ptr

  block ^entry:
    store typed i32 %length, $length
    store typed ptr %row, $row
    %t1 = load typed i32 $length
    %t2 = convert sext i64 i32 %t1
    %t3 = binary mul i64 %t2, 4
    store typed i64 %t3, $tmpobj__1
    %t4 = load typed i32 $length
    %t5 = convert sext i64 i32 %t4
    %t6 = binary mul i64 %t5, 4
    store typed i64 %t6, $tmpobj__2
    %t7 = load typed ptr $row
    store typed ptr %t7, $view
    %t8 = load typed ptr $view
    %t9 = load typed i32 $length
    %t10 = binary sub nowrap i32 %t9, 1
    %t11 = index inbounds i32 [projection=array_element] %t8, %t10
    %t12 = load typed i32 %t11
    return i32 %t12
}
