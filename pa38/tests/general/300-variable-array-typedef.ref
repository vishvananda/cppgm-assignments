function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $width : i32
  slot $current : i32
  slot $tmpobj__1 : i64

  block ^entry:
    store typed i32 2, $width
    jump ^for_cond_1

  block ^for_cond_1:
    %t1 = load typed i32 $width
    %t2 = cmp le i32 %t1, 4
    %t3 = convert trunc i32 i64 %t2
    branch %t3, ^for_body_2, ^for_end_4

  block ^for_body_2:
    %t4 = load typed i32 $width
    store typed i32 %t4, $current
    %t5 = load typed i32 $current
    %t6 = binary add nowrap i32 %t5, 1
    store typed i32 %t6, $current
    %t7 = convert sext i64 i32 %t5
    %t8 = binary mul i64 %t7, 4
    store typed i64 %t8, $tmpobj__1
    %t9 = load typed i64 $tmpobj__1
    %t10 = binary mul i64 %t9, 2
    %t11 = stack_save
    %t12 = stack_alloc %t10
    %t13 = load typed i64 $tmpobj__1
    %t14 = stack_save
    %t15 = stack_alloc %t13
    %t16 = load typed i64 $tmpobj__1
    %t17 = copy i64 %t16
    %t18 = binary mul i64 1, %t17
    %t19 = index inbounds i8 [projection=array_element] %t12, %t18
    %t20 = load typed i32 $width
    %t21 = binary sub nowrap i32 %t20, 1
    %t22 = index inbounds i32 [projection=array_element] %t19, %t21
    store typed i32 7, %t22
    %t23 = load typed i32 $width
    %t24 = binary sub nowrap i32 %t23, 1
    %t25 = index inbounds i32 [projection=array_element] %t15, %t24
    store typed i32 11, %t25
    %t26 = load typed i32 $current
    %t27 = load typed i32 $width
    %t28 = binary add nowrap i32 %t27, 1
    %t29 = cmp ne i32 %t26, %t28
    %t30 = convert trunc i32 i64 %t29
    branch %t30, ^if_then_5, ^lor_rhs_10

  block ^lor_rhs_10:
    %t31 = load typed i64 $tmpobj__1
    %t32 = load typed i32 $width
    %t33 = const i64 4
    %t34 = convert sext i64 i32 %t32
    %t35 = binary mul i64 %t34, %t33
    %t36 = cmp ne i64 %t31, %t35
    %t37 = convert trunc i32 i64 %t36
    branch %t37, ^if_then_5, ^lor_rhs_9

  block ^lor_rhs_9:
    %t38 = load typed i64 $tmpobj__1
    %t39 = binary mul i64 %t38, 2
    %t40 = load typed i64 $tmpobj__1
    %t41 = convert sext i64 i32 2
    %t42 = binary mul i64 %t41, %t40
    %t43 = cmp ne i64 %t39, %t42
    %t44 = convert trunc i32 i64 %t43
    branch %t44, ^if_then_5, ^lor_rhs_8

  block ^lor_rhs_8:
    %t45 = load typed i64 $tmpobj__1
    %t46 = load typed i64 $tmpobj__1
    %t47 = cmp ne i64 %t45, %t46
    %t48 = convert trunc i32 i64 %t47
    branch %t48, ^if_then_5, ^lor_rhs_7

  block ^lor_rhs_7:
    %t49 = load typed i64 $tmpobj__1
    %t50 = copy i64 %t49
    %t51 = binary mul i64 1, %t50
    %t52 = index inbounds i8 [projection=array_element] %t12, %t51
    %t53 = load typed i32 $width
    %t54 = binary sub nowrap i32 %t53, 1
    %t55 = index inbounds i32 [projection=array_element] %t52, %t54
    %t56 = load typed i32 %t55
    %t57 = load typed i32 $width
    %t58 = binary sub nowrap i32 %t57, 1
    %t59 = index inbounds i32 [projection=array_element] %t15, %t58
    %t60 = load typed i32 %t59
    %t61 = binary add nowrap i32 %t56, %t60
    %t62 = cmp ne i32 %t61, 18
    %t63 = convert trunc i32 i64 %t62
    branch %t63, ^if_then_5, ^if_else_6

  block ^if_then_5:
    stack_restore %t14
    stack_restore %t11
    return i32 1

  block ^if_else_6:
    jump ^if_end_11

  block ^if_end_11:
    stack_restore %t14
    stack_restore %t11
    jump ^for_iter_3

  block ^for_iter_3:
    %t64 = load typed i32 $width
    %t65 = binary add nowrap i32 %t64, 1
    store typed i32 %t65, $width
    jump ^for_cond_1

  block ^for_end_4:
    return i32 0
}
