function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $node : obj<4x4>
  slot $packet : obj<16x8>
  slot $lor__1 : i64
  slot $lor__2 : i64

  block ^entry:
    %t1 = addr $node
    %t2 = addr $node
    %t3 = index inbounds i8 [projection=field] %t2, 0
    store typed i32 7, %t3
    %t4 = addr $packet
    %t5 = addr $packet
    %t6 = index inbounds i8 [projection=field] %t5, 0
    store typed i32 2, %t6
    %t7 = addr $packet
    %t8 = index inbounds i8 [projection=field] %t7, 4
    %t9 = index inbounds i8 [projection=field] %t8, 0
    store typed i32 42, %t9
    %t10 = addr $node
    %t11 = addr $packet
    %t12 = index inbounds i8 [projection=field] %t11, 8
    %t13 = index inbounds i8 [projection=field] %t12, 0
    store ptr %t10, %t13
    %t14 = addr $packet
    %t15 = index inbounds i8 [projection=field] %t14, 0
    %t16 = load typed i32 %t15
    %t17 = cmp ne i32 %t16, 2
    %t18 = convert trunc i32 i64 %t17
    branch %t18, ^lor_short_2, ^lor_rhs_1

  block ^lor_rhs_1:
    %t19 = addr $packet
    %t20 = index inbounds i8 [projection=field] %t19, 4
    %t21 = load typed i32 %t20
    %t22 = cmp ne i32 %t21, 42
    %t23 = convert trunc i32 i64 %t22
    %t24 = cmp ne i32 %t23, 0
    store typed i64 %t24, $lor__1
    jump ^lor_end_3

  block ^lor_short_2:
    store typed i64 1, $lor__1
    jump ^lor_end_3

  block ^lor_end_3:
    %t25 = load typed i64 $lor__1
    branch %t25, ^lor_short_5, ^lor_rhs_4

  block ^lor_rhs_4:
    %t26 = addr $packet
    %t27 = index inbounds i8 [projection=field] %t26, 8
    %t28 = load ptr %t27
    %t29 = index inbounds i8 [projection=field] %t28, 0
    %t30 = load typed i32 %t29
    %t31 = cmp ne i32 %t30, 7
    %t32 = convert trunc i32 i64 %t31
    %t33 = cmp ne i32 %t32, 0
    store typed i64 %t33, $lor__2
    jump ^lor_end_6

  block ^lor_short_5:
    store typed i64 1, $lor__2
    jump ^lor_end_6

  block ^lor_end_6:
    %t34 = load typed i64 $lor__2
    %t35 = convert trunc i32 i64 %t34
    return i32 %t35
}
