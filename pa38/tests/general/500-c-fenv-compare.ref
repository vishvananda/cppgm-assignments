declare function @feclearexcept(%arg0 : i32) -> i32 [linkage=c, binding=strong]
declare function @fetestexcept(%arg0 : i32) -> i32 [linkage=c, binding=strong]

function @ordered_less(%value : f64) -> i32 [linkage=c, binding=strong] {
  slot $value : f64

  block ^entry:
    store typed f64 %value, $value
    %t1 = load typed f64 $value
    %t2 = fenv_cmp_signal lt f64 %t1, 0
    %t3 = convert trunc i32 i64 %t2
    return i32 %t3
}
function @discard_ordered(%value : f64, %bound : f64) -> void [linkage=c, binding=strong] {
  slot $value : f64
  slot $bound : f64

  block ^entry:
    store typed f64 %value, $value
    store typed f64 %bound, $bound
    %t1 = load typed f64 $value
    %t2 = load typed f64 $bound
    %t3 = fenv_cmp_signal ge f64 %t1, %t2
    %t4 = convert trunc i32 i64 %t3
    return void
}
function @quiet_equal(%value : f64) -> i32 [linkage=c, binding=strong] {
  slot $value : f64

  block ^entry:
    store typed f64 %value, $value
    %t1 = load typed f64 $value
    %t2 = load typed f64 $value
    %t3 = fenv_cmp eq f64 %t1, %t2
    %t4 = convert trunc i32 i64 %t3
    return i32 %t4
}
function @quiet_less(%value : f64) -> i32 [linkage=c, binding=strong] {
  slot $value : f64

  block ^entry:
    store typed f64 %value, $value
    %t1 = load typed f64 $value
    %t2 = fenv_cmp lt f64 %t1, 0
    %t3 = convert trunc i32 i64 %t2
    return i32 %t3
}
function @ordered_long_double(%value : f80) -> i32 [linkage=c, binding=strong] {
  slot $value : f80

  block ^entry:
    store typed f80 %value, $value
    %t1 = load typed f80 $value
    %t2 = fenv_cmp_signal gt f80 %t1, 0L
    %t3 = convert trunc i32 i64 %t2
    return i32 %t3
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $qnan : f64
  slot $wide_nan : f80

  block ^entry:
    store volatile f64 nan, $qnan
    %t1 = unary neg f64 1
    %t2 = call i32 @ordered_less(%t1)
    %t3 = cmp eq i32 %t2, 0
    %t4 = convert trunc i32 i64 %t3
    branch %t4, ^if_then_1, ^lor_rhs_4

  block ^lor_rhs_4:
    %t5 = call i32 @quiet_equal(0.0)
    %t6 = cmp eq i32 %t5, 0
    %t7 = convert trunc i32 i64 %t6
    branch %t7, ^if_then_1, ^lor_rhs_3

  block ^lor_rhs_3:
    %t8 = unary neg f64 1
    %t9 = call i32 @quiet_less(%t8)
    %t10 = cmp eq i32 %t9, 0
    %t11 = convert trunc i32 i64 %t10
    branch %t11, ^if_then_1, ^if_else_2

  block ^if_then_1:
    return i32 1

  block ^if_else_2:
    jump ^if_end_5

  block ^if_end_5:
    %t12 = binary or i32 32, 4
    %t13 = binary or i32 %t12, 16
    %t14 = binary or i32 %t13, 8
    %t15 = binary or i32 %t14, 1
    %t16 = call i32 @feclearexcept(%t15)
    %t17 = cmp ne i32 %t16, 0
    %t18 = convert trunc i32 i64 %t17
    branch %t18, ^if_then_6, ^if_else_7

  block ^if_then_6:
    return i32 2

  block ^if_else_7:
    jump ^if_end_8

  block ^if_end_8:
    %t19 = load volatile f64 $qnan
    %t20 = call i32 @quiet_equal(%t19)
    branch %t20, ^if_then_9, ^lor_rhs_12

  block ^lor_rhs_12:
    %t21 = load volatile f64 $qnan
    %t22 = call i32 @quiet_less(%t21)
    branch %t22, ^if_then_9, ^lor_rhs_11

  block ^lor_rhs_11:
    %t23 = call i32 @fetestexcept(1)
    %t24 = binary and i32 %t23, 1
    branch %t24, ^if_then_9, ^if_else_10

  block ^if_then_9:
    return i32 3

  block ^if_else_10:
    jump ^if_end_13

  block ^if_end_13:
    %t25 = load volatile f64 $qnan
    %t26 = call i32 @ordered_less(%t25)
    branch %t26, ^if_then_14, ^lor_rhs_16

  block ^lor_rhs_16:
    %t27 = call i32 @fetestexcept(1)
    %t28 = binary and i32 %t27, 1
    %t29 = cmp eq i32 %t28, 0
    %t30 = convert trunc i32 i64 %t29
    branch %t30, ^if_then_14, ^if_else_15

  block ^if_then_14:
    return i32 4

  block ^if_else_15:
    jump ^if_end_17

  block ^if_end_17:
    %t31 = binary or i32 32, 4
    %t32 = binary or i32 %t31, 16
    %t33 = binary or i32 %t32, 8
    %t34 = binary or i32 %t33, 1
    %t35 = call i32 @feclearexcept(%t34)
    %t36 = cmp ne i32 %t35, 0
    %t37 = convert trunc i32 i64 %t36
    branch %t37, ^if_then_18, ^if_else_19

  block ^if_then_18:
    return i32 5

  block ^if_else_19:
    jump ^if_end_20

  block ^if_end_20:
    %t38 = load volatile f64 $qnan
    call void @discard_ordered(%t38, 1.0)
    %t39 = call i32 @fetestexcept(1)
    %t40 = binary and i32 %t39, 1
    %t41 = cmp eq i32 %t40, 0
    %t42 = convert trunc i32 i64 %t41
    branch %t42, ^if_then_21, ^if_else_22

  block ^if_then_21:
    return i32 6

  block ^if_else_22:
    jump ^if_end_23

  block ^if_end_23:
    store volatile f80 nanL, $wide_nan
    %t43 = binary or i32 32, 4
    %t44 = binary or i32 %t43, 16
    %t45 = binary or i32 %t44, 8
    %t46 = binary or i32 %t45, 1
    %t47 = call i32 @feclearexcept(%t46)
    %t48 = cmp ne i32 %t47, 0
    %t49 = convert trunc i32 i64 %t48
    branch %t49, ^if_then_24, ^if_else_25

  block ^if_then_24:
    return i32 7

  block ^if_else_25:
    jump ^if_end_26

  block ^if_end_26:
    %t50 = load volatile f80 $wide_nan
    %t51 = call i32 @ordered_long_double(%t50)
    branch %t51, ^if_then_27, ^lor_rhs_29

  block ^lor_rhs_29:
    %t52 = call i32 @fetestexcept(1)
    %t53 = binary and i32 %t52, 1
    %t54 = cmp eq i32 %t53, 0
    %t55 = convert trunc i32 i64 %t54
    branch %t55, ^if_then_27, ^if_else_28

  block ^if_then_27:
    return i32 8

  block ^if_else_28:
    jump ^if_end_30

  block ^if_end_30:
    return i32 0
}
