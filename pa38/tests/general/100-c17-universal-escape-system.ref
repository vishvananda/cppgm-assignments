global @escaped_quote [storage=readonly, linkage=c, binding=internal] = {
  i8 34
  i8 0
}

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $lor__1 : i64

  block ^entry:
    %t1 = addr @escaped_quote
    %t2 = index inbounds i8 [projection=array_element] %t1, 0
    %t3 = load i8 %t2
    %t4 = convert sext i32 i8 %t3
    %t5 = cmp ne i32 %t4, 34
    %t6 = convert trunc i32 i64 %t5
    branch %t6, ^lor_short_2, ^lor_rhs_1

  block ^lor_rhs_1:
    %t7 = addr @escaped_quote
    %t8 = index inbounds i8 [projection=array_element] %t7, 1
    %t9 = load i8 %t8
    %t10 = convert sext i32 i8 %t9
    %t11 = cmp ne i32 %t10, 0
    %t12 = convert trunc i32 i64 %t11
    %t13 = cmp ne i32 %t12, 0
    store typed i64 %t13, $lor__1
    jump ^lor_end_3

  block ^lor_short_2:
    store typed i64 1, $lor__1
    jump ^lor_end_3

  block ^lor_end_3:
    %t14 = load typed i64 $lor__1
    %t15 = convert trunc i32 i64 %t14
    return i32 %t15
}
