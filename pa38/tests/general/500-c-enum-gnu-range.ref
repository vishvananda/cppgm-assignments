function @read() -> i64 [linkage=c, binding=internal] {
  block ^entry:
    return i64 4294967295
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $value : i64
  slot $lor__1 : i64

  block ^entry:
    %t1 = call i64 @read()
    store typed i64 %t1, $value
    %t2 = load typed i64 $value
    %t3 = copy i64 %t2
    %t4 = cmp ne i64 %t3, 4294967295
    %t5 = convert trunc i32 i64 %t4
    branch %t5, ^lor_short_2, ^lor_rhs_1

  block ^lor_rhs_1:
    %t6 = unary neg i32 1
    %t7 = convert sext i64 i32 %t6
    %t8 = cmp ne i64 -1, %t7
    %t9 = convert trunc i32 i64 %t8
    %t10 = cmp ne i32 %t9, 0
    store typed i64 %t10, $lor__1
    jump ^lor_end_3

  block ^lor_short_2:
    store typed i64 1, $lor__1
    jump ^lor_end_3

  block ^lor_end_3:
    %t11 = load typed i64 $lor__1
    %t12 = convert trunc i32 i64 %t11
    return i32 %t12
}
