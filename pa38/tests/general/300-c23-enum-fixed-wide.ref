global @stored : i128 [linkage=c, binding=internal] = 154742504910672534362390528
global @index : u32 [linkage=c, binding=internal] = 1

function @read_value() -> i128 [linkage=c, binding=strong] {
  slot $cond__1 : i128

  block ^entry:
    %t1 = load volatile u32 @index
    branch %t1, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    %t2 = load volatile i128 @stored
    store typed i128 %t2, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store typed i128 154742504910672534362390529, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t3 = load typed i128 $cond__1
    return i128 %t3
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    %t1 = call i128 @read_value()
    jump ^switch_dispatch_1

  block ^switch_dispatch_1:
    %t2 = cmp eq i128 %t1, 0
    branch %t2, ^switch_case_3, ^switch_dispatch_6

  block ^switch_dispatch_6:
    %t3 = cmp eq i128 %t1, 154742504910672534362390528
    branch %t3, ^switch_case_4, ^switch_dispatch_7

  block ^switch_dispatch_7:
