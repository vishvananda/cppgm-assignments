global @state : u32 [linkage=c, binding=internal] = 7
global @choose : i32 [linkage=c, binding=internal] = zero

function @echo(%cell : obj<16x8>) -> obj<16x8> [linkage=c, binding=internal] {
  slot $cell : obj<16x8>
  slot $retobj__1 : obj<16x8>

  block ^entry:
    %t1 = addr $cell
    copyobj 16x8 %cell, %t1
    %t2 = addr $retobj__1
    %t3 = addr $cell
    copyobj 16x8 %t3, %t2
    return obj<16x8> $retobj__1
}
function @read_variant(%variant : obj<4x4>) -> i32 [linkage=c, binding=internal] {
  slot $variant : obj<4x4>

  block ^entry:
    %t1 = addr $variant
    copyobj 4x4 %variant, %t1
    %t2 = addr $variant
    %t3 = index inbounds i8 [projection=field] %t2, 0
    %t4 = load i32 %t3
    return i32 %t4
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $first : obj<16x8>
  slot $local : ptr
  slot $outer : ptr
  slot $second : obj<16x8>
  slot $argobj__1 : obj<16x8>
  slot $tmpobj__2 : obj<16x8>
  slot $argobj__3 : obj<16x8>
  slot $variant : obj<4x4>
  slot $current : ptr
  slot $lor__4 : i64
  slot $argobj__5 : obj<4x4>

  block ^entry:
    %t1 = addr $first
    %t2 = addr $first
    %t3 = index inbounds i8 [projection=field] %t2, 0
    store typed i32 4, %t3
    %t4 = copy ptr 0
    %t5 = addr $first
    %t6 = index inbounds i8 [projection=field] %t5, 8
    store typed ptr %t4, %t6
    %t7 = addr $first
    store typed ptr %t7, $local
    %t8 = load typed ptr $local
    store typed ptr %t8, $outer
    %t9 = addr $second
    %t10 = addr $argobj__1
    %t11 = load typed ptr $outer
    copyobj 16x8 %t11, %t10
    %t12 = call obj<16x8> @echo($argobj__1)
    copyobj 16x8 %t12, %t9
    %t13 = load typed ptr $local
    %t14 = addr $second
    %t15 = index inbounds i8 [projection=field] %t14, 8
    store typed ptr %t13, %t15
    %t16 = addr $tmpobj__2
    %t17 = load volatile i32 @choose
    branch %t17, ^condobj_then_1, ^condobj_else_2

  block ^condobj_then_1:
    %t18 = addr $argobj__3
    %t19 = addr $second
    copyobj 16x8 %t19, %t18
    %t20 = call obj<16x8> @echo($argobj__3)
    copyobj 16x8 %t20, %t16
    jump ^condobj_end_3

  block ^condobj_else_2:
    %t21 = addr $second
    copyobj 16x8 %t21, %t16
    jump ^condobj_end_3

  block ^condobj_end_3:
    %t22 = load obj<16x8> %t16
    store obj<16x8> %t22, $first
    %t23 = addr $variant
    %t24 = addr $first
    %t25 = index inbounds i8 [projection=field] %t24, 8
    %t26 = load typed ptr %t25
    %t27 = index inbounds i8 [projection=field] %t26, 0
    %t28 = load typed i32 %t27
    %t29 = addr $variant
    %t30 = index inbounds i8 [projection=field] %t29, 0
    store i32 %t28, %t30
    %t31 = addr @state
    store typed ptr %t31, $current
    %t32 = addr $argobj__5
    %t33 = addr $variant
    copyobj 4x4 %t33, %t32
    %t34 = call i32 @read_variant($argobj__5)
    %t35 = cmp ne i32 %t34, 4
    %t36 = convert trunc i32 i64 %t35
    branch %t36, ^lor_short_5, ^lor_rhs_4

  block ^lor_rhs_4:
    %t37 = load typed ptr $current
    %t38 = load typed u32 %t37
    %t39 = cmp ne u32 %t38, 7
    %t40 = convert trunc i32 i64 %t39
    %t41 = cmp ne i32 %t40, 0
    store typed i64 %t41, $lor__4
    jump ^lor_end_6

  block ^lor_short_5:
    store typed i64 1, $lor__4
    jump ^lor_end_6

  block ^lor_end_6:
    %t42 = load typed i64 $lor__4
    %t43 = convert trunc i32 i64 %t42
    return i32 %t43
}
