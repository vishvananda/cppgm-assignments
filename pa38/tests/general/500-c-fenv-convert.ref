declare function @fesetround(%arg0 : i32) -> i32 [linkage=c, binding=strong]
declare function @feclearexcept(%arg0 : i32) -> i32 [linkage=c, binding=strong]
declare function @fetestexcept(%arg0 : i32) -> i32 [linkage=c, binding=strong]

global @static_halfway : f32 [linkage=c, binding=internal] = 1f

function @round_integer() -> f32 [linkage=c, binding=strong] {
  block ^entry:
    %t1 = fenv_convert sitofp f32 i32 16777217
    return f32 %t1
}
function @narrow_double() -> f32 [linkage=c, binding=strong] {
  block ^entry:
    %t1 = fenv_convert fptrunc f32 f64 1.0000000596046447754
    return f32 %t1
}
function @discard_invalid_conversion() -> void [linkage=c, binding=strong] {
  slot $infinite : f64

  block ^entry:
    store volatile f64 inf, $infinite
    %t1 = load volatile f64 $infinite
    %t2 = fenv_convert fptosi i32 f64 %t1
    return void
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $up_integer : f32
  slot $up_narrow : f32
  slot $down_integer : f32
  slot $down_narrow : f32

  block ^entry:
    %t1 = load typed f32 @static_halfway
    %t2 = fenv_cmp ne f32 %t1, 1f
    %t3 = convert trunc i32 i64 %t2
    branch %t3, ^if_then_1, ^if_else_2

  block ^if_then_1:
    return i32 1

  block ^if_else_2:
    jump ^if_end_3

  block ^if_end_3:
    %t4 = call i32 @fesetround(2048)
    %t5 = cmp ne i32 %t4, 0
    %t6 = convert trunc i32 i64 %t5
    branch %t6, ^if_then_4, ^if_else_5

  block ^if_then_4:
    return i32 2

  block ^if_else_5:
    jump ^if_end_6

  block ^if_end_6:
    %t7 = call f32 @round_integer()
    store volatile f32 %t7, $up_integer
    %t8 = call f32 @narrow_double()
    store volatile f32 %t8, $up_narrow
    %t9 = call i32 @fesetround(1024)
    %t10 = cmp ne i32 %t9, 0
    %t11 = convert trunc i32 i64 %t10
    branch %t11, ^if_then_7, ^if_else_8

  block ^if_then_7:
    return i32 3

  block ^if_else_8:
    jump ^if_end_9

  block ^if_end_9:
    %t12 = call f32 @round_integer()
    store volatile f32 %t12, $down_integer
    %t13 = call f32 @narrow_double()
    store volatile f32 %t13, $down_narrow
    %t14 = call i32 @fesetround(0)
    %t15 = cmp ne i32 %t14, 0
    %t16 = convert trunc i32 i64 %t15
    branch %t16, ^if_then_10, ^if_else_11

  block ^if_then_10:
    return i32 4

  block ^if_else_11:
    jump ^if_end_12

  block ^if_end_12:
    %t17 = load volatile f32 $up_integer
    %t18 = fenv_cmp ne f32 %t17, 16777218f
    %t19 = convert trunc i32 i64 %t18
    branch %t19, ^if_then_13, ^lor_rhs_17

  block ^lor_rhs_17:
    %t20 = load volatile f32 $up_narrow
    %t21 = fenv_cmp ne f32 %t20, 1.0000001192092895508f
    %t22 = convert trunc i32 i64 %t21
    branch %t22, ^if_then_13, ^lor_rhs_16

  block ^lor_rhs_16:
    %t23 = load volatile f32 $down_integer
    %t24 = fenv_cmp ne f32 %t23, 16777216f
    %t25 = convert trunc i32 i64 %t24
    branch %t25, ^if_then_13, ^lor_rhs_15

  block ^lor_rhs_15:
    %t26 = load volatile f32 $down_narrow
    %t27 = fenv_cmp ne f32 %t26, 1f
    %t28 = convert trunc i32 i64 %t27
    branch %t28, ^if_then_13, ^if_else_14

  block ^if_then_13:
    return i32 5

  block ^if_else_14:
    jump ^if_end_18

  block ^if_end_18:
    %t29 = binary or i32 32, 4
    %t30 = binary or i32 %t29, 16
    %t31 = binary or i32 %t30, 8
    %t32 = binary or i32 %t31, 1
    %t33 = call i32 @feclearexcept(%t32)
    %t34 = cmp ne i32 %t33, 0
    %t35 = convert trunc i32 i64 %t34
    branch %t35, ^if_then_19, ^if_else_20

  block ^if_then_19:
    return i32 6

  block ^if_else_20:
    jump ^if_end_21

  block ^if_end_21:
    call void @discard_invalid_conversion()
    %t36 = call i32 @fetestexcept(1)
    %t37 = binary and i32 %t36, 1
    %t38 = cmp eq i32 %t37, 0
    %t39 = convert trunc i32 i64 %t38
    return i32 %t39
}
