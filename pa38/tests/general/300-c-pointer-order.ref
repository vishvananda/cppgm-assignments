    %t16 = addr @identity
    store typed ptr %t16, $function
    %t17 = load typed ptr $first
    %t18 = load typed ptr $last
    %t19 = cmp ult ptr %t17, %t18
    %t20 = convert trunc i32 i64 %t19
    %t21 = cmp eq i32 %t20, 0
    %t22 = convert trunc i32 i64 %t21
    branch %t22, ^lor_short_2, ^lor_rhs_1

  block ^lor_rhs_1:
    %t23 = load typed ptr $last
