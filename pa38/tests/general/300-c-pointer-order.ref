  block ^entry:
    %t1 = addr $rows
    copyobj 36x4 @__constexpr_template__1, %t1
    %t2 = addr $rows
    store typed ptr %t2, $first
    %t3 = addr $rows
    %t4 = binary mul i64 2, 12
    %t5 = index inbounds i8 %t3, %t4
