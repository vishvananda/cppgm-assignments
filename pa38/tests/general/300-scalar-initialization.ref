global @values [linkage=c, binding=strong] = {
  u8 1
  zero 3
  f32 1.2345678806304931641f
  u32 4294967295
}

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $small : u8
  slot $index : u32
  slot $land__1 : i64
  slot $land__2 : i64
  slot $land__3 : i64

  block ^entry:
    store u8 2, $small
    store typed u32 0, $index
    %t1 = load typed u32 $index
    %t2 = binary add u32 %t1, 1
    store typed u32 %t2, $index
    %t3 = load typed u32 $index
    %t4 = binary add u32 %t3, 1
    store typed u32 %t4, $index
    %t5 = addr @values
    %t6 = index inbounds i8 [projection=field] %t5, 0
    %t7 = load u8 %t6
    %t8 = convert zext i32 u8 %t7
    %t9 = cmp eq i32 %t8, 1
    %t10 = convert trunc i32 i64 %t9
    branch %t10, ^land_rhs_1, ^land_short_2

  block ^land_rhs_1:
    %t11 = load u8 $small
    %t12 = convert zext i32 u8 %t11
    %t13 = cmp eq i32 %t12, 2
    %t14 = convert trunc i32 i64 %t13
    %t15 = cmp ne i32 %t14, 0
    store typed i64 %t15, $land__1
    jump ^land_end_3

  block ^land_short_2:
    store typed i64 0, $land__1
    jump ^land_end_3

  block ^land_end_3:
    %t16 = load typed i64 $land__1
    branch %t16, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t17 = addr @values
    %t18 = index inbounds i8 [projection=field] %t17, 8
    %t19 = load typed u32 %t18
    %t20 = unary neg i32 1
    %t21 = copy u32 %t20
    %t22 = cmp eq u32 %t19, %t21
    %t23 = convert trunc i32 i64 %t22
    %t24 = cmp ne i32 %t23, 0
    store typed i64 %t24, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store typed i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t25 = load typed i64 $land__2
    branch %t25, ^land_rhs_7, ^land_short_8

  block ^land_rhs_7:
    %t26 = load typed u32 $index
    %t27 = cmp eq u32 %t26, 2
    %t28 = convert trunc i32 i64 %t27
    %t29 = cmp ne i32 %t28, 0
    store typed i64 %t29, $land__3
    jump ^land_end_9

  block ^land_short_8:
    store typed i64 0, $land__3
    jump ^land_end_9

  block ^land_end_9:
    %t30 = load typed i64 $land__3
    %t31 = convert trunc i32 i64 %t30
    %t32 = cmp eq i32 %t31, 0
    %t33 = convert trunc i32 i64 %t32
    return i32 %t33
}
