global @row [linkage=c, binding=internal] = {
  i32 4
  i32 7
  i32 9
}
global @data : ptr [linkage=c, binding=strong] = addr @row
global @scoped : ptr [linkage=c, binding=strong] = addr @row
global @block_first [linkage=c, binding=strong] = {
  i32 11
  i32 0
  i32 13
}

function @first() -> ptr [linkage=c, binding=strong] {
  block ^entry:
    %t1 = load typed ptr @data
    return ptr %t1
}
function @read_scoped() -> i32 [linkage=c, binding=internal] {
  block ^entry:
    %t1 = load typed ptr @scoped
    %t2 = index inbounds i32 [projection=array_element] %t1, 1
    %t3 = load typed i32 %t2
    return i32 %t3
}
function @read_first_block() -> i32 [linkage=c, binding=internal] {
  block ^entry:
    %t1 = addr @block_first
