    %t3 = load typed i32 %t2
    return i32 %t3
}
function @read(%value : ptr) -> i32 [linkage=c, binding=strong] {
  slot $value : ptr

  block ^entry:
    store typed ptr %value, $value
    %t1 = load typed ptr $value
    %t2 = index inbounds i32 [projection=array_element] %t1, 2
    %t3 = load typed i32 %t2
    return i32 %t3
}
function @combine(%callback : ptr, %value : ptr) -> i32 [linkage=c, binding=strong] {
  slot $callback : ptr
  slot $value : ptr

  block ^entry:
    store typed ptr %callback, $callback
    store typed ptr %value, $value
    %t1 = load typed ptr $value
    %t2 = index inbounds i32 [projection=array_element] %t1, 1
    %t3 = load typed ptr $callback
    %t4 = call i32 %t3(%t2) as (%arg0 : ptr) -> i32
    return i32 %t4
}
function @get() -> ptr [linkage=c, binding=strong] {
  block ^entry:
    %t1 = addr @row
    return ptr %t1
}
function @load(%value : ptr) -> i32 [linkage=c, binding=internal] {
  slot $value : ptr

  block ^entry:
    store typed ptr %value, $value
    %t1 = load typed ptr $value
    %t2 = load typed i32 %t1
    return i32 %t2
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $land__1 : i64
  slot $land__2 : i64
  slot $land__3 : i64
  slot $land__4 : i64
  slot $land__5 : i64
  slot $land__6 : i64

  block ^entry:
    %t1 = call ptr @first()
    %t2 = addr @row
    %t3 = cmp eq ptr %t1, %t2
    %t4 = convert trunc i32 i64 %t3
    branch %t4, ^land_rhs_1, ^land_short_2

  block ^land_rhs_1:
    %t5 = call i32 @read_scoped()
    %t6 = cmp eq i32 %t5, 7
    %t7 = convert trunc i32 i64 %t6
    %t8 = cmp ne i32 %t7, 0
    store typed i64 %t8, $land__1
    jump ^land_end_3

  block ^land_short_2:
    store typed i64 0, $land__1
    jump ^land_end_3

  block ^land_end_3:
    %t9 = load typed i64 $land__1
    branch %t9, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t10 = call i32 @read_first_block()
    %t11 = cmp eq i32 %t10, 13
    %t12 = convert trunc i32 i64 %t11
    %t13 = cmp ne i32 %t12, 0
    store typed i64 %t13, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store typed i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t14 = load typed i64 $land__2
    branch %t14, ^land_rhs_7, ^land_short_8

  block ^land_rhs_7:
    %t15 = call i32 @read_second_block()
    %t16 = cmp eq i32 %t15, 11
    %t17 = convert trunc i32 i64 %t16
    %t18 = cmp ne i32 %t17, 0
    store typed i64 %t18, $land__3
    jump ^land_end_9

  block ^land_short_8:
    store typed i64 0, $land__3
    jump ^land_end_9

  block ^land_end_9:
    %t19 = load typed i64 $land__3
    branch %t19, ^land_rhs_10, ^land_short_11

  block ^land_rhs_10:
    %t20 = addr @row
    %t21 = call i32 @read(%t20)
    %t22 = cmp eq i32 %t21, 9
    %t23 = convert trunc i32 i64 %t22
    %t24 = cmp ne i32 %t23, 0
    store typed i64 %t24, $land__4
    jump ^land_end_12

  block ^land_short_11:
