    store typed i64 0, $land__5
    jump ^land_end_15

  block ^land_end_15:
    %t32 = load typed i64 $land__5
    branch %t32, ^land_rhs_16, ^land_short_17

  block ^land_rhs_16:
    %t33 = call ptr @get()
    %t34 = index inbounds i32 [projection=array_element] %t33, 0
    %t35 = load typed i32 %t34
    %t36 = cmp eq i32 %t35, 4
    %t37 = convert trunc i32 i64 %t36
    %t38 = cmp ne i32 %t37, 0
    store typed i64 %t38, $land__6
    jump ^land_end_18

  block ^land_short_17:
    store typed i64 0, $land__6
    jump ^land_end_18

  block ^land_end_18:
    %t39 = load typed i64 $land__6
    %t40 = convert trunc i32 i64 %t39
    %t41 = cmp eq i32 %t40, 0
    %t42 = convert trunc i32 i64 %t41
