    jump ^land_end_12

  block ^land_end_12:
    %t25 = load typed i64 $land__4
    branch %t25, ^land_rhs_13, ^land_short_14

  block ^land_rhs_13:
    %t26 = addr @load
    %t27 = addr @row
    %t28 = call i32 @combine(%t26, %t27)
    %t29 = cmp eq i32 %t28, 7
    %t30 = convert trunc i32 i64 %t29
    %t31 = cmp ne i32 %t30, 0
    store typed i64 %t31, $land__5
