    %t8 = call i32 @callback(%t6, %t7)
    %t9 = cmp ne i32 %t8, 7
    %t10 = convert trunc i32 i64 %t9
    %t11 = cmp ne i32 %t10, 0
    store typed i64 %t11, $lor__1
    jump ^lor_end_3

  block ^lor_short_2:
