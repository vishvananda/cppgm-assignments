    %t3 = call i32 %t2(%t1) as (%arg0 : ptr) -> i32
    return i32 %t3
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $values : obj<8x4>
  slot $lor__1 : i64

  block ^entry:
    %t1 = addr $values
    copyobj 8x4 @__constexpr_template__1, %t1
    %t2 = addr $values
    %t3 = call i32 @first(%t2)
    %t4 = cmp ne i32 %t3, 7
    %t5 = convert trunc i32 i64 %t4
    branch %t5, ^lor_short_2, ^lor_rhs_1

  block ^lor_rhs_1:
