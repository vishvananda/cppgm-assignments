global @value : i32 [storage=readonly, linkage=c, binding=strong] = 12
global @flag : i32 [linkage=c, binding=strong] = zero

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    store volatile i32 12, @flag
    %t1 = load volatile i32 @flag
    %t2 = cmp ne i32 %t1, 12
    %t3 = convert trunc i32 i64 %t2
    return i32 %t3
}
