function @bump(%count : ptr) -> i32 [linkage=c, binding=internal] {
  slot $count : ptr

  block ^entry:
    store typed ptr %count, $count
    %t1 = load typed ptr $count
    %t2 = load typed i32 %t1
    %t3 = binary add nowrap i32 %t2, 1
    store typed i32 %t3, %t1
    return i32 %t3
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $effects : i32
  slot $array : obj<12x4>
  slot $lor__1 : i64

  block ^entry:
    store typed i32 0, $effects
    %t1 = addr $array
    zeroinit 12x4 %t1
    %t2 = cmp ne i32 1, 1
    %t3 = convert trunc i32 i64 %t2
    branch %t3, ^if_then_1, ^lor_rhs_11

  block ^lor_rhs_11:
    %t4 = load typed i32 $effects
    %t5 = cmp ne i32 %t4, 0
    %t6 = convert trunc i32 i64 %t5
    branch %t6, ^if_then_1, ^lor_rhs_10

  block ^lor_rhs_10:
    %t7 = cmp ne i32 1, 1
    %t8 = convert trunc i32 i64 %t7
    branch %t8, ^if_then_1, ^lor_rhs_9

  block ^lor_rhs_9:
    %t9 = cmp ne i32 4, 4
    %t10 = convert trunc i32 i64 %t9
    branch %t10, ^if_then_1, ^lor_rhs_8

  block ^lor_rhs_8:
    %t11 = cmp ne i32 3, 3
    %t12 = convert trunc i32 i64 %t11
    branch %t12, ^if_then_1, ^lor_rhs_7

  block ^lor_rhs_7:
    %t13 = cmp ne i32 5, 5
    %t14 = convert trunc i32 i64 %t13
    branch %t14, ^if_then_1, ^lor_rhs_6

  block ^lor_rhs_6:
    %t15 = cmp ne i32 14, 14
    %t16 = convert trunc i32 i64 %t15
    branch %t16, ^if_then_1, ^lor_rhs_5

  block ^lor_rhs_5:
    %t17 = cmp ne i32 14, 14
    %t18 = convert trunc i32 i64 %t17
    branch %t18, ^if_then_1, ^lor_rhs_4

  block ^lor_rhs_4:
    %t19 = cmp ne i32 9, 9
    %t20 = convert trunc i32 i64 %t19
    branch %t20, ^if_then_1, ^lor_rhs_3

  block ^lor_rhs_3:
    %t21 = load typed i32 $effects
    %t22 = cmp ne i32 %t21, 0
    %t23 = convert trunc i32 i64 %t22
    branch %t23, ^if_then_1, ^if_else_2

  block ^if_then_1:
    return i32 1

  block ^if_else_2:
    jump ^if_end_12

  block ^if_end_12:
    %t24 = addr $effects
    %t25 = call i32 @bump(%t24)
    %t26 = addr $effects
    %t27 = call i32 @bump(%t26)
    %t28 = cmp ne i32 1, 1
    %t29 = convert trunc i32 i64 %t28
    branch %t29, ^lor_short_14, ^lor_rhs_13

  block ^lor_rhs_13:
    %t30 = load typed i32 $effects
    %t31 = cmp ne i32 %t30, 2
    %t32 = convert trunc i32 i64 %t31
    %t33 = cmp ne i32 %t32, 0
    store typed i64 %t33, $lor__1
    jump ^lor_end_15

  block ^lor_short_14:
    store typed i64 1, $lor__1
    jump ^lor_end_15

  block ^lor_end_15:
    %t34 = load typed i64 $lor__1
    %t35 = convert trunc i32 i64 %t34
    return i32 %t35
}
