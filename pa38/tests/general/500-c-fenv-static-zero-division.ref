declare function @fetestexcept(%arg0 : i32) -> i32 [linkage=c, binding=strong]

global @nan_value : f32 [linkage=c, binding=internal] = nanf
global @positive_inf : f64 [linkage=c, binding=internal] = inf
global @negative_inf : f64 [linkage=c, binding=internal] = -inf
global @wide_nan : f80 [linkage=c, binding=internal] = nanL
global @wide_inf : f80 [linkage=c, binding=internal] = -INFINITYL

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $floating_signbit__1 : f64
  slot $floating_signbit__2 : f64
  slot $floating_signbit__3 : f80
  slot $zero : f32

  block ^entry:
    %t1 = load volatile f32 @nan_value
    %t2 = fenv_cmp ne f32 %t1, %t1
    %t3 = convert trunc i32 i64 %t2
    %t4 = cmp eq i32 %t3, 0
    %t5 = convert trunc i32 i64 %t4
    branch %t5, ^if_then_1, ^lor_rhs_3

  block ^lor_rhs_3:
    %t6 = load volatile f80 @wide_nan
    %t7 = fenv_cmp ne f80 %t6, %t6
    %t8 = convert trunc i32 i64 %t7
    %t9 = cmp eq i32 %t8, 0
    %t10 = convert trunc i32 i64 %t9
    branch %t10, ^if_then_1, ^if_else_2

  block ^if_then_1:
    return i32 1

  block ^if_else_2:
    jump ^if_end_4

  block ^if_end_4:
    %t11 = load volatile f64 @positive_inf
    %t12 = unary neg f64 inf
    %t13 = fenv_cmp eq f64 %t11, inf
    %t14 = convert trunc i32 i64 %t13
    %t15 = fenv_cmp eq f64 %t11, %t12
    %t16 = convert trunc i32 i64 %t15
    %t17 = binary or i32 %t14, %t16
    store typed f64 %t11, $floating_signbit__1
    %t18 = addr $floating_signbit__1
    %t19 = load typed i64 %t18
    %t20 = cmp lt i64 %t19, 0
    %t21 = convert trunc i32 i64 %t20
    %t22 = binary and i32 %t17, %t21
    %t23 = binary add i32 %t22, %t22
    %t24 = binary sub i32 %t17, %t23
    %t25 = cmp ne i32 %t24, 1
    %t26 = convert trunc i32 i64 %t25
    branch %t26, ^if_then_5, ^lor_rhs_8

  block ^lor_rhs_8:
    %t27 = load volatile f64 @negative_inf
    %t28 = unary neg f64 inf
    %t29 = fenv_cmp eq f64 %t27, inf
    %t30 = convert trunc i32 i64 %t29
    %t31 = fenv_cmp eq f64 %t27, %t28
    %t32 = convert trunc i32 i64 %t31
    %t33 = binary or i32 %t30, %t32
    store typed f64 %t27, $floating_signbit__2
    %t34 = addr $floating_signbit__2
    %t35 = load typed i64 %t34
    %t36 = cmp lt i64 %t35, 0
    %t37 = convert trunc i32 i64 %t36
    %t38 = binary and i32 %t33, %t37
    %t39 = binary add i32 %t38, %t38
    %t40 = binary sub i32 %t33, %t39
    %t41 = unary neg i32 1
    %t42 = cmp ne i32 %t40, %t41
    %t43 = convert trunc i32 i64 %t42
    branch %t43, ^if_then_5, ^lor_rhs_7

  block ^lor_rhs_7:
    %t44 = load volatile f80 @wide_inf
    %t45 = unary neg f80 INFINITYL
    %t46 = fenv_cmp eq f80 %t44, INFINITYL
    %t47 = convert trunc i32 i64 %t46
    %t48 = fenv_cmp eq f80 %t44, %t45
    %t49 = convert trunc i32 i64 %t48
    %t50 = binary or i32 %t47, %t49
    store typed f80 %t44, $floating_signbit__3
    %t51 = addr $floating_signbit__3
    %t52 = binary mul i64 4, 2
    %t53 = index i8 [projection=array_element] %t51, %t52
    %t54 = load typed i16 %t53
    %t55 = cmp lt i16 %t54, 0
    %t56 = convert trunc i32 i64 %t55
    %t57 = binary and i32 %t50, %t56
    %t58 = binary add i32 %t57, %t57
    %t59 = binary sub i32 %t50, %t58
    %t60 = unary neg i32 1
    %t61 = cmp ne i32 %t59, %t60
    %t62 = convert trunc i32 i64 %t61
    branch %t62, ^if_then_5, ^if_else_6

  block ^if_then_5:
    return i32 2

  block ^if_else_6:
    jump ^if_end_9

  block ^if_end_9:
    %t63 = binary or i32 1, 4
    %t64 = call i32 @fetestexcept(%t63)
    branch %t64, ^if_then_10, ^if_else_11

  block ^if_then_10:
    return i32 3

  block ^if_else_11:
    jump ^if_end_12

  block ^if_end_12:
    store volatile f32 0f, $zero
    %t65 = load volatile f32 $zero
    %t66 = load volatile f32 $zero
    %t67 = fenv_binary div f32 %t65, %t66
    %t68 = fenv_cmp ne f32 %t67, %t67
    %t69 = convert trunc i32 i64 %t68
    %t70 = cmp eq i32 %t69, 0
    %t71 = convert trunc i32 i64 %t70
    branch %t71, ^if_then_13, ^lor_rhs_15

  block ^lor_rhs_15:
    %t72 = call i32 @fetestexcept(1)
    %t73 = binary and i32 %t72, 1
    %t74 = cmp eq i32 %t73, 0
    %t75 = convert trunc i32 i64 %t74
    branch %t75, ^if_then_13, ^if_else_14

  block ^if_then_13:
    return i32 4

  block ^if_else_14:
    jump ^if_end_16

  block ^if_end_16:
    return i32 0
}
