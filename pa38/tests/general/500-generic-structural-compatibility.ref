function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $array : ptr
  slot $pointer : ptr
  slot $land__1 : i64

  block ^entry:
    store typed ptr 0, $array
    store typed ptr 0, $pointer
    branch 1, ^land_rhs_1, ^land_short_2

  block ^land_rhs_1:
    %t1 = cmp ne i32 1, 0
    store typed i64 %t1, $land__1
    jump ^land_end_3

  block ^land_short_2:
    store typed i64 0, $land__1
    jump ^land_end_3

  block ^land_end_3:
    %t2 = load typed i64 $land__1
    %t3 = convert trunc i32 i64 %t2
    %t4 = cmp eq i32 %t3, 0
    %t5 = convert trunc i32 i64 %t4
    return i32 %t5
}
