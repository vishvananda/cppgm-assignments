function @add_one(%value : i32) -> i32 [linkage=c, binding=internal] {
  slot $value : i32

  block ^entry:
    store typed i32 %value, $value
    %t1 = load typed i32 $value
    %t2 = binary add nowrap i32 %t1, 1
    return i32 %t2
}
function @invoke(%callback : ptr, %value : i32) -> i32 [linkage=c, binding=internal] {
  slot $callback : ptr
  slot $value : i32

  block ^entry:
    store typed ptr %callback, $callback
    store typed i32 %value, $value
    %t1 = load typed i32 $value
    %t2 = load typed ptr $callback
    %t3 = call i32 %t2(%t1) as (%arg0 : i32) -> i32
    return i32 %t3
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $callback : ptr
  slot $lor__1 : i64
  slot $lor__2 : i64

  block ^entry:
    %t1 = addr @add_one
    store typed ptr %t1, $callback
    %t2 = load typed ptr $callback
    %t3 = call i32 @invoke(%t2, 5)
    %t4 = cmp ne i32 %t3, 6
    %t5 = convert trunc i32 i64 %t4
    branch %t5, ^lor_short_2, ^lor_rhs_1

  block ^lor_rhs_1:
    %t6 = load typed ptr $callback
    %t7 = call i32 %t6(6) as (%arg0 : i32) -> i32
    %t8 = cmp ne i32 %t7, 7
    %t9 = convert trunc i32 i64 %t8
    %t10 = cmp ne i32 %t9, 0
    store typed i64 %t10, $lor__1
    jump ^lor_end_3

  block ^lor_short_2:
    store typed i64 1, $lor__1
    jump ^lor_end_3

  block ^lor_end_3:
    %t11 = load typed i64 $lor__1
    branch %t11, ^lor_short_5, ^lor_rhs_4

  block ^lor_rhs_4:
    %t12 = load typed ptr $callback
    %t13 = call i32 %t12(7) as (%arg0 : i32) -> i32
    %t14 = cmp ne i32 %t13, 8
    %t15 = convert trunc i32 i64 %t14
    %t16 = cmp ne i32 %t15, 0
    store typed i64 %t16, $lor__2
    jump ^lor_end_6

  block ^lor_short_5:
    store typed i64 1, $lor__2
    jump ^lor_end_6

  block ^lor_end_6:
    %t17 = load typed i64 $lor__2
    %t18 = convert trunc i32 i64 %t17
    return i32 %t18
}
