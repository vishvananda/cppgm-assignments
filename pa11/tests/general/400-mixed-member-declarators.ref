    %t31 = load i32 %t17
    %t32 = binary and i32 %t31, -16
    %t33 = binary or i32 %t32, %t29
    store i32 %t33, %t17
    %t34 = addr $reg
    %t35 = call u32 @Register__read(%t34)
    %t36 = cmp ne u32 %t35, 25
    branch %t36, ^lor_short_2, ^lor_rhs_1

  block ^lor_rhs_1:
    %t37 = addr $state
