function @Register__read(%this : ptr [object_bytes=12]) -> u32 [binding=strong, object=_ZNK8Register4readEv] {
  slot $this : ptr

  block ^entry:
    store typed ptr %this, $this
    %t1 = load typed ptr $this
    %t2 = index inbounds i8 [projection=field] %t1, 0
    %t3 = load i32 %t2
    %t4 = binary and i32 %t3, 7
    %t5 = copy u32 %t4
    %t6 = load typed ptr $this
    %t7 = index inbounds i8 [projection=field] %t6, 4
    %t8 = load typed u32 %t7
    %t9 = binary add u32 %t5, %t8
    %t10 = load typed ptr $this
    %t11 = index inbounds i8 [projection=field] %t10, 8
    %t12 = load i32 %t11
    %t13 = binary and i32 %t12, 15
    %t14 = copy u32 %t13
    %t15 = binary add u32 %t9, %t14
    return u32 %t15
}
