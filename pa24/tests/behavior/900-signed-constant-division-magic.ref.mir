machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @div3
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, rdi
    mov r11, 6148914691236517206
    imul r11
    mov rax, rdx
    shr rax, 63
    add rdx, rax
    ret rdx

