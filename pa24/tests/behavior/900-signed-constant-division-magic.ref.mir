function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14 r15
    temp %bad_q_narrow3 -> [rbp-8] : i64

  block ^entry
    mov rdi, -9223372036854775808
    call @div3 [args=(rdi)]
    cmp.i64 rax, -3074457345618258602
    setne rbx
    movzx rbx, rbx
    mov rdi, 9223372036854775807
    call @div7 [args=(rdi)]
    cmp.i64 rax, 1317624576693539401
    setne r12
    movzx r12, r12
    mov rdi, 9223372036854775807
    call @div_large [args=(rdi)]
    cmp.i64 rax, 4294967298
    setne r13
    movzx r13, r13
    mov rdi, -9223372036854775808
    call @div_negative3 [args=(rdi)]
    cmp.i64 rax, 3074457345618258602
    setne r14
    movzx r14, r14
    mov rdi, 9223372036854775807
    call @div_negative5 [args=(rdi)]
    cmp.i64 rax, -1844674407370955161
    setne r15
    movzx r15, r15
    mov rdi, -128
    call @div_narrow3 [args=(rdi)]
    cmp.i8 rax, -42
    setne r10
    movzx r10, r10
    store.i64 [rbp-8], r10
    mov rdi, 127
    call @div_narrow_negative3 [args=(rdi)]
    cmp.i8 rax, -42
    setne rax
    movzx rax, rax
    or rbx, r12
    or r13, r14
    or r15, [rbp-8]
    or r15, rax
    or rbx, r13
    or rbx, r15
    sext.i32 rbx
    ret rbx
