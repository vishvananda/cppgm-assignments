machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $bytes -> [rbp-8] : obj<8x1>

  block ^entry
    store.i8 [rbp-8], 65
    mov r10, 200
    mov rax, r10
    shr rax, 2
    mov r11, 2951479051793528259
    mul r11
    shr rdx, 2
    sext.i8 rdx
    store.i8 [rbp-7], rdx
    load.i8 r8, [rbp-7]
    zext.i8 r8
    cmp.i32 r8, 2
    sete r8
    movzx r8, r8
    cmp.i32 r8, 0
    sete r8
    movzx r8, r8
    ret r8
