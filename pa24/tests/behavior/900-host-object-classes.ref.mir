machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @low
  storage scalar f64
  init f64 0.0

global @wide
  storage data
  item i64 1
  item i64 2
  item i64 3
  item i64 4
  item i64 5
  item i64 6

function @x87_result
  abi
    param %v -> [rbp+16] : f80
    return obj<16x16> -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $home -> [rbp-16] : obj<16x16>

  block ^entry
    fmov.f80 [rbp-16], [rbp+16]
    fret.f80 [rbp-16]

function @f80_result
  abi
    return f80 -> st0
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    fret.f80 2.25L

function @complex_result
  abi
    param %re -> [rbp+16] : f80
    param %im -> [rbp+32] : f80
    return obj<32x16> -> [rax]
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $home -> [rbp-32] : obj<32x16>

  block ^entry
    fmov.f80 [rbp-32], [rbp+16]
    fmov.f80 [rbp-16], [rbp+32]
    fret.f80 [rbp-32], [rbp-16]

function @memory_result
  abi
    param %a -> rsi : i64
    param %b -> rdx : i64
    return obj<16x8> -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $home -> [rbp-16] : obj<16x8>

  block ^entry
    store.ptr [rbp-24], rdi
    store.i64 [rbp-16], rsi
    store.i64 [rbp-8], rdx
    load.ptr rax, [rbp-24]
    copy_bytes 16x8, rax, [rbp-16]
    ret rax

function @sseup_argument
  abi
    param %x -> xmm0 : obj<16x16>
    param %y -> xmm1 : f64
    return f64 -> xmm0
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $home -> [rbp-16] : obj<16x16>
    param-slot %x -> [rbp-16] : obj<16x16>
    param-slot %y -> [rbp-24] : f64

  block ^entry
    fmov.i128 [rbp-16], xmm0
    fmov.f64 [rbp-24], xmm1
    fmov.f64 xmm0, [rbp-16]
    fmov.f64 @low, xmm0
    fmov.f64 xmm0, [rbp-24]
    ret xmm0

function @sseup_result
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    return obj<16x16> -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $home -> [rbp-16] : obj<16x16>

  block ^entry
    store.i64 [rbp-16], rdi
    store.i64 [rbp-8], rsi
    fmov.i128 xmm0, [rbp-16]
    ret

function @read_scalars
  abi
    param %n -> rdi : i32
    return i32 -> rax
  frame
    stack_size 208
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $list -> [rbp-24] : obj<24x8>
    temp %va-register-save -> [rbp-208] : obj<176x16>

  block ^entry
    store.i64 [rbp-208], rdi
    store.i64 [rbp-200], rsi
    store.i64 [rbp-192], rdx
    store.i64 [rbp-184], rcx
    store.i64 [rbp-176], r8
    store.i64 [rbp-168], r9
    fmov.i128 [rbp-160], xmm0
    fmov.i128 [rbp-144], xmm1
    fmov.i128 [rbp-128], xmm2
    fmov.i128 [rbp-112], xmm3
    fmov.i128 [rbp-96], xmm4
    fmov.i128 [rbp-80], xmm5
    fmov.i128 [rbp-64], xmm6
    fmov.i128 [rbp-48], xmm7
    va_start [rbp-24], [rbp-208]
    va_arg.f64 xmm0, [rbp-24]
    va_arg.i64 r8, [rbp-24]
    feq.f64 r9, xmm0, 0.5
    cmp.i64 r8, 7
    sete r8
    movzx r8, r8
    and r9, r8
    ret r9

