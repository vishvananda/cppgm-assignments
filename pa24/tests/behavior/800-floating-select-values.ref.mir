function @lt_f64
  abi
    param %x -> xmm0 : f64
    param %y -> xmm1 : f64
    param %a -> xmm2 : f64
    param %b -> xmm3 : f64
    return f64 -> xmm0
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    param-slot %x -> [rbp-8] : f64
    param-slot %y -> [rbp-16] : f64
    param-slot %a -> [rbp-24] : f64
    param-slot %b -> [rbp-32] : f64

  block ^entry
    fmov.f64 [rbp-8], xmm0
    fmov.f64 [rbp-16], xmm1
    fmov.f64 [rbp-24], xmm2
    fmov.f64 [rbp-32], xmm3
    fmov.f64 xmm15, [rbp-8]
    fmov.f64 xmm14, [rbp-16]
    vector.cmppd xmm15, xmm15, xmm14, 1
    fmov.f64 xmm14, [rbp-32]
    fmov.f64 xmm0, [rbp-24]
    vector.pxor xmm0, xmm0, xmm14
    vector.pand xmm0, xmm0, xmm15
    vector.pxor xmm0, xmm0, xmm14
    ret xmm0

