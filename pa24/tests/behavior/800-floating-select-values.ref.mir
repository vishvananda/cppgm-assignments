function @table_f64
  abi
    param %test -> rdi : ptr
    param %nan -> xmm0 : f64
    return i64 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12
    param-slot %nan -> [rbp-8] : f64

  block ^entry
    mov rbx, rdi
    fmov.f64 [rbp-8], xmm0
    fmov.f64 xmm0, 1.0
