machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12

  block ^entry
    mov r10, 100
    mov r8, r10
    shr r8, 63
    add r8, r10
    sar r8, 1
    neg r8
    cmp.i64 r8, -50
    setne r8
    movzx r8, r8
    mov r10, -99
    mov r9, r10
    sar r9, 63
    shr r9, 62
    add r9, r10
    sar r9, 2
    neg r9
    cmp.i64 r9, 24
    setne r9
    movzx r9, r9
    mov r10, -99
    mov rdi, r10
    sar rdi, 63
    shr rdi, 62
    add rdi, r10
    and rdi, -4
    neg rdi
    add rdi, r10
    cmp.i64 rdi, -3
    setne rdi
    movzx rdi, rdi
    mov r11, -9223372036854775808
    mov rax, -9223372036854775808
    cqo
    idiv r11
    cmp.i64 rax, 1
    setne rsi
    movzx rsi, rsi
    mov r11, -9223372036854775808
    mov rax, 9223372036854775807
    cqo
    idiv r11
    cmp.i64 rdx, 9223372036854775807
    setne rcx
    movzx rcx, rcx
    mov r10, -100
    mov rax, r10
    mov r11, -5270498306774157605
    imul r11
    sar rdx, 1
    mov rax, rdx
    shr rax, 63
    add rdx, rax
    cmp.i64 rdx, 14
    setne rbx
    movzx rbx, rbx
    mov r10, -100
    mov rax, r10
    mov r11, -5270498306774157605
    imul r11
    sar rdx, 1
    mov rax, rdx
    shr rax, 63
    add rdx, rax
    imul rdx, -7
    mov rax, r10
    sub rax, rdx
    cmp.i64 rax, -2
    setne r12
    movzx r12, r12
    mov r11, -1
    mov rax, 100
    cqo
    idiv r11
    cmp.i64 rax, -100
    setne rax
    movzx rax, rax
    or r8, r9
    or rdi, rsi
    or rcx, rbx
    or r12, rax
    or r8, rdi
    or rcx, r12
    or r8, rcx
    sext.i32 r8
    ret r8
