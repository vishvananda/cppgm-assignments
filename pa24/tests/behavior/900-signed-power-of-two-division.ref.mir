machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @div2
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r11, rdi
    shr r11, 63
    add rdi, r11
    sar rdi, 1
    ret rdi

function @mod8
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r11, rdi
    sar r11, 63
    shr r11, 61
    add r11, rdi
    and r11, -8
    sub rdi, r11
    ret rdi

