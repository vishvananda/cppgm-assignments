machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $source -> [rbp-8] : obj<8x8>
    slot $destination -> [rbp-16] : obj<8x8>

  block ^entry
    store.i64 [rbp-8], 7
    mov r10, 96
    mov r8, r10
    sar r8, 63
    shr r8, 59
    add r8, r10
    sar r8, 5
    copy_bytes 8x8, [rbp-16], [rbp-8]
    load.i64 r9, [rbp-16]
    add r8, 30
    add r8, r9
    cmp.i64 r8, 40
    setne r8
    movzx r8, r8
    ret r8
