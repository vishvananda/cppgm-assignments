function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $lor__1 : i64
  slot $lor__2 : i64

  block ^entry:
    %t1 = cmp eq u8 1, 0
    branch %t1, ^lor_short_2, ^lor_rhs_1

  block ^lor_rhs_1:
    %t2 = cmp ne u8 0, 0
    store typed i64 %t2, $lor__1
    jump ^lor_end_3

  block ^lor_short_2:
    store typed i64 1, $lor__1
    jump ^lor_end_3

  block ^lor_end_3:
    %t3 = load typed i64 $lor__1
    branch %t3, ^lor_short_5, ^lor_rhs_4

  block ^lor_rhs_4:
    %t4 = const i64 1
    %t5 = const i64 1
    %t6 = cmp ne i64 %t4, %t5
    store typed i64 %t6, $lor__2
    jump ^lor_end_6

  block ^lor_short_5:
    store typed i64 1, $lor__2
    jump ^lor_end_6

  block ^lor_end_6:
    %t7 = load typed i64 $lor__2
    %t8 = convert trunc i32 i64 %t7
    return i32 %t8
}
