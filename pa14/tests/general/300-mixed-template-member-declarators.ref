function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $small : obj<8x4>
  slot $large : obj<8x4>
  slot $lor__1 : i64

  block ^entry:
    %t1 = addr $small
    %t2 = addr $small
    %t3 = index inbounds i8 [projection=field] %t2, 0
    store typed u32 17, %t3
    %t4 = addr $small
    %t5 = index inbounds i8 [projection=field] %t4, 4
    %t6 = binary and u32 1, 1
    store u32 %t6, %t5
    %t7 = addr $large
    %t8 = addr $large
    %t9 = index inbounds i8 [projection=field] %t8, 0
    store typed u32 19, %t9
    %t10 = addr $large
    %t11 = index inbounds i8 [projection=field] %t10, 4
    %t12 = binary and u32 255, 37
    store u32 %t12, %t11
    %t13 = addr $small
    %t14 = call u32 @Packet_char___read(%t13)
    %t15 = cmp ne u32 %t14, 18
    branch %t15, ^lor_short_2, ^lor_rhs_1

  block ^lor_rhs_1:
    %t16 = addr $large
    %t17 = call u32 @Packet_unsignedlonglongint___read(%t16)
    %t18 = cmp ne u32 %t17, 56
    store typed i64 %t18, $lor__1
    jump ^lor_end_3

  block ^lor_short_2:
    store typed i64 1, $lor__1
    jump ^lor_end_3

  block ^lor_end_3:
    %t19 = load typed i64 $lor__1
    %t20 = convert trunc i32 i64 %t19
    return i32 %t20
}
function @Packet_char___read(%this : ptr [object_bytes=8]) -> u32 [binding=weak, object=_ZNK6PacketIcE4readEv] {
  slot $this : ptr

  block ^entry:
    store typed ptr %this, $this
    %t1 = load typed ptr $this
    %t2 = index inbounds i8 [projection=field] %t1, 0
    %t3 = load typed u32 %t2
    %t4 = load typed ptr $this
    %t5 = index inbounds i8 [projection=field] %t4, 4
    %t6 = load i32 %t5
    %t7 = binary and i32 %t6, 1
    %t8 = copy u32 %t7
    %t9 = binary add u32 %t3, %t8
    return u32 %t9
}
function @Packet_unsignedlonglongint___read(%this : ptr [object_bytes=8]) -> u32 [binding=weak, object=_ZNK6PacketIyE4readEv] {
  slot $this : ptr

  block ^entry:
    store typed ptr %this, $this
    %t1 = load typed ptr $this
    %t2 = index inbounds i8 [projection=field] %t1, 0
    %t3 = load typed u32 %t2
    %t4 = load typed ptr $this
    %t5 = index inbounds i8 [projection=field] %t4, 4
    %t6 = load i32 %t5
    %t7 = binary and i32 %t6, 255
    %t8 = copy u32 %t7
    %t9 = binary add u32 %t3, %t8
    return u32 %t9
}
