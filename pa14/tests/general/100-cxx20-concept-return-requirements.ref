function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $lor__1 : i64
  slot $lor__2 : i64
  slot $lor__3 : i64
  slot $lor__4 : i64
  slot $lor__5 : i64
  slot $lor__6 : i64
  slot $lor__7 : i64
  slot $lor__8 : i64
  slot $lor__9 : i64

  block ^entry:
    %t1 = cmp eq u8 1, 0
    branch %t1, ^lor_short_2, ^lor_rhs_1

  block ^lor_rhs_1:
    %t2 = cmp ne u8 0, 0
    store typed i64 %t2, $lor__1
    jump ^lor_end_3

  block ^lor_short_2:
    store typed i64 1, $lor__1
    jump ^lor_end_3

  block ^lor_end_3:
    %t3 = load typed i64 $lor__1
    branch %t3, ^lor_short_5, ^lor_rhs_4

  block ^lor_rhs_4:
    %t4 = cmp ne u8 0, 0
    store typed i64 %t4, $lor__2
    jump ^lor_end_6

  block ^lor_short_5:
    store typed i64 1, $lor__2
    jump ^lor_end_6

  block ^lor_end_6:
    %t5 = load typed i64 $lor__2
    branch %t5, ^lor_short_8, ^lor_rhs_7

  block ^lor_rhs_7:
    %t6 = cmp ne u8 0, 0
    store typed i64 %t6, $lor__3
    jump ^lor_end_9

  block ^lor_short_8:
    store typed i64 1, $lor__3
    jump ^lor_end_9

  block ^lor_end_9:
    %t7 = load typed i64 $lor__3
    branch %t7, ^lor_short_11, ^lor_rhs_10

  block ^lor_rhs_10:
    %t8 = cmp ne u8 0, 0
    store typed i64 %t8, $lor__4
    jump ^lor_end_12

  block ^lor_short_11:
    store typed i64 1, $lor__4
    jump ^lor_end_12

  block ^lor_end_12:
    %t9 = load typed i64 $lor__4
    branch %t9, ^lor_short_14, ^lor_rhs_13

  block ^lor_rhs_13:
    %t10 = cmp eq u8 1, 0
    %t11 = cmp ne i64 %t10, 0
    store typed i64 %t11, $lor__5
    jump ^lor_end_15

  block ^lor_short_14:
    store typed i64 1, $lor__5
    jump ^lor_end_15

  block ^lor_end_15:
    %t12 = load typed i64 $lor__5
    branch %t12, ^lor_short_17, ^lor_rhs_16

  block ^lor_rhs_16:
    %t13 = cmp ne u8 0, 0
    store typed i64 %t13, $lor__6
    jump ^lor_end_18

  block ^lor_short_17:
    store typed i64 1, $lor__6
    jump ^lor_end_18

  block ^lor_end_18:
    %t14 = load typed i64 $lor__6
    branch %t14, ^lor_short_20, ^lor_rhs_19

  block ^lor_rhs_19:
    %t15 = cmp eq u8 1, 0
    %t16 = cmp ne i64 %t15, 0
    store typed i64 %t16, $lor__7
    jump ^lor_end_21

  block ^lor_short_20:
    store typed i64 1, $lor__7
    jump ^lor_end_21

  block ^lor_end_21:
    %t17 = load typed i64 $lor__7
    branch %t17, ^lor_short_23, ^lor_rhs_22

  block ^lor_rhs_22:
    %t18 = cmp eq u8 1, 0
    %t19 = cmp ne i64 %t18, 0
    store typed i64 %t19, $lor__8
    jump ^lor_end_24

  block ^lor_short_23:
    store typed i64 1, $lor__8
    jump ^lor_end_24

  block ^lor_end_24:
    %t20 = load typed i64 $lor__8
    branch %t20, ^lor_short_26, ^lor_rhs_25

  block ^lor_rhs_25:
    %t21 = cmp eq u8 1, 0
    %t22 = cmp ne i64 %t21, 0
    store typed i64 %t22, $lor__9
    jump ^lor_end_27

  block ^lor_short_26:
    store typed i64 1, $lor__9
    jump ^lor_end_27

  block ^lor_end_27:
    %t23 = load typed i64 $lor__9
    %t24 = convert trunc i32 i64 %t23
    return i32 %t24
}
