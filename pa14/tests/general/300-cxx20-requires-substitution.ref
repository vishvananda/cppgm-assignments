function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $lor__1 : i64
  slot $lor__2 : i64

  block ^entry:
    %t1 = call u8 @check()
    %t2 = cmp eq u8 %t1, 0
    branch %t2, ^lor_short_2, ^lor_rhs_1

  block ^lor_rhs_1:
    %t3 = call u8 @check__2()
    %t4 = cmp ne u8 %t3, 0
    store typed i64 %t4, $lor__1
    jump ^lor_end_3

  block ^lor_short_2:
    store typed i64 1, $lor__1
    jump ^lor_end_3

  block ^lor_end_3:
    %t5 = load typed i64 $lor__1
    branch %t5, ^lor_short_5, ^lor_rhs_4

  block ^lor_rhs_4:
    %t6 = call u8 @check__3()
    %t7 = cmp ne u8 %t6, 0
    store typed i64 %t7, $lor__2
    jump ^lor_end_6

  block ^lor_short_5:
    store typed i64 1, $lor__2
    jump ^lor_end_6

  block ^lor_end_6:
    %t8 = load typed i64 $lor__2
    %t9 = convert trunc i32 i64 %t8
    return i32 %t9
}
