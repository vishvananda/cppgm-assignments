#include <stdarg.h>
struct Quad { long double value; };
struct Envelope { char tag; long double value; };
static bool bits_equal(long double value, unsigned long long low, unsigned long long high) {
  unsigned long long bits[2];
  __builtin_memcpy(bits, &value, 16);
  return bits[0] == low && bits[1] == high;
}
extern "C" __attribute__((noinline)) int read_values(int seed, ...) {
  va_list arguments;
  va_start(arguments, seed);
  int first = va_arg(arguments, int);
  long double first_quad = va_arg(arguments, long double);
  __float128 explicit_quad = va_arg(arguments, __float128);
  int middle = va_arg(arguments, int);
  __int128 wide = va_arg(arguments, __int128);
  long double second_quad = va_arg(arguments, long double);
  Quad singleton = va_arg(arguments, Quad);
  Envelope envelope = va_arg(arguments, Envelope);
  int tail = va_arg(arguments, int);
  va_end(arguments);
  unsigned long long words[2];
  __builtin_memcpy(words, &wide, 16);
  if (!bits_equal(first_quad, 0, 0x3fff800000000000ULL)) return -1;
  if (!bits_equal(explicit_quad, 0, 0x4001400000000000ULL)) return -6;
  if (words[0] != 33 || words[1] != 0x80000000ULL) return -2;
  if (!bits_equal(second_quad, 0, 0xc000200000000000ULL)) return -3;
  if (!bits_equal(singleton.value, 0, 0x8000000000000000ULL)) return -4;
  if (!bits_equal(envelope.value, 0, 0x4000800000000000ULL)) return -5;
  return seed + first + middle + tail + envelope.tag;
}
