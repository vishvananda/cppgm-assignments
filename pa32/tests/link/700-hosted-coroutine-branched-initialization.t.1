#include <coroutine>

struct Value {
  int number;
  int& live;
  Value(int n, int& count) noexcept : number(n), live(count) { ++live; }
  Value(const Value&) = delete;
  ~Value() { --live; }
};

struct Record { int number; };

struct Await {
  int& live;
  bool fails;
};

struct Transformed {
  int& live;
  bool fails;
  bool await_ready() const noexcept { return false; }
  bool await_suspend(std::coroutine_handle<>) const noexcept { return true; }
  Record await_resume() const {
    if (fails)
      throw 80;
    return {4};
  }
};

struct Task {
  struct promise_type;
  using Handle = std::coroutine_handle<promise_type>;
  Handle handle;

  struct promise_type {
    int value = 0;
    Task get_return_object() noexcept { return {Handle::from_promise(*this)}; }
    std::suspend_always initial_suspend() noexcept { return {}; }
    std::suspend_always final_suspend() noexcept { return {}; }
    Transformed await_transform(Await& p) noexcept { return {p.live, p.fails}; }
    void return_value(int result) noexcept { value = result; }
    void unhandled_exception() noexcept { value = -1; }
  };
};

Task run(int& live, bool throws) {
  try {
    Value outer(1, live);
    Await gate{live, throws};
    auto local = co_await gate;
    co_return local.number + live + outer.number + 1;
  } catch (int error) {
    co_return error + live;
  }
}

int main() {
  for (int mode = 0; mode != 3; ++mode) {
    int live = 0;
    auto task = run(live, mode == 1);
    task.handle.resume();
    if (live != 1 || task.handle.done()) return 1;
    if (mode == 2) {
      task.handle.destroy();
      if (live != 0) return 2;
      continue;
    }
    task.handle.resume();
    if (!task.handle.done() || live != 0 || task.handle.promise().value != (mode == 0 ? 7 : 80))
      return 3;
    task.handle.destroy();
  }
}
