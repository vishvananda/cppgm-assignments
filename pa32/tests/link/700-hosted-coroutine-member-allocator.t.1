#include <coroutine>

struct Task;
struct Owner {
  int value;
  Task run(int argument);
};

struct Task {
  struct promise_type;
  using Handle = std::coroutine_handle<promise_type>;
  Handle handle;

  struct promise_type {
    static inline Owner* allocated_for;
    static inline int allocation_argument;
    static inline bool freed;

    static void* operator new(decltype(sizeof(0)) size, Owner& owner, int argument) {
      allocated_for = &owner;
      allocation_argument = argument;
      return ::operator new(size);
    }
    static void operator delete(void* address) { freed = true; ::operator delete(address); }

    explicit promise_type(Owner& owner, int argument) noexcept : value(owner.value * argument) {}
    Task get_return_object() noexcept { return {Handle::from_promise(*this)}; }
    std::suspend_always initial_suspend() noexcept { return {}; }
    std::suspend_always final_suspend() noexcept { return {}; }
    void return_value(int result) noexcept { value += result; }
    void unhandled_exception() noexcept {}
    int value;
  };
};

Task Owner::run(int argument) { co_return value + argument; }

int main() {
  Owner owner{3};
  auto task = owner.run(7);
  if (Task::promise_type::allocated_for != &owner || Task::promise_type::allocation_argument != 7)
    return 1;
  task.handle.resume();
  if (!task.handle.done() || task.handle.promise().value != 31)
    return 2;
  task.handle.destroy();
  return Task::promise_type::freed ? 0 : 3;
}
