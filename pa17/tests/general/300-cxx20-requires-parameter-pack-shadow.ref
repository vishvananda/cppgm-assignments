function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    %t1 = call i32 @Outer_int_int___run(1, 2)
    %t2 = binary sub nowrap i32 %t1, 2
    return i32 %t2
}
function @Outer_int_int___run(%args : i32, %args__pack2 : i32) -> i32 [binding=weak, object=_ZN5OuterIJiiEE3runIJcEEEiii, inline_hint=yes] {
  slot $args : i32
  slot $args__pack2 : i32
  slot $good : u8
  slot $local : u8
  slot $cond__1 : i64
  slot $land__2 : i64

  block ^entry:
    store typed i32 %args, $args
    store typed i32 %args__pack2, $args__pack2
    store typed u8 1, $good
    store typed u8 1, $local
    %t1 = load typed u8 $good
    branch %t1, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t2 = load typed u8 $local
    %t3 = cmp ne u8 %t2, 0
    store typed i64 %t3, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store typed i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t4 = load typed i64 $land__2
    branch %t4, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    %t5 = const i64 2
    store typed i64 %t5, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    %t6 = convert sext i64 i32 0
    store typed i64 %t6, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t7 = load typed i64 $cond__1
    %t8 = convert trunc i32 i64 %t7
    return i32 %t8
}
