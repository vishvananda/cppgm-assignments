function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $a : obj<1x1>
  slot $b : obj<1x1>
  slot $c : obj<1x1>

  block ^entry:
    %t1 = addr $a
    %t2 = addr $b
    %t3 = addr $c
    %t4 = addr $a
    %t5 = call i32 @Pick_char___value(%t4)
    %t6 = addr $b
    %t7 = call i32 @Pick_shortint___value(%t6)
    %t8 = binary add nowrap i32 %t5, %t7
    %t9 = addr $c
    %t10 = call i32 @Pick_int___value(%t9)
    %t11 = binary add nowrap i32 %t8, %t10
    %t12 = binary sub nowrap i32 %t11, 3
    return i32 %t12
}
function @Pick_char___value(%this : ptr [object_bytes=1]) -> i32 [binding=weak, object=_ZN4PickIcE5valueEv, inline_hint=yes] {
  slot $this : ptr

  block ^entry:
    store typed ptr %this, $this
    return i32 0
}
function @Pick_shortint___value(%this : ptr [object_bytes=1]) -> i32 [binding=weak, object=_ZN4PickIsE5valueEv, inline_hint=yes] {
  slot $this : ptr

  block ^entry:
    store typed ptr %this, $this
    return i32 1
}
function @Pick_int___value(%this : ptr [object_bytes=1]) -> i32 [binding=weak, object=_ZN4PickIiE5valueEv, inline_hint=yes] {
  slot $this : ptr

  block ^entry:
    store typed ptr %this, $this
    return i32 2
}
